<script>
  import { windComponents } from '../lib/metar-compute';

  let ageTimer: number | undefined;

  function setupMetarDecoder() {
    const root = document.querySelector<HTMLElement>('.wx');
    if (!root) return;

    if (ageTimer) window.clearInterval(ageTimer);
    const ageEl = root.querySelector<HTMLElement>('[data-wx-age]');
    const observedIso = root.dataset.obsIso;

    if (ageEl && observedIso) {
      const observed = new Date(observedIso);
      const tick = () => {
        const minutes = Math.floor((Date.now() - observed.getTime()) / 60000);
        const stale = minutes > 90;
        const text =
          minutes < 1
            ? 'just now'
            : minutes < 60
              ? `${minutes} min ago`
              : `${Math.floor(minutes / 60)} h ${minutes % 60} min ago`;
        ageEl.textContent = `· ${text}${stale ? ' · older than the hourly cycle' : ''}`;
        ageEl.classList.toggle('is-stale', stale);
        ageEl.title = observed.toLocaleString();
      };
      tick();
      ageTimer = window.setInterval(tick, 30000);
    }

    const panel = root.querySelector<HTMLElement>('#wx-wind-panel');
    if (panel) {
      const directionDeg = panel.dataset.windDir ? Number(panel.dataset.windDir) : null;
      const speedKt = panel.dataset.windSpeed ? Number(panel.dataset.windSpeed) : null;
      const gustKt = panel.dataset.windGust ? Number(panel.dataset.windGust) : null;
      const variable = panel.dataset.windVariable === '1';
      const scale = Math.max(1, gustKt ?? speedKt ?? 1);

      const wind = {
        directionDeg,
        variable,
        speed: speedKt,
        gust: gustKt,
        unit: 'KT' as const,
        speedKt,
        gustKt,
        varyFrom: null,
        varyTo: null,
        calm: speedKt === 0,
        raw: '',
      };

      const runwayGroup = root.querySelector<SVGGElement>('#wx-runway-group');
      const label = panel.querySelector<HTMLElement>('[data-runway-label]');
      const hdgLabel = panel.querySelector<HTMLElement>('[data-runway-hdg]');
      const headValue = panel.querySelector<HTMLElement>('[data-headwind-value]');
      const headNote = panel.querySelector<HTMLElement>('[data-headwind-note]');
      const headBar = panel.querySelector<HTMLElement>('[data-headwind-bar]');
      const crossValue = panel.querySelector<HTMLElement>('[data-crosswind-value]');
      const crossNote = panel.querySelector<HTMLElement>('[data-crosswind-note]');
      const crossBar = panel.querySelector<HTMLElement>('[data-crosswind-bar]');
      const gustValue = panel.querySelector<HTMLElement>('[data-gust-value]');

      let runway = Number(panel.dataset.runway || '36');

      const showComponents = (heading: number) => {
        const components = windComponents(wind, heading);
        if (!components) return;
        if (headValue) headValue.textContent = `${Math.abs(components.headwindKt).toFixed(1)} kt`;
        if (headNote) headNote.textContent = components.headwindKt >= 0 ? 'on the nose' : 'tailwind';
        if (headBar) headBar.style.width = `${Math.min(100, (Math.abs(components.headwindKt) / scale) * 100)}%`;
        if (crossValue) crossValue.textContent = `${components.crosswindKt.toFixed(1)} kt`;
        if (crossNote) crossNote.textContent = components.from === 'none' ? 'aligned' : `from the ${components.from}`;
        if (crossBar) crossBar.style.width = `${Math.min(100, (components.crosswindKt / scale) * 100)}%`;
        if (gustValue && components.gustCrosswindKt != null) {
          gustValue.textContent = `${components.gustCrosswindKt.toFixed(1)} kt crosswind`;
        }
      };

      const endButtons = Array.from(panel.querySelectorAll<HTMLButtonElement>('.wx-rwy-end'));
      if (endButtons.length) {
        const threshold = root.querySelector<SVGCircleElement>('#wx-rwy-threshold');
        const note = panel.querySelector<HTMLElement>('[data-rwy-note]');
        const selectEnd = (button: HTMLButtonElement, focus: boolean) => {
          endButtons.forEach((b) => {
            const on = b === button;
            b.setAttribute('aria-checked', String(on));
            b.tabIndex = on ? 0 : -1;
          });
          if (focus) button.focus();
          const heading = Number(button.dataset.endHeading);
          const runwayIndex = button.dataset.endRunway;
          root.querySelectorAll<SVGGElement>('.dial-rwy').forEach((g) => {
            g.classList.toggle('is-selected', g.dataset.rwy === runwayIndex);
          });
          if (threshold) {
            const rad = (((heading + 180) % 360) * Math.PI) / 180;
            threshold.setAttribute('cx', String(120 + Math.sin(rad) * 49));
            threshold.setAttribute('cy', String(120 - Math.cos(rad) * 49));
          }
          root.querySelectorAll<SVGTextElement>('.dial-rwy-label').forEach((labelEl) => {
            labelEl.classList.toggle('is-selected', (labelEl.dataset.idents ?? '').split(' ').includes(button.textContent ?? ''));
          });
          if (note) {
            note.textContent = `Runway ${button.textContent}, ${Math.round(heading)}° true${button.dataset.endApprox === '1' ? ', heading estimated from its number' : ''}`;
          }
          showComponents(heading);
        };
        endButtons.forEach((button, i) => {
          button.addEventListener('click', () => selectEnd(button, false));
          button.addEventListener('keydown', (event) => {
            if (!['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp'].includes(event.key)) return;
            event.preventDefault();
            const step = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : -1;
            selectEnd(endButtons[(i + step + endButtons.length) % endButtons.length], true);
          });
        });
      } else {
        const render = () => {
          const heading = runway * 10;
          if (label) label.textContent = String(runway).padStart(2, '0');
          if (hdgLabel) hdgLabel.textContent = `${String(heading).padStart(3, '0')}°`;
          if (runwayGroup) runwayGroup.setAttribute('transform', `rotate(${heading} 120 120)`);
          showComponents(heading);
        };

        panel.querySelectorAll<HTMLButtonElement>('[data-runway-step]').forEach((button) => {
          button.addEventListener('click', () => {
            const step = Number(button.dataset.runwayStep);
            runway = ((runway - 1 + step + 36) % 36) + 1;
            render();
          });
        });

        const best = panel.querySelector<HTMLButtonElement>('[data-runway-best]');
        best?.addEventListener('click', () => {
          runway = Number(best.dataset.runwayBest || '36');
          render();
        });

        render();
      }
    }

    const setActive = (id: string | null, on: boolean) => {
      if (!id) return;
      root.querySelectorAll(`.wx-tok[data-tok="${id}"], .wx-decode li[data-dec="${id}"]`).forEach((el) => {
        el.classList.toggle('is-active', on);
      });
    };

    let selectedId: string | null = null;

    const select = (id: string | null) => {
      root.querySelectorAll('.wx-tok.is-selected, .wx-decode li.is-selected').forEach((el) => {
        el.classList.remove('is-selected');
      });
      selectedId = selectedId === id ? null : id;
      if (selectedId) {
        root.querySelectorAll(`.wx-tok[data-tok="${selectedId}"], .wx-decode li[data-dec="${selectedId}"]`).forEach((el) => {
          el.classList.add('is-selected');
        });
      }
      root.classList.toggle('has-selection', selectedId !== null);
    };

    const readout = root.querySelector<HTMLElement>('[data-wx-readout]');
    const readoutHint = readout?.innerHTML ?? '';

    const showReadout = (token: HTMLElement | null) => {
      if (!readout) return;
      if (!token) {
        readout.innerHTML = readoutHint;
        return;
      }
      const code = document.createElement('code');
      code.textContent = token.textContent ?? '';
      const label = document.createElement('span');
      label.className = 'wx-hl-readout-label';
      label.textContent = token.dataset.label ?? '';
      const plain = document.createElement('span');
      plain.textContent = token.dataset.plain ?? '';
      readout.replaceChildren(code, label, plain);
    };

    const headerToken = (id: string | null) =>
      id ? root.querySelector<HTMLElement>(`.wx-hl .wx-tok[data-tok="${id}"]`) : null;

    const restoreReadout = () => showReadout(headerToken(selectedId));

    root.querySelectorAll<HTMLButtonElement>('.wx-tok').forEach((token) => {
      const id = token.dataset.tok ?? null;
      const inHeader = !!token.closest('.wx-hl');
      const enter = () => {
        setActive(id, true);
        if (inHeader) showReadout(token);
      };
      const leave = () => {
        setActive(id, false);
        if (inHeader) restoreReadout();
      };
      token.addEventListener('mouseenter', enter);
      token.addEventListener('mouseleave', leave);
      token.addEventListener('focus', enter);
      token.addEventListener('blur', leave);
      token.addEventListener('click', () => {
        if (!inHeader) {
          const row = root.querySelector(`.wx-decode li[data-dec="${id}"]`);
          row?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        select(id);
        if (inHeader) restoreReadout();
      });
    });

    root.querySelectorAll<HTMLElement>('.wx-decode li').forEach((row) => {
      const id = row.dataset.dec ?? null;
      row.tabIndex = 0;
      row.setAttribute('role', 'button');
      row.setAttribute('aria-label', `Highlight "${row.querySelector('.wx-dec-code')?.textContent ?? ''}" in the raw report`);
      row.addEventListener('mouseenter', () => setActive(id, true));
      row.addEventListener('mouseleave', () => setActive(id, false));
      const activate = () => {
        const token = root.querySelector<HTMLElement>(`.wx-tok[data-tok="${id}"]`);
        token?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        select(id);
        restoreReadout();
      };
      row.addEventListener('click', activate);
      row.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activate();
        }
      });
    });
  }

  interface MeteogramBlock {
    from: number;
    to: number;
    row: 'prevailing' | 'amendment';
    category: string;
    label: string;
    probability: number | null;
    summary: string;
  }

  interface MeteogramData {
    start: number;
    end: number;
    now: number | null;
    blocks: MeteogramBlock[];
  }

  const HOUR = 3600000;

  function two(n: number): string {
    return String(n).padStart(2, '0');
  }

  function setupMeteogram(root: HTMLElement) {
    const mg = root.querySelector<HTMLElement>('[data-wx-mg]');
    if (!mg) return;
    let data: MeteogramData;
    try {
      data = JSON.parse(mg.dataset.wxMg ?? '');
    } catch {
      return;
    }

    const body = mg.querySelector<HTMLElement>('.wx-mg-body');
    const overlay = mg.querySelector<HTMLElement>('.wx-mg-overlay');
    const cursor = mg.querySelector<HTMLElement>('[data-mg-cursor]');
    const readout = mg.querySelector<HTMLElement>('[data-mg-readout]');
    if (!body || !overlay || !cursor || !readout) return;

    const span = data.end - data.start;
    const home = data.now ?? data.start;
    let current = home;

    const categoryChip = (category: string) => {
      const chip = document.createElement('span');
      chip.className = `wx-period-cat cat-${category.toLowerCase()}`;
      chip.textContent = category === 'UNKNOWN' ? '?' : category;
      return chip;
    };

    const line = (category: string, kind: string, text: string) => {
      const row = document.createElement('div');
      row.className = 'wx-mg-readout-line';
      const kindEl = document.createElement('span');
      kindEl.className = 'wx-mg-readout-kind';
      kindEl.textContent = kind;
      const textEl = document.createElement('span');
      textEl.textContent = text;
      row.append(categoryChip(category), kindEl, textEl);
      return row;
    };

    const render = (t: number, showCursor: boolean) => {
      current = Math.max(data.start, Math.min(data.end, t));
      const pct = ((current - data.start) / span) * 100;
      cursor.hidden = !showCursor;
      cursor.style.left = `${pct}%`;

      const active = data.blocks.filter((b) => current >= b.from && current < b.to);
      const prevailing = active.filter((b) => b.row === 'prevailing').pop();
      const temporary = active.filter((b) => b.row === 'amendment');

      const at = new Date(current);
      const head = document.createElement('div');
      const time = document.createElement('span');
      time.className = 'wx-mg-readout-time num';
      time.textContent = `${two(at.getUTCDate())} ${two(at.getUTCHours())}:${two(at.getUTCMinutes())}Z`;
      const rel = document.createElement('span');
      rel.className = 'wx-mg-readout-rel';
      if (data.now != null) {
        const hours = Math.round((current - data.now) / HOUR);
        rel.textContent = hours === 0 ? 'now' : hours > 0 ? `in ${hours} h` : `${-hours} h ago`;
      }
      head.append(time, rel);

      const lines: HTMLElement[] = [];
      if (prevailing) lines.push(line(prevailing.category, 'Expected', prevailing.summary));
      for (const block of temporary) {
        const kind = block.probability != null ? `${block.probability}% chance` : block.label;
        lines.push(line(block.category, kind, block.summary));
      }
      if (!lines.length) {
        const empty = document.createElement('p');
        empty.className = 'wx-empty';
        empty.textContent = 'No forecast group covers this time.';
        lines.push(empty);
      }

      readout.className = `wx-mg-readout cat-${(prevailing?.category ?? 'unknown').toLowerCase()}`;
      readout.replaceChildren(head, ...lines);
    };

    const fromPointer = (event: PointerEvent) => {
      const rect = overlay.getBoundingClientRect();
      const x = Math.max(0, Math.min(rect.width, event.clientX - rect.left));
      return data.start + (x / rect.width) * span;
    };

    body.addEventListener('pointermove', (event) => render(fromPointer(event), true));
    body.addEventListener('pointerdown', (event) => render(fromPointer(event), true));
    body.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') render(home, false);
    });

    mg.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        const step = event.key === 'ArrowRight' ? HOUR : -HOUR;
        render(Math.round((current + step) / HOUR) * HOUR, true);
      } else if (event.key === 'Home') {
        event.preventDefault();
        render(data.start, true);
      } else if (event.key === 'End') {
        event.preventDefault();
        render(data.end - 1, true);
      } else if (event.key === 'Escape') {
        render(home, false);
      }
    });

    render(home, false);
  }

  function setupAll() {
    setupMetarDecoder();
    const root = document.querySelector<HTMLElement>('.wx');
    if (root) setupMeteogram(root);
  }

  setupAll();
  document.addEventListener('astro:after-swap', setupAll);
</script>
