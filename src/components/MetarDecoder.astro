<script>
  import { windComponents } from '../lib/metar-compute';

  let ageTimer: number | undefined;

  function setupMetarDecoder() {
    const root = document.querySelector<HTMLElement>('.wx');
    if (!root) return;

    if (ageTimer) window.clearInterval(ageTimer);
    const ageEl = root.querySelector<HTMLElement>('[data-wx-age]');
    const observedIso = root.dataset.obsIso;

    if (ageEl && observedIso) {
      const observed = new Date(observedIso);
      const tick = () => {
        const minutes = Math.floor((Date.now() - observed.getTime()) / 60000);
        const stale = minutes > 90;
        const text =
          minutes < 1
            ? 'just now'
            : minutes < 60
              ? `${minutes} min ago`
              : `${Math.floor(minutes / 60)} h ${minutes % 60} min ago`;
        ageEl.textContent = `· ${text}${stale ? ' · older than the hourly cycle' : ''}`;
        ageEl.style.color = stale ? 'var(--warning)' : '';
        ageEl.title = observed.toLocaleString();
      };
      tick();
      ageTimer = window.setInterval(tick, 30000);
    }

    const panel = root.querySelector<HTMLElement>('#wx-wind-panel');
    if (panel) {
      const directionDeg = panel.dataset.windDir ? Number(panel.dataset.windDir) : null;
      const speedKt = panel.dataset.windSpeed ? Number(panel.dataset.windSpeed) : null;
      const gustKt = panel.dataset.windGust ? Number(panel.dataset.windGust) : null;
      const variable = panel.dataset.windVariable === '1';
      const scale = Math.max(1, gustKt ?? speedKt ?? 1);

      const wind = {
        directionDeg,
        variable,
        speed: speedKt,
        gust: gustKt,
        unit: 'KT' as const,
        speedKt,
        gustKt,
        varyFrom: null,
        varyTo: null,
        calm: speedKt === 0,
        raw: '',
      };

      const runwayGroup = root.querySelector<SVGGElement>('#wx-runway-group');
      const label = panel.querySelector<HTMLElement>('[data-runway-label]');
      const hdgLabel = panel.querySelector<HTMLElement>('[data-runway-hdg]');
      const headValue = panel.querySelector<HTMLElement>('[data-headwind-value]');
      const headNote = panel.querySelector<HTMLElement>('[data-headwind-note]');
      const headBar = panel.querySelector<HTMLElement>('[data-headwind-bar]');
      const crossValue = panel.querySelector<HTMLElement>('[data-crosswind-value]');
      const crossNote = panel.querySelector<HTMLElement>('[data-crosswind-note]');
      const crossBar = panel.querySelector<HTMLElement>('[data-crosswind-bar]');
      const gustValue = panel.querySelector<HTMLElement>('[data-gust-value]');

      let runway = Number(panel.dataset.runway || '36');

      const render = () => {
        const heading = runway * 10;
        if (label) label.textContent = String(runway).padStart(2, '0');
        if (hdgLabel) hdgLabel.textContent = `${String(heading).padStart(3, '0')}°`;
        if (runwayGroup) runwayGroup.setAttribute('transform', `rotate(${heading} 120 120)`);

        const components = windComponents(wind, heading);
        if (!components) return;

        if (headValue) headValue.textContent = `${Math.abs(components.headwindKt).toFixed(1)} kt`;
        if (headNote) headNote.textContent = components.headwindKt >= 0 ? 'on the nose' : 'tailwind';
        if (headBar) headBar.style.width = `${Math.min(100, (Math.abs(components.headwindKt) / scale) * 100)}%`;
        if (crossValue) crossValue.textContent = `${components.crosswindKt.toFixed(1)} kt`;
        if (crossNote) crossNote.textContent = components.from === 'none' ? 'aligned' : `from the ${components.from}`;
        if (crossBar) crossBar.style.width = `${Math.min(100, (components.crosswindKt / scale) * 100)}%`;
        if (gustValue && components.gustCrosswindKt != null) {
          gustValue.textContent = `${components.gustCrosswindKt.toFixed(1)} kt crosswind`;
        }
      };

      panel.querySelectorAll<HTMLButtonElement>('[data-runway-step]').forEach((button) => {
        button.addEventListener('click', () => {
          const step = Number(button.dataset.runwayStep);
          runway = ((runway - 1 + step + 36) % 36) + 1;
          render();
        });
      });

      const best = panel.querySelector<HTMLButtonElement>('[data-runway-best]');
      best?.addEventListener('click', () => {
        runway = Number(best.dataset.runwayBest || '36');
        render();
      });

      render();
    }

    const setActive = (id: string | null, on: boolean) => {
      if (!id) return;
      root.querySelectorAll(`.wx-tok[data-tok="${id}"], .wx-decode li[data-dec="${id}"]`).forEach((el) => {
        el.classList.toggle('is-active', on);
      });
    };

    let toast = root.querySelector<HTMLElement>('.wx-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.className = 'wx-toast';
      toast.setAttribute('role', 'status');
      toast.setAttribute('aria-live', 'polite');
      root.appendChild(toast);
    }
    let toastTimer: number | undefined;
    const showToast = (text: string) => {
      if (!toast) return;
      toast.textContent = text;
      toast.classList.add('is-visible');
      if (toastTimer) window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast?.classList.remove('is-visible'), 1600);
    };

    const flashActive = (id: string | null) => {
      setActive(id, true);
      window.setTimeout(() => setActive(id, false), 1100);
    };

    const copyGroup = async (raw: string) => {
      try {
        await navigator.clipboard.writeText(raw);
        showToast(`Copied "${raw}"`);
      } catch {
        showToast(`${raw} — copy blocked by browser`);
      }
    };

    root.querySelectorAll<HTMLButtonElement>('.wx-tok').forEach((token) => {
      const id = token.dataset.tok ?? null;
      token.addEventListener('mouseenter', () => setActive(id, true));
      token.addEventListener('mouseleave', () => setActive(id, false));
      token.addEventListener('focus', () => setActive(id, true));
      token.addEventListener('blur', () => setActive(id, false));
      token.addEventListener('click', () => {
        const row = root.querySelector(`.wx-decode li[data-dec="${id}"]`);
        row?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        flashActive(id);
        void copyGroup(token.textContent?.trim() ?? '');
      });
    });

    root.querySelectorAll<HTMLElement>('.wx-decode li').forEach((row) => {
      const id = row.dataset.dec ?? null;
      row.tabIndex = 0;
      row.setAttribute('role', 'button');
      row.setAttribute('aria-label', `Jump to "${row.querySelector('.wx-dec-code')?.textContent ?? ''}" in the raw report and copy it`);
      row.addEventListener('mouseenter', () => setActive(id, true));
      row.addEventListener('mouseleave', () => setActive(id, false));
      const activate = () => {
        const token = root.querySelector<HTMLElement>(`.wx-tok[data-tok="${id}"]`);
        token?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        flashActive(id);
        void copyGroup(row.querySelector('.wx-dec-code')?.textContent?.trim() ?? '');
      };
      row.addEventListener('click', activate);
      row.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activate();
        }
      });
    });
  }

  setupMetarDecoder();
  document.addEventListener('astro:after-swap', setupMetarDecoder);
</script>
