---
import type { LinkItem } from '../../lib/learn/types';

interface Props {
  title: string;
  items: LinkItem[];
}

const { title, items } = Astro.props;
---

<aside class="lk">
  <p class="lk-title">{title}</p>
  <ul class="lk-list">
    {items.map((item) => (
      <li>
        <a href={item.href} target="_blank" rel="noopener">{item.label}</a>
        {item.note && <span class="lk-note">{item.note}</span>}
      </li>
    ))}
  </ul>
</aside>

<style>
  .lk {
    margin: 40px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--border-strong);
    font-family: var(--font-sans);
  }

  .lk-title {
    margin: 0 0 10px;
    font-family: var(--font-archivo);
    font-size: 17px;
    font-weight: 700;
  }

  .lk-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .lk-list li { display: grid; gap: 2px; }

  .lk-list a {
    justify-self: start;
    color: var(--accent-blue);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    text-underline-offset: 3px;
  }

  .lk-list a:hover { color: var(--fg); }
  .lk-list a:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }

  .lk-note { font-size: 13.5px; line-height: 1.5; color: var(--text-muted); max-width: 62ch; }
</style>
