---
import { STATUS_LABELS, type DecodedNotam, type StatementStatus } from '../lib/notam';

interface Props {
  decoded: DecodedNotam;
}

const { decoded } = Astro.props;

function pad2(n: number): string {
  return n < 10 ? `0${n}` : String(n);
}

const aField = decoded.fields.find((f) => f.code === 'A');
const location = aField?.raw ?? decoded.qLine?.fir ?? 'Unknown location';

const now = new Date();
function toDate(t: { year: number; month: number; day: number; hour: number; minute: number }) {
  return new Date(Date.UTC(t.year, t.month - 1, t.day, t.hour, t.minute));
}

let status: { label: string; tone: 'active' | 'future' | 'expired' | 'unknown' } = { label: 'Timing not stated', tone: 'unknown' };
if (decoded.effectiveFrom) {
  const from = toDate(decoded.effectiveFrom);
  const to = decoded.effectiveTo ? toDate(decoded.effectiveTo) : null;
  if (decoded.permanent) {
    status = now >= from ? { label: 'Active - permanent', tone: 'active' } : { label: 'Not yet active - permanent once effective', tone: 'future' };
  } else if (to) {
    if (now < from) status = { label: 'Not yet active', tone: 'future' };
    else if (now > to) status = { label: 'Expired', tone: 'expired' };
    else status = { label: 'Active now', tone: 'active' };
  } else {
    status = now >= from ? { label: 'Active - no stated end', tone: 'active' } : { label: 'Not yet active', tone: 'future' };
  }
}

const MONTHS = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function fmtTime(t: { year: number; month: number; day: number; hour: number; minute: number }): string {
  return `${pad2(t.day)} ${MONTHS[t.month]} ${t.year}, ${pad2(t.hour)}:${pad2(t.minute)}Z`;
}

function span(ms: number): string {
  const minutes = Math.abs(ms) / 60000;
  if (minutes < 90) return `${Math.max(1, Math.round(minutes))} min`;
  if (minutes < 48 * 60) return `${Math.round(minutes / 60)} h`;
  if (minutes < 60 * 1440) return `${Math.round(minutes / 1440)} days`;
  const months = Math.round(minutes / 43800);
  return `${months} month${months === 1 ? '' : 's'}`;
}

const fromDate = decoded.effectiveFrom ? toDate(decoded.effectiveFrom) : null;
const toDateValue = decoded.effectiveTo && !decoded.permanent ? toDate(decoded.effectiveTo) : null;
const startRelative = fromDate ? (fromDate > now ? `starts in ${span(fromDate.getTime() - now.getTime())}` : `started ${span(now.getTime() - fromDate.getTime())} ago`) : null;
const endRelative = toDateValue
  ? toDateValue > now
    ? `ends in ${span(toDateValue.getTime() - now.getTime())}`
    : `ended ${span(now.getTime() - toDateValue.getTime())} ago`
  : decoded.permanent
    ? 'no end date'
    : null;

let timeline: { nowPct: number; nowEdge: 'start' | 'end' | null; openEnded: boolean } | null = null;
if (fromDate) {
  const end = toDateValue ?? new Date(Math.max(now.getTime(), fromDate.getTime()) + 30 * 86400000);
  const total = end.getTime() - fromDate.getTime();
  const raw = total > 0 ? ((now.getTime() - fromDate.getTime()) / total) * 100 : 0;
  timeline = {
    nowPct: Math.max(0, Math.min(100, raw)),
    nowEdge: raw < 0 ? 'start' : raw > 100 ? 'end' : null,
    openEnded: !toDateValue,
  };
}

const headline = decoded.headline;

const STATUS_ORDER: StatementStatus[] = ['closed', 'unserviceable', 'restricted', 'hazard', 'available', 'info'];
const groups = STATUS_ORDER.map((status) => ({
  status,
  label: decoded.type === 'NOTAMC' && status === 'info' ? 'What the cancellation says' : STATUS_LABELS[status],
  items: decoded.statements.filter((s) => s.status === status),
})).filter((g) => g.items.length);

const facts = [
  decoded.type === 'NOTAMC' && decoded.replaces ? { label: 'Cancels', value: decoded.replaces } : null,
  decoded.type === 'NOTAMR' && decoded.replaces ? { label: 'Replaces', value: decoded.replaces } : null,
  decoded.scheduleText ? { label: 'Active', value: `${decoded.scheduleText} (UTC)` } : null,
  decoded.limitsText ? { label: 'Altitudes', value: decoded.limitsText } : null,
].filter((f): f is { label: string; value: string } => !!f);

const centre = decoded.qLine?.center ?? null;
const wholeArea = (decoded.qLine?.radiusNm ?? 0) >= 999;
const area = centre
  ? { lat: centre.lat, lon: centre.lon, radiusNm: wholeArea ? null : decoded.qLine?.radiusNm ?? null }
  : decoded.textCoordinates.length
    ? { lat: decoded.textCoordinates[0].lat, lon: decoded.textCoordinates[0].lon, radiusNm: null }
    : null;
const points = decoded.textCoordinates.map((p) => [p.lon, p.lat]);
const areaNote = centre
  ? `${decoded.qLine?.coordinates}${wholeArea ? ', the whole FIR' : decoded.qLine?.radiusNm != null ? `, ${decoded.qLine.radiusNm} nm radius` : ''}`
  : 'Position from the text';

function flLabel(fl: string): string {
  if (fl === '000') return 'surface';
  if (fl === '999') return 'unlimited';
  return `FL${fl}`;
}

const errors = decoded.issues.filter((i) => i.severity === 'error');
const warnings = decoded.issues.filter((i) => i.severity === 'warning');

const FIELD_ORDER = ['A', 'B', 'C', 'D', 'E', 'F', 'G'] as const;
const orderedFields = FIELD_ORDER.map((code) => decoded.fields.find((f) => f.code === code)).filter((f): f is NonNullable<typeof f> => !!f);

const qRows = decoded.qLine
  ? [
      { label: 'FIR', value: decoded.qLine.fir, plain: null },
      { label: 'Subject', value: decoded.qLine.subjectCode, plain: decoded.qLine.subjectPlain },
      { label: 'Condition', value: decoded.qLine.conditionCode, plain: decoded.qLine.conditionPlain },
      { label: 'Traffic', value: decoded.qLine.traffic, plain: decoded.qLine.trafficPlain },
      { label: 'Purpose', value: decoded.qLine.purpose, plain: decoded.qLine.purposePlain },
      { label: 'Scope', value: decoded.qLine.scope, plain: decoded.qLine.scopePlain },
      { label: 'Altitude block', value: decoded.qLine.lowerFl && decoded.qLine.upperFl ? `${decoded.qLine.lowerFl}/${decoded.qLine.upperFl}` : null, plain: decoded.qLine.lowerFl && decoded.qLine.upperFl && /^\d{3}$/.test(decoded.qLine.lowerFl) && /^\d{3}$/.test(decoded.qLine.upperFl) ? `From ${flLabel(decoded.qLine.lowerFl)} to ${flLabel(decoded.qLine.upperFl)}` : null },
      { label: 'Centre / radius', value: decoded.qLine.coordinates ? `${decoded.qLine.coordinates}${decoded.qLine.radiusNm != null ? `, ${decoded.qLine.radiusNm} nm radius` : ''}` : null, plain: null },
    ].filter((r) => r.value != null)
  : [];
---

<article class="nd">
  <section class={`nd-band tone-${status.tone}`}>
    <div class="nd-band-top">
      <div>
        <h2 class="nd-location num">{location.split(/\s+/)[0]}</h2>
        <p class="nd-sub">
          {decoded.series && decoded.number && <span class="num">{decoded.series}{decoded.number}</span>}
          {decoded.type && <span class="nd-type-chip">{decoded.type}</span>}
          {decoded.replaces && <span>replaces {decoded.replaces}</span>}
          {decoded.unstructured && <span class="nd-type-chip">No A) to G) markers, decoded as plain text</span>}
        </p>
      </div>
      <div class="nd-status">
        <span class="nd-status-dot" aria-hidden="true"></span>
        {status.label}
      </div>
    </div>
    {headline && <p class="nd-headline-text">{headline}</p>}
    {facts.length > 0 && (
      <dl class="nd-facts">
        {facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd class="num">{f.value}</dd>
          </div>
        ))}
      </dl>
    )}
    {groups.length === 0 && <p class="nd-summary">{decoded.plainSummary}</p>}
  </section>

  {decoded.issues.length > 0 && (
    <section class={`nd-issues${errors.length ? ' has-errors' : ''}`} aria-label="Problems with this NOTAM">
      <p class="nd-issues-lead">
        {errors.length
          ? 'This NOTAM has errors, so parts of the decode may be wrong. Check it against your official briefing.'
          : 'Check these points before you rely on this decode.'}
      </p>
      <ul>
        {[...errors, ...warnings].map((i) => (
          <li class={`is-${i.severity}`}>
            {i.message}
          </li>
        ))}
      </ul>
    </section>
  )}

  {groups.length > 0 && (
    <section class="nd-says" aria-label="What the NOTAM says">
      {groups.map((group) => (
        <div class={`nd-group is-${group.status}`}>
          <h3 class="nd-group-title">
            <span class="nd-group-mark" aria-hidden="true"></span>
            {group.label}
          </h3>
          <ul>
            {group.items.map((item) => (
              <li>
                {item.subject}
                {item.detail && <span class="nd-group-detail">, {item.detail}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}

  {fromDate && timeline && (
    <section class="nd-when" aria-label="When this NOTAM applies">
      <div class="nd-when-labels">
        <div>
          <span class="nd-when-label">From</span>
          <span class="nd-when-time num">{fmtTime(decoded.effectiveFrom!)}</span>
          {startRelative && <span class="nd-when-rel">{startRelative}</span>}
        </div>
        <div class="nd-when-end">
          <span class="nd-when-label">Until</span>
          <span class="nd-when-time num">
            {decoded.permanent ? 'Permanent' : decoded.effectiveTo ? `${fmtTime(decoded.effectiveTo)}${decoded.estimatedEnd ? ', estimated' : ''}` : 'Not stated'}
          </span>
          {endRelative && <span class="nd-when-rel">{endRelative}</span>}
        </div>
      </div>
      <div class={`nd-when-track tone-${status.tone}${timeline.openEnded ? ' is-open' : ''}`}>
        <span class="nd-when-bar"></span>
        <span class={`nd-when-now${timeline.nowEdge ? ` at-${timeline.nowEdge}` : ''}`} style={`left:${timeline.nowPct}%`}>
          <span class="nd-when-now-label">{timeline.nowEdge === 'end' ? 'Now, after the end' : timeline.nowEdge === 'start' ? 'Now, before the start' : 'Now'}</span>
        </span>
      </div>
    </section>
  )}

  {area && (
    <section class="nd-panel">
      <header class="nd-panel-head">
        <span class="col">Where it applies</span>
        <span class="nd-panel-note num">{areaNote}</span>
      </header>
      <div
        class="nd-map"
        data-nd-map
        data-lat={area.lat}
        data-lon={area.lon}
        data-radius={area.radiusNm ?? ''}
        data-wide={wholeArea ? '1' : ''}
        data-points={JSON.stringify(points)}
        aria-label={`Map of the area this NOTAM covers: ${areaNote}`}
      ></div>
    </section>
  )}

  {qRows.length > 0 && (
    <section class="nd-panel">
      <header class="nd-panel-head">
        <span class="col">Q-line</span>
        <span class="nd-panel-note">The coded summary line, field by field</span>
      </header>
      <dl class="nd-qgrid">
        {qRows.map((row) => (
          <div class="nd-qrow">
            <dt>{row.label}</dt>
            <dd>
              <span class="num nd-qcode">{row.value}</span>
              {row.plain && <span class="nd-qplain">{row.plain}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  {!decoded.unstructured && orderedFields.length > 0 && (
    <section class="nd-panel">
      <header class="nd-panel-head">
        <span class="col">Item by item</span>
        <span class="nd-panel-note">Each lettered item, translated</span>
      </header>
      <ol class="nd-fields">
        {orderedFields.map((field) => (
          <li>
            <span class="nd-field-code">{field.code}</span>
            <div class="nd-field-body">
              <code class="nd-field-raw num">{field.raw}</code>
              <p class="nd-field-plain">{field.plain}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  {decoded.unstructured && (
    <section class="nd-panel">
      <header class="nd-panel-head">
        <span class="col">Decoded text</span>
        <span class="nd-panel-note">No lettered items were found, so the whole paste was decoded as text</span>
      </header>
      <p class="nd-field-plain nd-unstructured-text">{decoded.plainSummary}</p>
    </section>
  )}

  {decoded.unrecognisedTokens.length > 0 && (
    <p class="nd-flagged">
      This decoder doesn't know {decoded.unrecognisedTokens.length === 1 ? 'this contraction' : 'these contractions'}:
      <span class="num">{decoded.unrecognisedTokens.join(', ')}</span>. {decoded.unrecognisedTokens.length === 1 ? "It's" : "They're"} shown as written.
    </p>
  )}

  <section class="nd-panel">
    <header class="nd-panel-head">
      <span class="col">Raw text</span>
    </header>
    <pre class="nd-raw num">{decoded.raw}</pre>
  </section>
</article>

<style>
  .nd { display: block; margin-top: 40px; }

  .nd-band {
    --band: #3C4349;
    --on-band: #FFFFFF;
    --on-band-muted: rgba(255, 255, 255, 0.78);
    --on-band-line: rgba(255, 255, 255, 0.32);
    background: var(--band);
    color: var(--on-band);
    padding: 28px 32px 26px;
  }

  .nd-band.tone-active { --band: #8A2F12; }
  .nd-band.tone-future { --band: #0B3F73; }
  .nd-band.tone-expired { --band: #3C4349; }

  .nd-band-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px 32px; flex-wrap: wrap; }
  .nd-location { font-family: var(--font-archivo); font-size: clamp(48px, 8vw, 88px); font-weight: 700; letter-spacing: -0.035em; line-height: 0.9; margin: 0; }
  .nd-sub { margin: 12px 0 0; font-size: 12.5px; color: var(--on-band-muted); display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .nd-type-chip { font-size: 10px; font-weight: 600; letter-spacing: 0.08em; padding: 2px 6px; border: 1px solid var(--on-band-line); color: var(--on-band); }

  .nd-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 14px;
    background: var(--on-band);
    color: var(--band);
    white-space: nowrap;
  }

  .nd-status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--band); flex-shrink: 0; }

  .nd-headline-text {
    margin: 22px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--on-band-line);
    font-family: var(--font-archivo);
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .nd-summary { margin: 12px 0 0; font-size: 15px; line-height: 1.6; max-width: 76ch; color: var(--on-band-muted); }

  .nd-when { margin-top: 28px; }

  .nd-when-labels {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .nd-when-labels > div { display: flex; flex-direction: column; gap: 3px; }
  .nd-when-end { text-align: right; align-items: flex-end; }
  .nd-when-label { font-size: 12px; color: var(--text-muted); }
  .nd-when-time { font-size: 15px; font-weight: 600; }
  .nd-when-rel { font-size: 12.5px; color: var(--text-muted); }

  .nd-when-track {
    --band: #3C4349;
    position: relative;
    height: 12px;
    margin: 14px 0 34px;
    background: var(--surface-subtle);
    border: 1px solid var(--border);
  }

  .nd-when-track.tone-active { --band: #8A2F12; }
  .nd-when-track.tone-future { --band: #0B3F73; }

  .nd-when-bar { position: absolute; inset: 0; background: var(--band); opacity: 0.85; }
  .nd-when-track.is-open .nd-when-bar { background: linear-gradient(to right, var(--band) 70%, transparent); }

  .nd-when-now {
    position: absolute;
    top: -6px;
    bottom: -6px;
    width: 2px;
    margin-left: -1px;
    background: var(--fg);
  }

  .nd-when-now-label {
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }

  .nd-when-now.at-end .nd-when-now-label { left: auto; right: 0; transform: none; }
  .nd-when-now.at-start .nd-when-now-label { left: 0; transform: none; }

  .nd-map {
    width: 100%;
    aspect-ratio: 16 / 7;
    min-height: 300px;
    border: 1px solid var(--border);
    background: var(--surface-card);
  }

  .nd-panel { margin-top: 40px; }
  .nd-panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-bottom: 12px; border-bottom: 1px solid var(--border); margin-bottom: 18px; }
  .nd-panel-note { font-size: 11.5px; color: var(--text-subtle); }

  .nd-qgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); margin: 0; }
  .nd-qrow { background: var(--surface-card); padding: 12px 16px; }
  .nd-qrow dt { font-size: 10px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  .nd-qrow dd { margin: 6px 0 0; display: flex; flex-direction: column; gap: 3px; }
  .nd-qcode { font-size: 14px; }
  .nd-qplain { font-size: 12px; color: var(--text-muted); }

  .nd-fields { list-style: none; margin: 0; padding: 0; }
  .nd-fields li { display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: 14px; padding: 14px 0; border-top: 1px solid var(--border); }
  .nd-field-code { font-family: var(--font-archivo); font-weight: 700; font-size: 15px; color: var(--accent-blue); }
  .nd-field-raw { display: block; font-size: 12px; color: var(--text-muted); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .nd-field-plain { margin: 6px 0 0; font-size: 14px; line-height: 1.6; }
  .nd-unstructured-text { margin-top: 0; }

  .nd-facts { display: flex; flex-wrap: wrap; gap: 10px 32px; margin: 16px 0 0; }
  .nd-facts div { min-width: 0; }
  .nd-facts dt { font-size: 11.5px; letter-spacing: 0.02em; color: var(--on-band-muted); }
  .nd-facts dd { margin: 2px 0 0; font-size: 15px; font-weight: 600; color: var(--on-band); }

  .nd-says {
    --tone-closed: var(--danger);
    --tone-unserviceable: var(--warning);
    --tone-restricted: var(--accent-blue);
    --tone-hazard: #B54708;
    --tone-available: var(--success);
    --tone-info: var(--border-strong);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 28px 40px;
    margin-top: 28px;
  }
  :global([data-theme='dark']) .nd-says { --tone-hazard: #F79A5B; --tone-restricted: #7FB2E8; }
  .nd-group { min-width: 0; }
  .nd-group-title { display: flex; align-items: center; gap: 10px; margin: 0 0 10px; padding-bottom: 8px; border-bottom: 1px solid var(--border); font-size: 13px; font-weight: 700; letter-spacing: 0.01em; }
  .nd-group-mark { width: 10px; height: 10px; flex: none; background: var(--tone); }
  .nd-group.is-closed { --tone: var(--tone-closed); }
  .nd-group.is-unserviceable { --tone: var(--tone-unserviceable); }
  .nd-group.is-restricted { --tone: var(--tone-restricted); }
  .nd-group.is-hazard { --tone: var(--tone-hazard); }
  .nd-group.is-available { --tone: var(--tone-available); }
  .nd-group.is-info { --tone: var(--tone-info); }
  .nd-group ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .nd-group li { position: relative; padding-left: 14px; font-size: 15px; line-height: 1.5; }
  .nd-group li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 5px; height: 5px; background: var(--tone); }
  .nd-group-detail { color: var(--text-muted); }

  .nd-issues { margin-top: 18px; padding: 14px 16px; border-left: 3px solid var(--warning); background: var(--warning-bg); font-size: 13.5px; line-height: 1.55; }
  .nd-issues.has-errors { border-left-color: var(--danger); background: var(--danger-bg); }
  .nd-issues-lead { margin: 0 0 8px; font-weight: 600; color: var(--fg); }
  .nd-issues ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .nd-issues li { color: var(--text-muted); }
  .nd-issues li.is-error { color: var(--fg); }
  .nd-flagged { margin-top: 18px; padding: 12px 14px; border-left: 3px solid var(--warning); background: var(--surface-subtle); font-size: 12.5px; line-height: 1.55; color: var(--text-muted); }
  .nd-flagged .num { color: var(--fg); }

  .nd-raw { white-space: pre-wrap; word-break: break-word; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12.5px; line-height: 1.7; padding: 16px; background: var(--surface-subtle); border: 1px solid var(--border); margin: 0; }

  @media (max-width: 640px) {
    .nd-headline-top { flex-direction: column; }
  }
  @media (max-width: 720px) {
    .nd-band { padding: 22px 18px 20px; }
    .nd-map { aspect-ratio: 4 / 3; }
  }
</style>

<script>
  async function setupNotamMap(el: HTMLElement) {
    if (el.dataset.ready) return;
    el.dataset.ready = '1';
    const lat = Number(el.dataset.lat);
    const lon = Number(el.dataset.lon);
    const radiusNm = el.dataset.radius ? Number(el.dataset.radius) : null;
    const points: Array<[number, number]> = el.dataset.points ? JSON.parse(el.dataset.points) : [];
    if (!Number.isFinite(lat) || !Number.isFinite(lon)) return;

    const reach = el.dataset.wide ? 150 : Math.max(radiusNm ?? 5, 3);
    const dLat = reach / 60;
    const dLon = reach / (60 * Math.max(0.2, Math.cos((lat * Math.PI) / 180)));
    const ring: Array<[number, number]> = [];
    if (radiusNm) {
      for (let i = 0; i <= 96; i++) {
        const angle = (i / 96) * Math.PI * 2;
        ring.push([lon + Math.sin(angle) * dLon, lat + Math.cos(angle) * dLat]);
      }
    }

    const { createMap, cssColor } = await import('../lib/map-client');
    const accent = cssColor(document.documentElement, '--accent-blue') || '#00396E';
    try {
      const lons = [lon - dLon * 1.3, lon + dLon * 1.3, ...points.map((p) => p[0])];
      const lats = [lat - dLat * 1.3, lat + dLat * 1.3, ...points.map((p) => p[1])];
      const bounds: [[number, number], [number, number]] = [[Math.min(...lons), Math.min(...lats)], [Math.max(...lons), Math.max(...lats)]];
      await createMap(el, { bounds, maxZoom: 12 }, (map) => {
        if (map.getSource('notam-centre')) return;
        if (ring.length) {
          map.addSource('notam-area', { type: 'geojson', data: { type: 'Feature', properties: {}, geometry: { type: 'Polygon', coordinates: [ring] } } });
          map.addLayer({ id: 'notam-area-fill', type: 'fill', source: 'notam-area', paint: { 'fill-color': accent, 'fill-opacity': 0.14 } });
          map.addLayer({ id: 'notam-area-line', type: 'line', source: 'notam-area', paint: { 'line-color': accent, 'line-width': 2 } });
        }
        map.addSource('notam-centre', { type: 'geojson', data: { type: 'Feature', properties: {}, geometry: { type: 'Point', coordinates: [lon, lat] } } });
        map.addLayer({ id: 'notam-centre', type: 'circle', source: 'notam-centre', paint: { 'circle-radius': 5, 'circle-color': accent, 'circle-stroke-width': 2, 'circle-stroke-color': '#FFFFFF' } });
        if (points.length) {
          map.addSource('notam-points', { type: 'geojson', data: { type: 'FeatureCollection', features: points.map((coordinates) => ({ type: 'Feature', properties: {}, geometry: { type: 'Point', coordinates } })) } });
          map.addLayer({ id: 'notam-points', type: 'circle', source: 'notam-points', paint: { 'circle-radius': 4, 'circle-color': '#FFFFFF', 'circle-stroke-width': 2.5, 'circle-stroke-color': accent } });
        }
      });
    } catch {
      el.closest('section')?.setAttribute('hidden', '');
    }
  }

  function setupAll() {
    const maps = document.querySelectorAll<HTMLElement>('[data-nd-map]');
    if (!('IntersectionObserver' in window)) {
      maps.forEach((el) => setupNotamMap(el));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        setupNotamMap(entry.target as HTMLElement);
      }
    }, { rootMargin: '300px' });
    maps.forEach((el) => observer.observe(el));
  }

  setupAll();
  document.addEventListener('astro:after-swap', setupAll);
</script>
