---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import NotamDecoder from '../../components/NotamDecoder.astro';
import { decodeNotam, decodeNotams, type DecodedNotam } from '../../lib/notam';

const MAX_PASTE = 200000;
const params = Astro.url.searchParams;
let rawParam = (params.get('raw') ?? '').trim();
if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    rawParam = String(form.get('raw') ?? '').trim();
  } catch {
    rawParam = '';
  }
}

let errorMessage: string | null = null;
if (rawParam.length > MAX_PASTE) {
  errorMessage = `That paste is ${Math.round(rawParam.length / 1000)} KB. Paste up to ${MAX_PASTE / 1000} KB at a time.`;
  rawParam = '';
}

const decodedList: DecodedNotam[] = rawParam ? decodeNotams(rawParam) : [];
const decoded: DecodedNotam | null = decodedList[0] ?? null;
const many = decodedList.length > 1;
const errorCount = decodedList.filter((d) => d.issues.some((i) => i.severity === 'error')).length;

function listLabel(d: DecodedNotam): string {
  const id = d.series && d.number ? `${d.series}${d.number}` : d.number ?? '';
  const where = d.fields.find((f) => f.code === 'A')?.raw ?? '';
  return [id, where].filter(Boolean).join(' ');
}

function notamTime(date: Date): string {
  const p = (n: number) => String(n).padStart(2, '0');
  return `${String(date.getUTCFullYear()).slice(2)}${p(date.getUTCMonth() + 1)}${p(date.getUTCDate())}${p(date.getUTCHours())}00`;
}

const day = 86400000;
const today = new Date();
const startsAgo = notamTime(new Date(today.getTime() - 2 * day));
const endsLater = notamTime(new Date(today.getTime() + 21 * day));
const laterToday = notamTime(new Date(today.getTime() + 6 * 3600000));

const examples = [
  {
    label: 'Runway closure',
    raw: `A0142/26 NOTAMN\nQ) KZDC/QMRLC/IV/NBO/A/000/999/3856N07727W005\nA) KIAD B) ${startsAgo} C) ${endsLater} EST\nE) RWY 01L/19R CLSD DUE TO WIP. ACFT UNABLE FULL LGTH DEP RWY 01L/19R.\nF) SFC G) UNL`,
  },
  {
    label: 'Taxiway lighting',
    raw: `A0087/26 NOTAMN\nQ) KZLA/QLYAS/IV/NBO/A/000/999/3356N11824W002\nA) KLAX B) ${startsAgo} C) PERM\nE) TWY A EDGE LGTS U/S BTN TWY A1 AND TWY A4.\nF) SFC G) UNL`,
  },
  {
    label: 'ILS outage',
    raw: `A0211/26 NOTAMN\nQ) KZNY/QICAS/IV/BO/A/000/999/4038N07346W005\nA) KJFK B) ${startsAgo} C) ${laterToday}\nE) ILS RWY 04L LOC U/S.\nF) SFC G) UNL`,
  },
];

const exampleCards = examples.map((example) => {
  const d = decodeNotam(example.raw);
  return {
    ...example,
    airport: d.fields.find((f) => f.code === 'A')?.raw ?? '',
    headline: d.qLine?.subjectPlain ? `${d.qLine.subjectPlain}: ${(d.qLine.conditionPlain ?? '').toLowerCase()}` : example.label,
    text: d.fields.find((f) => f.code === 'E')?.raw ?? '',
  };
});
---

<Layout
  title={decoded?.fields.find((f) => f.code === 'A') ? `${decoded.fields.find((f) => f.code === 'A')?.raw} NOTAM decoded · aviation.foundation` : 'NOTAM Decoder · aviation.foundation'}
  description="Paste a NOTAM and read it in plain English, with the Q-line codes and contractions spelled out and the affected area on a map."
  currentPath="/tools/notam"
>
  <div class="page-container container-site px-site">

    <header class="page-header">
      <div class="eyebrow">Flight planning tool</div>
      <h1 class="serif page-title">NOTAM Decoder</h1>
      <p class="page-lead">
        Paste a NOTAM to read it in plain English. The coded Q-line, each lettered item and the
        contractions in the text are spelled out, and the area it covers is drawn on a map.
      </p>
    </header>

    <section class="nt-console" aria-label="Paste a NOTAM">
      <form method="get" action="/tools/notam" class="nt-paste-form" data-nt-form>
        <label class="col" for="nt-raw">Raw NOTAM text, one or many</label>
        <textarea
          id="nt-raw"
          name="raw"
          class="nt-textarea num"
          rows="6"
          spellcheck="false"
          placeholder={'A0142/25 NOTAMN\nQ) KZDC/QMRLC/IV/NBO/A/000/999/3856N07727W005\nA) KIAD B) 2508310600 C) 2509302359 EST\nE) RWY 01L/19R CLSD DUE TO WIP.\nF) SFC G) UNL'}
        >{rawParam}</textarea>
        <div class="nt-paste-actions">
          <p class="nt-paste-help">
            Paste whole NOTAMs, including the Q) line and the lettered items. A briefing with many
            NOTAMs is split and each one decoded. US domestic and NAV CANADA short-form NOTAMs work too.
          </p>
          <button type="submit" class="btn-solid">Decode</button>
        </div>
      </form>

      {decoded && (
      <div class="nt-examples">
        <span class="col">Try</span>
        {examples.map((example) => (
          <a href={`/tools/notam?raw=${encodeURIComponent(example.raw)}`} class="nt-example">{example.label}</a>
        ))}
      </div>
      )}
    </section>

    {errorMessage && <div class="form-alert nt-alert" data-tone="warning" role="status">{errorMessage}</div>}

    {many && (
      <nav class="nt-list" aria-label="NOTAMs in this paste">
        <p class="nt-list-lead">
          {decodedList.length} NOTAMs in this paste{errorCount ? `, ${errorCount} with errors` : ''}.
        </p>
        <ol>
          {decodedList.map((d, i) => (
            <li class={d.issues.some((x) => x.severity === 'error') ? 'has-error' : d.issues.length ? 'has-warning' : ''}>
              <a href={`#notam-${i + 1}`} class="num">{listLabel(d) || `NOTAM ${i + 1}`}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    {decoded ? (
      decodedList.map((d, i) => (
        <div id={`notam-${i + 1}`} class="nt-item">
          <NotamDecoder decoded={d} />
        </div>
      ))
    ) : (
      !errorMessage && (
        <section class="nt-intro" aria-labelledby="nt-examples-title">
          <h2 class="nt-intro-title" id="nt-examples-title">Start with an example</h2>
          <ul class="nt-cards">
            {exampleCards.map((card) => (
              <li>
                <a href={`/tools/notam?raw=${encodeURIComponent(card.raw)}`} class="nt-card">
                  <span class="nt-card-airport num">{card.airport}</span>
                  <span class="nt-card-headline">{card.headline}</span>
                  <code class="nt-card-raw num">{card.text}</code>
                </a>
              </li>
            ))}
          </ul>
          <p class="nt-intro-note">
            There's no public NOTAM feed to look these up automatically. The FAA's NOTAM API needs a
            registered account, so paste one from your briefing service.
          </p>
        </section>
      )
    )}
  </div>
</Layout>

<style>
  .page-container { padding-top: 56px; padding-bottom: 96px; }
  .page-header { max-width: 760px; }
  .page-title { font-size: clamp(34px, 5vw, 54px); line-height: 1.08; margin: 12px 0 0; letter-spacing: -0.01em; }
  .page-lead { margin: 18px 0 0; font-size: 16px; line-height: 1.65; color: var(--text-muted); }

  .nt-console { margin-top: 40px; border-top: 1px solid var(--border-strong); padding-top: 26px; }
  .nt-paste-form { max-width: 760px; }
  .nt-textarea {
    width: 100%; margin-top: 8px; padding: 14px 16px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 13px; line-height: 1.6; color: var(--fg); background: var(--surface-card); border: 1px solid var(--border-input); border-radius: 0; resize: vertical;
  }
  .nt-textarea:focus { outline: none; border-color: var(--fg); }
  .nt-paste-actions { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-top: 12px; flex-wrap: wrap; }
  .nt-paste-help { margin: 0; font-size: 11.5px; line-height: 1.5; color: var(--text-subtle); max-width: 48ch; }

  .nt-examples { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 20px; }
  .nt-example { font-size: 12px; padding: 4px 10px; border: 1px solid var(--border); color: var(--text-muted); }
  .nt-example:hover { border-color: var(--border-strong); color: var(--fg); }

  .nt-alert { margin-top: 26px; max-width: 760px; }

  .nt-intro { margin-top: 52px; }
  .nt-intro-title { font-family: var(--font-sans); font-size: 15px; font-weight: 600; margin: 0 0 14px; }
  .nt-cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .nt-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 18px;
    background: var(--surface-card);
    border: 1px solid var(--border);
    color: var(--fg);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .nt-card:hover { border-color: var(--border-strong); }
  .nt-card:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
  .nt-card-airport { font-family: var(--font-archivo); font-size: 30px; font-weight: 700; letter-spacing: -0.02em; line-height: 1; }
  .nt-card-headline { font-size: 15px; font-weight: 600; }
  .nt-card-raw { margin-top: auto; font-size: 11.5px; color: var(--text-muted); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; line-height: 1.5; }
  .nt-intro-note { margin: 16px 0 0; font-size: 12.5px; color: var(--text-muted); max-width: 70ch; }
  @media (max-width: 860px) { .nt-cards { grid-template-columns: minmax(0, 1fr); } }

  .nt-list { margin-top: 36px; padding: 16px 18px; border: 1px solid var(--border); background: var(--surface-card); }
  .nt-list-lead { margin: 0 0 10px; font-size: 14px; font-weight: 600; }
  .nt-list ol { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 6px 14px; }
  .nt-list a { font-size: 13px; color: var(--fg); text-decoration: none; border-bottom: 2px solid var(--border); }
  .nt-list li.has-warning a { border-bottom-color: var(--warning); }
  .nt-list li.has-error a { border-bottom-color: var(--danger); }
  .nt-list a:hover { border-bottom-color: var(--fg); }
  .nt-item { scroll-margin-top: 16px; }
  .nt-item + .nt-item { margin-top: 72px; padding-top: 8px; border-top: 1px solid var(--border-strong); }

  @media (max-width: 640px) {
    .nt-paste-actions { flex-direction: column; align-items: stretch; }
    .nt-paste-actions .btn-solid { width: 100%; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-nt-form]');
  form?.addEventListener('submit', () => {
    const field = form.querySelector<HTMLTextAreaElement>('textarea[name="raw"]');
    if (field && field.value.length > 1500) form.method = 'post';
  });
</script>
