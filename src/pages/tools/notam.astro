---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import NotamDecoder from '../../components/NotamDecoder.astro';
import { decodeNotam, type DecodedNotam } from '../../lib/notam';

const params = Astro.url.searchParams;
const rawParam = (params.get('raw') ?? '').trim();

let decoded: DecodedNotam | null = null;
let errorMessage: string | null = null;

if (rawParam) {
  decoded = decodeNotam(rawParam);
}

const examples = [
  {
    label: 'Runway closure',
    raw: 'A0142/25 NOTAMN\nQ) KZDC/QMRLC/IV/NBO/A/000/999/3856N07727W005\nA) KIAD B) 2508310600 C) 2509302359 EST\nE) RWY 01L/19R CLSD DUE TO WIP. ACFT UNABLE FULL LGTH DEP RWY 01L/19R.\nF) SFC G) UNL',
  },
  {
    label: 'Taxiway lighting',
    raw: 'A0087/25 NOTAMN\nQ) KZLA/QLXAS/IV/NBO/A/000/999/3356N11824W002\nA) KLAX B) 2509010000 C) PERM\nE) TWY A EDGE LGTS U/S BTN TWY A1 AND TWY A4.\nF) SFC G) UNL',
  },
  {
    label: 'ILS outage',
    raw: 'A0211/25 NOTAMN\nQ) KZNY/QICAS/IV/BO/A/000/999/4038N07346W005\nA) KJFK B) 2509011200 C) 2509011800\nE) ILS RWY 04L LOC U/S.\nF) SFC G) UNL',
  },
];
---

<Layout
  title={decoded?.fields.find((f) => f.code === 'A') ? `${decoded.fields.find((f) => f.code === 'A')?.raw} NOTAM decoded · aviation.foundation` : 'NOTAM Decoder · aviation.foundation'}
  description="Paste an ICAO-format NOTAM and read it in plain English: the Q-line's subject and condition codes expanded, every A)-G) item translated, and the FAA/ICAO contraction set spelled out. Free, no account, no advertising."
  currentPath="/tools/notam"
>
  <div class="page-container container-site px-site">

    <header class="page-header">
      <div class="eyebrow">Flight planning tool</div>
      <h1 class="serif page-title">NOTAM Decoder</h1>
      <p class="page-lead">
        Paste a NOTAM and read it as a sentence instead of a teletype line. The Q-line's subject and
        condition codes are expanded, every A)–G) item is translated, and the contraction set inside
        the free text - RWY, TWY, U/S, WIP and the rest - is spelled out in full. Anything this
        decoder doesn't recognise is left exactly as written rather than guessed at.
      </p>
    </header>

    <section class="nt-console" aria-label="Paste a NOTAM">
      <form method="get" action="/tools/notam" class="nt-paste-form">
        <label class="col" for="nt-raw">Raw NOTAM text</label>
        <textarea
          id="nt-raw"
          name="raw"
          class="nt-textarea num"
          rows="6"
          spellcheck="false"
          placeholder={'A0142/25 NOTAMN\nQ) KZDC/QMRLC/IV/NBO/A/000/999/3856N07727W005\nA) KIAD B) 2508310600 C) 2509302359 EST\nE) RWY 01L/19R CLSD DUE TO WIP.\nF) SFC G) UNL'}
        >{rawParam}</textarea>
        <div class="nt-paste-actions">
          <p class="nt-paste-help">
            Copy the full NOTAM, headers and all - the A)/B)/C)/E) markers are what this decoder keys
            off. Older US domestic-format NOTAMs (no letter markers) are decoded as loose text on a
            best-effort basis.
          </p>
          <button type="submit" class="btn-solid">Decode</button>
        </div>
      </form>

      <div class="nt-examples">
        <span class="col">Try</span>
        {examples.map((example) => (
          <a href={`/tools/notam?raw=${encodeURIComponent(example.raw)}`} class="nt-example">{example.label}</a>
        ))}
      </div>
    </section>

    {errorMessage && <div class="form-alert nt-alert" data-tone="warning" role="status">{errorMessage}</div>}

    {decoded ? (
      <NotamDecoder decoded={decoded} />
    ) : (
      !errorMessage && (
        <section class="nt-intro">
          <div class="nt-intro-grid">
            <div>
              <div class="col">What it decodes</div>
              <p>
                The ICAO Annex 15 item structure (A through G), the Q-line's FIR, subject code,
                condition code, traffic type, purpose, scope and altitude/radius block, and the FAA/
                ICAO contraction set used inside the free-text E) item.
              </p>
            </div>
            <div>
              <div class="col">Why there's no live lookup</div>
              <p>
                The FAA's NOTAM Search API requires a client id issued to a registered operator, and
                there is no public unauthenticated feed the way there is for METAR/TAF. Paste a NOTAM
                from ForeFlight, 1800wxbrief, or the FAA's own NOTAM Search, and this decodes it.
              </p>
            </div>
            <div>
              <div class="col">What it will not do</div>
              <p>
                Guess. A contraction this decoder doesn't recognise is shown unchanged in the plain-
                English text rather than approximated, and this is a study and planning tool - not a
                substitute for an official briefing before a flight.
              </p>
            </div>
          </div>
        </section>
      )
    )}
  </div>
</Layout>

<style>
  .page-container { padding-top: 56px; padding-bottom: 96px; }
  .page-header { max-width: 760px; }
  .page-title { font-size: clamp(34px, 5vw, 54px); line-height: 1.08; margin: 12px 0 0; letter-spacing: -0.01em; }
  .page-lead { margin: 18px 0 0; font-size: 16px; line-height: 1.65; color: var(--text-muted); }

  .nt-console { margin-top: 40px; border-top: 1px solid var(--border-strong); padding-top: 26px; }
  .nt-paste-form { max-width: 760px; }
  .nt-textarea {
    width: 100%; margin-top: 8px; padding: 14px 16px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 13px; line-height: 1.6; color: var(--fg); background: var(--surface-card); border: 1px solid var(--border-input); border-radius: 0; resize: vertical;
  }
  .nt-textarea:focus { outline: none; border-color: var(--fg); }
  .nt-paste-actions { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-top: 12px; flex-wrap: wrap; }
  .nt-paste-help { margin: 0; font-size: 11.5px; line-height: 1.5; color: var(--text-subtle); max-width: 48ch; }

  .nt-examples { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 20px; }
  .nt-example { font-size: 12px; padding: 4px 10px; border: 1px solid var(--border); color: var(--text-muted); }
  .nt-example:hover { border-color: var(--border-strong); color: var(--fg); }

  .nt-alert { margin-top: 26px; max-width: 760px; }

  .nt-intro { margin-top: 52px; border-top: 1px solid var(--border); padding-top: 28px; }
  .nt-intro-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 32px; }
  .nt-intro-grid p { margin: 10px 0 0; font-size: 13px; line-height: 1.65; color: var(--text-muted); }

  @media (max-width: 640px) {
    .nt-paste-actions { flex-direction: column; align-items: stretch; }
    .nt-paste-actions .btn-solid { width: 100%; }
  }
</style>
