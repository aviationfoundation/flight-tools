---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';

const tools = [
  {
    href: '/tools/metar',
    eyebrow: 'Weather',
    title: 'METAR & TAF Decoder',
    description:
      'Read any observation or forecast as instruments instead of code. Wind rose with runway crosswind components, cloud layers drawn by height and coverage, density altitude against field elevation, and the TAF laid out on a timeline.',
    points: [
      'Full METAR body plus the US remark set',
      'TAF change groups on a timeline coloured by flight category',
      'Crosswind and headwind on any runway you pick',
      'Works from a paste, with no account and no advertising',
    ],
  },
  {
    href: '/tools/notam',
    eyebrow: 'Weather & NAS',
    title: 'NOTAM Decoder',
    description:
      'Paste a NOTAM and read it as a sentence instead of a teletype line. The Q-line’s subject and condition codes expanded, every A)–G) item translated, and the FAA/ICAO contraction set spelled out in full.',
    points: [
      'Full ICAO Annex 15 item structure, A) through G)',
      'Q-line decoded field by field — subject, condition, traffic, scope',
      'Contractions spelled out; anything unrecognised left unchanged',
      'Paste-based — no FAA API key required, no account, no advertising',
    ],
  },
  {
    href: '/tools/e6b',
    eyebrow: 'Flight planning',
    title: 'E6B Flight Computer',
    description:
      'The three calculations the aluminum wheel was built for: a wind triangle for heading and groundspeed, true airspeed from indicated airspeed and density altitude, and time, fuel and distance solved from any two of the three.',
    points: [
      'Wind correction angle, heading and groundspeed on a compass rose',
      'True airspeed from CAS, pressure altitude and OAT',
      'Time/fuel/distance solver — enter any two, get the third',
      'Recomputes live as you type, with no account and no advertising',
    ],
  },
  {
    href: '/tools/weight-balance',
    eyebrow: 'Flight planning',
    title: 'Weight & Balance Worksheet',
    description:
      'Aircraft-agnostic on purpose — no chart is built in. Load your own empty weight, stations and POH limits, and see total weight, moment, CG and whether the loading falls inside your envelope.',
    points: [
      'Moment breakdown, station by station, shown in full',
      'Simple forward/aft limits or a full envelope polygon',
      'CG plotted against the envelope you enter',
      'Works with your own aircraft’s numbers, no account required',
    ],
  },
  {
    href: '/tools/takeoff-landing-distance',
    eyebrow: 'Flight planning',
    title: 'Takeoff & Landing Distance',
    description:
      'Derived, not looked up. Enter your own POH’s baseline distance and this walks it through the correction chain — weight, density altitude, wind, surface, slope — with every multiplier shown.',
    points: [
      'Step-by-step derivation, not a single opaque number',
      'Weight, density altitude, wind, surface and slope corrections',
      'Optional 50 ft obstacle distance alongside ground roll',
      'No aircraft chart baked in — you supply your own baseline',
    ],
  },
  {
    href: '/tools/ad-decoder',
    eyebrow: 'Maintenance',
    title: 'Airworthiness Directive Decoder',
    description:
      'An AD is already in English — the hard part is structure. Paste one and get its lettered paragraphs labelled, its supersession chain pulled out, and its compliance-time language turned into a calculator.',
    points: [
      'Lettered paragraphs (a)–(g) structured and labelled',
      'AD number, amendment, docket and supersession chain extracted',
      'Compliance-time language turned into a due-by-date calculator',
      'Every extraction shown next to the sentence it came from',
    ],
  },
  {
    href: '/tools/currency',
    eyebrow: 'Currency',
    title: 'Currency & Flight Review Tracker',
    description:
      'Log flights as they happen and this works out 90-day passenger currency by day and night, your flight review’s 24-month window, and instrument currency’s rolling 6 months — tied to your account and your dashboard.',
    points: [
      'Rolling-window math, not a fixed-offset approximation',
      'Day and night passenger currency, flight review, instrument currency',
      'Feeds a status card on your dashboard overview',
      'Requires a free account — the one tool on this page that does',
    ],
  },
];
---

<Layout
  title="Tools — aviation.foundation"
  description="Free aviation tools published by aviation.foundation. A METAR and TAF decoder that reads observations as instruments, with no account and no advertising."
  currentPath="/tools"
>
  <div class="page-container container-site px-site">
    <header class="page-header">
      <div class="eyebrow">Utilities</div>
      <h1 class="serif page-title">Tools</h1>
      <p class="page-lead">
        Small, exact utilities for people actually training and flying. Same rules as the rest of
        this site: no advertising in them, and every derived number labelled as derived. All but one
        need no account — the currency tracker is the exception, since the point of it is a log that
        persists on your dashboard between visits.
      </p>
    </header>

    <section class="tool-list">
      {tools.map((tool) => (
        <a href={tool.href} class="tool-card">
          <div class="tool-card-main">
            <span class="col">{tool.eyebrow}</span>
            <h2 class="serif tool-title">{tool.title}</h2>
            <p class="tool-description">{tool.description}</p>
          </div>
          <ul class="tool-points">
            {tool.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
          <span class="tool-cta">Open the tool →</span>
        </a>
      ))}
    </section>
  </div>
</Layout>

<style>
  .page-container { padding-top: 56px; padding-bottom: 96px; }
  .page-header { max-width: 720px; }

  .page-title {
    font-size: clamp(34px, 5vw, 54px);
    line-height: 1.08;
    margin: 12px 0 0;
    letter-spacing: -0.01em;
  }

  .page-lead {
    margin: 18px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .tool-list { margin-top: 44px; border-top: 1px solid var(--border-strong); }

  .tool-card {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 40px;
    padding: 32px 0 30px;
    border-bottom: 1px solid var(--border);
    color: inherit;
    position: relative;
  }

  .tool-card:hover { color: inherit; }
  .tool-card:hover .tool-title { color: var(--accent-blue); }
  .tool-card:hover .tool-cta { border-color: var(--border-strong); }

  .tool-title {
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.15;
    margin: 14px 0 0;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .tool-description {
    margin: 12px 0 0;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 52ch;
  }

  .tool-points {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    align-self: start;
  }

  .tool-points li {
    font-size: 12.5px;
    color: var(--text-muted);
    padding: 8px 0 8px 18px;
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  .tool-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 15px;
    width: 6px;
    height: 1px;
    background: var(--text-muted);
  }

  .tool-cta {
    grid-column: 1 / -1;
    font-size: 13px;
    font-weight: 500;
    color: var(--accent-blue);
    border-top: 1px solid var(--border);
    padding-top: 16px;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  @media (max-width: 780px) {
    .tool-card { grid-template-columns: minmax(0, 1fr); gap: 22px; }
  }
</style>
