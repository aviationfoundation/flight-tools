---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';

const tools = [
  {
    href: '/tools/metar',
    key: 'metar',
    title: 'METAR & TAF',
    description: 'Current weather at any airport, with the wind on your runway, cloud layers by height and the forecast hour by hour.',
  },
  {
    href: '/tools/notam',
    key: 'notam',
    title: 'NOTAM',
    description: 'Paste a NOTAM and read it in plain English, with the area it covers drawn on a map.',
  },
  {
    href: '/tools/e6b',
    key: 'e6b',
    title: 'E6B flight computer',
    description: 'Heading and groundspeed from the wind, true airspeed from your instruments, and time, fuel and distance.',
  },
  {
    href: '/tools/weight-balance',
    key: 'wb',
    title: 'Weight & balance',
    description: "Your loading and centre of gravity, checked against the envelope from your aircraft's POH.",
  },
  {
    href: '/tools/takeoff-landing-distance',
    key: 'tld',
    title: 'Takeoff & landing distance',
    description: 'Your POH distance corrected for weight, density altitude, wind, surface and slope, one step at a time.',
  },
];
---

<Layout
  title="Flight tools · aviation.foundation"
  description="Free flight-planning tools: METAR and TAF decoder, NOTAM decoder, E6B, weight and balance, and takeoff and landing distance. No account and no ads."
  currentPath="/tools"
>
  <div class="page-container container-site px-site">
    <header class="page-header">
      <h1 class="serif page-title">Flight tools</h1>
      <p class="page-lead">
        Free planning tools for student and private pilots, from{' '}
        <a href="https://aviation.foundation">aviation.foundation</a>. It also runs a free registry
        of aviation scholarships and guides to what flight training costs.
      </p>
    </header>

    <ul class="tool-grid">
      {tools.map((tool) => (
        <li>
          <a href={tool.href} class={`tool-card tool-${tool.key}`}>
            <span class="tool-art" aria-hidden="true">
              {tool.key === 'metar' && (
                <svg viewBox="0 0 160 90">
                  <rect x="0" y="22" width="58" height="26" class="art-vfr" />
                  <rect x="60" y="22" width="40" height="26" class="art-mvfr" />
                  <rect x="102" y="22" width="22" height="26" class="art-ifr" />
                  <rect x="126" y="22" width="34" height="26" class="art-vfr" />
                  <rect x="70" y="56" width="30" height="12" class="art-temp" />
                  <line x1="44" y1="14" x2="44" y2="76" class="art-now" />
                  <text x="0" y="14" class="art-text">VFR</text>
                </svg>
              )}
              {tool.key === 'notam' && (
                <svg viewBox="0 0 160 90">
                  <path d="M0 70 Q40 52 80 60 T160 48" class="art-road" />
                  <path d="M20 10 L60 86" class="art-road" />
                  <circle cx="86" cy="44" r="30" class="art-area" />
                  <circle cx="86" cy="44" r="3.5" class="art-centre" />
                </svg>
              )}
              {tool.key === 'e6b' && (
                <svg viewBox="0 0 160 90">
                  <defs>
                    <marker id="art-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 L10 5 L0 10 Z" fill="context-stroke" /></marker>
                  </defs>
                  <line x1="140" y1="70" x2="22" y2="70" class="art-ground" marker-end="url(#art-arrow)" />
                  <line x1="140" y1="70" x2="30" y2="30" class="art-air" marker-end="url(#art-arrow)" />
                  <line x1="30" y1="30" x2="24" y2="66" class="art-wind" marker-end="url(#art-arrow)" />
                </svg>
              )}
              {tool.key === 'wb' && (
                <svg viewBox="0 0 160 90">
                  <line x1="14" y1="6" x2="14" y2="80" class="art-axis" />
                  <line x1="14" y1="80" x2="156" y2="80" class="art-axis" />
                  <polygon points="34,70 34,44 64,14 140,14 140,70" class="art-envelope" />
                  <circle cx="104" cy="26" r="5" class="art-point" />
                </svg>
              )}
              {tool.key === 'tld' && (
                <svg viewBox="0 0 160 90">
                  <rect x="0" y="4" width="96" height="11" class="art-bar" />
                  <rect x="0" y="20" width="88" height="11" class="art-bar" /><rect x="88" y="20" width="8" height="11" class="art-down" />
                  <rect x="0" y="36" width="88" height="11" class="art-bar" /><rect x="88" y="36" width="22" height="11" class="art-up" />
                  <rect x="0" y="52" width="100" height="11" class="art-bar" /><rect x="100" y="52" width="10" height="11" class="art-down" />
                  <rect x="0" y="68" width="126" height="11" class="art-total" />
                </svg>
              )}
            </span>
            <span class="tool-title">{tool.title}</span>
            <span class="tool-description">{tool.description}</span>
          </a>
        </li>
      ))}
    </ul>

    <a class="course-strip" href="/learn">
      <span class="course-name">Reading NOTAMs</span>
      <span class="course-text">
        Eleven short lessons, from the parts of a NOTAM to times, schedules, altitudes, winter runway
        reports and briefing a flight. Free with an aviation.foundation account.
      </span>
      <span class="course-go">Start the course</span>
    </a>
  </div>
</Layout>

<style>
  .page-container { padding-top: 56px; padding-bottom: 40px; }
  .page-header { max-width: 680px; }

  .page-title {
    font-size: clamp(38px, 6vw, 64px);
    line-height: 1.02;
    margin: 0;
    letter-spacing: -0.015em;
  }

  .page-lead {
    margin: 16px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .page-lead a { color: var(--fg); }

  .tool-grid {
    list-style: none;
    margin: 44px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .tool-grid li:first-child { grid-column: span 2; }

  .tool-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 22px 22px 24px;
    background: var(--surface-card);
    border: 1px solid var(--border);
    color: var(--fg);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .tool-card:hover { border-color: var(--border-strong); }
  .tool-card:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }

  .tool-art {
    display: block;
    margin-bottom: 14px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .tool-art svg { display: block; width: 100%; max-width: 220px; height: auto; overflow: visible; }
  .tool-metar .tool-art svg { max-width: 360px; }

  .tool-title {
    font-family: var(--font-archivo);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .tool-description {
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 46ch;
  }

  .art-vfr { fill: #17663B; }
  .art-mvfr { fill: #0B3F73; }
  .art-ifr { fill: #A3261B; }
  .art-temp { fill: none; stroke: #0B3F73; stroke-width: 1.5; }
  .art-now { stroke: var(--fg); stroke-width: 2; }
  .art-text { font-family: var(--font-archivo); font-size: 11px; font-weight: 700; fill: #17663B; }
  .art-road { fill: none; stroke: var(--border); stroke-width: 6; }
  .art-area { fill: var(--accent-blue); fill-opacity: 0.14; stroke: var(--accent-blue); stroke-width: 2; }
  .art-centre { fill: var(--accent-blue); }
  .art-ground { stroke: var(--fg); stroke-width: 3; }
  .art-air { stroke: var(--accent-blue); stroke-width: 3; }
  .art-wind { stroke: var(--accent-sky); stroke-width: 2.4; stroke-dasharray: 5 3; }
  .art-axis { stroke: var(--text-muted); stroke-width: 1; }
  .art-envelope { fill: var(--accent-blue); fill-opacity: 0.12; stroke: var(--accent-blue); stroke-width: 1.6; }
  .art-point { fill: var(--success); }
  .art-bar { fill: var(--fg); opacity: 0.78; }
  .art-up { fill: var(--danger); }
  .art-down { fill: var(--success); }
  .art-total { fill: var(--accent-blue); }

  .course-strip {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    margin-top: 14px;
    padding: 22px 24px;
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
  }

  .course-strip:hover { opacity: 0.94; }
  .course-strip:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }

  .course-name {
    font-family: var(--font-archivo);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .course-text { font-size: 14.5px; line-height: 1.55; opacity: 0.82; max-width: 62ch; }

  .course-go {
    font-size: 14px;
    font-weight: 600;
    padding: 10px 16px;
    border: 1px solid color-mix(in srgb, var(--bg) 45%, transparent);
    white-space: nowrap;
  }

  @media (max-width: 960px) {
    .tool-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .course-strip { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .course-go { justify-self: start; }
  }

  @media (max-width: 600px) {
    .tool-grid { grid-template-columns: minmax(0, 1fr); }
    .tool-grid li:first-child { grid-column: auto; }
  }
</style>
