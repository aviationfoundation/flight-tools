---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import MetarDecoder from '../../components/MetarDecoder.astro';
import { decodeMetar, decodeTaf, formatMiles, type DecodedMetar, type DecodedTaf } from '../../lib/metar';
import { CATEGORY_MEANING, type FlightCategory } from '../../lib/metar-compute';
import { fetchBoard, fetchObservation } from '../../lib/wx-source';
import BOARD_STATIONS from '../../data/board-stations.json';
import { getRunways, getStation, normalizeStationId, searchStations, type RunwayData } from '../../lib/wx-stations';
import { readJson } from '../../lib/data-store';

const params = Astro.url.searchParams;
const stationParam = (params.get('station') ?? '').trim();
const rawParam = (params.get('raw') ?? '').trim();

interface StationInfo {
  icao: string;
  name: string | null;
  lat: number | null;
  lon: number | null;
  elevationFt: number | null;
}

let report: DecodedMetar | null = null;
let taf: DecodedTaf | null = null;
let stationInfo: StationInfo | null = null;
let fetchedAt: string | null = null;
let errorMessage: string | null = null;
let decodedFrom: 'live' | 'paste' | null = null;

function splitPaste(text: string): { metar: string | null; taf: string | null } {
  const cleaned = text.replace(/\r/g, '').replace(/=/g, '\n').trim();
  const lines = cleaned.split('\n').map((line) => line.trim()).filter(Boolean);

  const metarLines: string[] = [];
  const tafLines: string[] = [];
  let inTaf = false;

  for (const line of lines) {
    const tafStart = /\bTAF\b/i.exec(line);
    if (!inTaf && tafStart) {
      const before = line.slice(0, tafStart.index).trim();
      if (before) metarLines.push(before);
      tafLines.push(line.slice(tafStart.index).trim());
      inTaf = true;
      continue;
    }
    (inTaf ? tafLines : metarLines).push(line);
  }

  return {
    metar: metarLines.length ? metarLines.join(' ') : null,
    taf: tafLines.length ? tafLines.join(' ') : null,
  };
}

if (rawParam) {
  decodedFrom = 'paste';
  const parts = splitPaste(rawParam);
  if (parts.taf) taf = decodeTaf(parts.taf);

  if (parts.metar) {
    report = decodeMetar(parts.metar);
  } else if (taf?.station) {
    const bundle = await fetchObservation(taf.station);
    if (bundle.metarRaw) {
      report = decodeMetar(bundle.metarRaw);
      stationInfo = bundle.station;
      fetchedAt = bundle.fetchedAt;
    }
  }

  if (!report) {
    errorMessage = 'That paste has no METAR in it. Include the METAR line, or search for the station instead.';
  } else if (!stationInfo && report.station) {
    const known = await getStation(report.station);
    if (known) {
      stationInfo = { icao: known.icao, name: known.name, lat: known.lat, lon: known.lon, elevationFt: known.elevationFt };
    }
  }
} else if (stationParam) {
  decodedFrom = 'live';
  let id = normalizeStationId(stationParam);

  if (!/^[A-Za-z0-9]{3,4}$/.test(stationParam)) {
    const [match] = await searchStations(stationParam, 1);
    if (match) id = match.icao;
  }

  if (!id || id.length < 3) {
    errorMessage = 'No airport matched that. Try a four-letter ICAO code such as KJFK, or part of the airport name.';
  } else {
    const bundle = await fetchObservation(id);
    fetchedAt = bundle.fetchedAt;
    if (bundle.metarRaw) {
      report = decodeMetar(bundle.metarRaw);
      if (bundle.tafRaw) taf = decodeTaf(bundle.tafRaw);
      stationInfo = bundle.station;
      if (!stationInfo?.elevationFt) {
        const known = await getStation(id);
        if (known) {
          stationInfo = {
            icao: stationInfo?.icao ?? known.icao,
            name: stationInfo?.name ?? known.name,
            lat: stationInfo?.lat ?? known.lat,
            lon: stationInfo?.lon ?? known.lon,
            elevationFt: stationInfo?.elevationFt ?? known.elevationFt,
          };
        }
      }
    } else if (bundle.error === 'no_observation') {
      errorMessage = `${id} has no current METAR. Many small fields don\'t report, and stations sometimes go offline.`;
    } else {
      errorMessage = 'The NOAA weather feed didn\'t respond. Try again in a minute, or paste a report below.';
    }
  }
}

const examples = [
  { icao: 'KJFK', note: 'Busy coastal hub' },
  { icao: 'KDEN', note: 'Field at 5,434 ft' },
  { icao: 'KASE', note: 'Mountain field at 7,820 ft' },
  { icao: 'KSFO', note: 'Prone to marine fog' },
  { icao: 'EGLL', note: 'Reports in metres and hPa' },
  { icao: 'PANC', note: 'Subarctic' },
];

type BoardCategory = Exclude<FlightCategory, 'UNKNOWN'>;

interface BoardItem {
  icao: string;
  place: string;
  why: string;
}

const BOARD_ORDER: BoardCategory[] = ['VFR', 'MVFR', 'IFR', 'LIFR'];
const BOARD_LIMIT = 8;

function boardCategory(visSm: number | null, ceiling: number | null, hasClouds: boolean): FlightCategory {
  if (visSm == null && ceiling == null && !hasClouds) return 'UNKNOWN';
  const byVis: BoardCategory = visSm == null ? 'VFR' : visSm < 1 ? 'LIFR' : visSm < 3 ? 'IFR' : visSm <= 5 ? 'MVFR' : 'VFR';
  const byCeiling: BoardCategory = ceiling == null ? 'VFR' : ceiling < 500 ? 'LIFR' : ceiling < 1000 ? 'IFR' : ceiling <= 3000 ? 'MVFR' : 'VFR';
  return BOARD_ORDER.indexOf(byVis) > BOARD_ORDER.indexOf(byCeiling) ? byVis : byCeiling;
}

function shortPlace(name: string | null, icao: string): string {
  if (!name) return icao;
  return name.replace(/\s+,/g, ',').replace(/,\s*(US|CA)$/, '');
}

let board: Array<{ category: BoardCategory; items: BoardItem[] }> | null = null;
let boardCount = 0;
const BOARD_MAX_AGE_MS = 20 * 60 * 1000;
const showBoard = !report && !errorMessage && !stationParam && !rawParam;

if (showBoard) {
  const published = await readJson<{ generated: string; count: number; columns: Array<{ category: BoardCategory; items: BoardItem[] }> }>('board.json', 60 * 1000);
  if (published && Date.now() - new Date(published.generated).getTime() < BOARD_MAX_AGE_MS) {
    board = published.columns;
    boardCount = published.count;
  }
}

if (showBoard && !board) {
  const rows = await fetchBoard(BOARD_STATIONS);
  if (rows && rows.length) {
    const byIcao = new Map(rows.map((row) => [row.icao, row]));
    const groups = new Map<BoardCategory, BoardItem[]>(BOARD_ORDER.map((cat) => [cat, []]));
    for (const icao of BOARD_STATIONS) {
      const row = byIcao.get(icao);
      if (!row) continue;
      const category = boardCategory(row.visibilitySm, row.ceilingFt, row.hasClouds);
      if (category === 'UNKNOWN') continue;
      const vis = row.visibilitySm != null ? `${formatMiles(Math.round(row.visibilitySm * 100) / 100)}${row.visibilityPlus ? '+' : ''} sm` : null;
      const ceiling = row.ceilingFt != null ? `ceiling ${row.ceilingFt.toLocaleString('en-US')} ft` : 'no ceiling';
      groups.get(category)!.push({ icao, place: shortPlace(row.name, icao), why: [vis, ceiling].filter(Boolean).join(', ') });
      boardCount += 1;
    }
    board = BOARD_ORDER.map((category) => ({ category, items: groups.get(category)! }));
  }
}

const runways: RunwayData[] = report?.station ? await getRunways(report.station) : [];

const pageTitle = report?.station
  ? `${report.station} METAR decoded · aviation.foundation`
  : 'METAR & TAF Decoder · aviation.foundation';
---

<Layout
  title={pageTitle}
  description="Decode any METAR or TAF into plain language, with a wind rose, runway crosswind components, a cloud-layer profile, density altitude, and a forecast timeline. Free, no account, no advertising."
  currentPath="/tools/metar"
>
  <div class="page-container container-site px-site">

    <header class="page-header">
      <div class="eyebrow">Flight planning tool</div>
      <h1 class="serif page-title">METAR &amp; TAF Decoder</h1>
      <p class="page-lead">
        Enter an airport code to decode its latest METAR and TAF: the wind on your runway, cloud
        layers by height, density altitude, and the forecast hour by hour.
      </p>
    </header>

    <section class="wx-console" aria-label="Look up a report">
      <form class="wx-lookup" method="get" action="/tools/metar" autocomplete="off">
        <div class="wx-field">
          <label class="col" for="wx-station">Station</label>
          <div class="wx-input-wrap">
            <input
              type="text"
              id="wx-station"
              name="station"
              class="wx-input num"
              placeholder="Airport code or name, like CYVR or Vancouver"
              value={decodedFrom === 'live' ? stationParam : ''}
              maxlength="40"
              spellcheck="false"
              autocapitalize="characters"
              role="combobox"
              aria-expanded="false"
              aria-controls="wx-suggest"
              aria-autocomplete="list"
            />
            <ul id="wx-suggest" class="wx-suggest" role="listbox" aria-label="Station suggestions" hidden></ul>
          </div>
        </div>
        <button type="submit" class="btn-solid wx-submit">Decode</button>
      </form>

      <div class="wx-console-aside">
        {!board && (
          <div class="wx-examples">
            <span class="col">Try</span>
            {examples.map((example) => (
              <a href={`/tools/metar?station=${example.icao}`} class="wx-example num" title={example.note}>{example.icao}</a>
            ))}
          </div>
        )}
        <div class="wx-recent" id="wx-recent" hidden>
          <span class="col">Recent</span>
          <span class="wx-recent-items" id="wx-recent-items"></span>
        </div>
      </div>

      <details class="wx-paste" open={decodedFrom === 'paste'}>
        <summary>Paste a raw report instead</summary>
        <form method="get" action="/tools/metar" class="wx-paste-form">
          <label class="col" for="wx-raw">Raw METAR, TAF, or both</label>
          <textarea
            id="wx-raw"
            name="raw"
            class="wx-textarea num"
            rows="4"
            spellcheck="false"
            placeholder="METAR KJFK 311851Z 24012G21KT 10SM FEW045 SCT250 24/13 A2998 RMK AO2 SLP152"
          >{decodedFrom === 'paste' ? rawParam : ''}</textarea>
          <div class="wx-paste-actions">
            <p class="wx-paste-help">
              Line breaks are fine. If you paste only a TAF, the station's current METAR is
              fetched to go with it.
            </p>
            <button type="submit" class="btn-outline">Decode paste</button>
          </div>
        </form>
      </details>
    </section>

    {errorMessage && (
      <div class="form-alert wx-alert" data-tone="warning" role="status">{errorMessage}</div>
    )}

    {report ? (
      <MetarDecoder report={report} taf={taf} station={stationInfo} fetchedAt={fetchedAt} runways={runways} />
    ) : (
      !errorMessage && (
        <section class="wx-board" aria-labelledby="wx-board-title">
          {board ? (
            <>
              <h2 class="wx-board-title" id="wx-board-title">Where it's VFR, MVFR, IFR and LIFR right now</h2>
              <p class="wx-board-sub">
                Every reporting station in North America on the map, and {boardCount} major airports
                listed below, from each one's latest METAR. Select any of them to decode it.
              </p>
              <figure class="wx-map" data-wx-map hidden>
                <div class="wx-map-frame">
                  <canvas class="wx-map-canvas" role="img" aria-label="Map of reporting stations in North America, coloured by flight category"></canvas>
                  <div class="wx-map-tip" data-wx-map-tip hidden></div>
                </div>
                <figcaption class="wx-map-legend" data-wx-map-legend></figcaption>
              </figure>
              <div class="wx-cat-cols">
                {board.map((column) => (
                  <section class={`wx-cat-col cat-${column.category.toLowerCase()}`} aria-labelledby={`wx-cat-${column.category}`}>
                    <header class="wx-cat-head">
                      <h3 class="wx-cat-name" id={`wx-cat-${column.category}`}>{column.category}</h3>
                      <span class="wx-cat-count num">{column.items.length}</span>
                      <p class="wx-cat-def">{CATEGORY_MEANING[column.category]}</p>
                    </header>
                    {column.items.length ? (
                      <>
                        <ul class="wx-cat-list">
                          {column.items.slice(0, BOARD_LIMIT).map((item) => (
                            <li>
                              <a href={`/tools/metar?station=${item.icao}`}>
                                <span class="wx-cat-icao num">{item.icao}</span>
                                <span class="wx-cat-place">{item.place}</span>
                                <span class="wx-cat-why num">{item.why}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                        {column.items.length > BOARD_LIMIT && (
                          <details class="wx-cat-more">
                            <summary>Show {column.items.length - BOARD_LIMIT} more</summary>
                            <ul class="wx-cat-list">
                              {column.items.slice(BOARD_LIMIT).map((item) => (
                                <li>
                                  <a href={`/tools/metar?station=${item.icao}`}>
                                    <span class="wx-cat-icao num">{item.icao}</span>
                                    <span class="wx-cat-place">{item.place}</span>
                                    <span class="wx-cat-why num">{item.why}</span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </details>
                        )}
                      </>
                    ) : (
                      <p class="wx-cat-empty">None of these airports right now.</p>
                    )}
                  </section>
                ))}
              </div>
            </>
          ) : (
            <p class="wx-board-sub" id="wx-board-title">
              Live conditions didn't load. Enter an airport code above, or try one of the examples.
            </p>
          )}
          <p class="wx-board-foot">
            Data from NOAA's Aviation Weather Center, refreshed every few minutes. Use an official
            briefing before flight.
          </p>
        </section>
      )
    )}
  </div>
</Layout>

<style>
  .page-container { padding-top: 56px; padding-bottom: 90px; }

  .page-header { max-width: 760px; }

  .page-title {
    font-size: clamp(34px, 5vw, 54px);
    line-height: 1.08;
    margin: 12px 0 0;
    letter-spacing: -0.01em;
  }

  .page-lead {
    margin: 18px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .wx-console {
    margin-top: 40px;
    border-top: 1px solid var(--border-strong);
    padding-top: 26px;
  }

  .wx-lookup {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    max-width: 720px;
  }

  .wx-field { flex: 1; }

  .wx-input-wrap { position: relative; margin-top: 8px; }

  .wx-input {
    width: 100%;
    height: 54px;
    padding: 0 16px;
    font-size: 16px;
    font-family: var(--font-sans);
    color: var(--fg);
    background: var(--surface-card);
    border: 1px solid var(--border-input);
    border-radius: 0;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .wx-input:focus {
    outline: none;
    border-color: var(--fg);
  }

  .wx-submit { height: 54px; padding: 0 28px; }

  .wx-console-aside {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin-top: 16px;
    align-items: center;
  }

  .wx-examples,
  .wx-recent {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .wx-example {
    font-size: 12px;
    padding: 3px 8px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .wx-example:hover { border-color: var(--border-strong); color: var(--fg); }

  .wx-paste { margin-top: 26px; max-width: 720px; }

  .wx-paste summary {
    cursor: pointer;
    font-size: 13px;
    color: var(--text-muted);
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }

  .wx-paste summary:hover { color: var(--fg); }

  .wx-paste-form { padding-top: 12px; }

  .wx-textarea {
    width: 100%;
    margin-top: 8px;
    padding: 12px 14px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 13px;
    line-height: 1.6;
    color: var(--fg);
    background: var(--surface-card);
    border: 1px solid var(--border-input);
    border-radius: 0;
    resize: vertical;
  }

  .wx-textarea:focus { outline: none; border-color: var(--fg); }

  .wx-paste-actions {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  .wx-paste-help {
    margin: 0;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--text-subtle);
    max-width: 44ch;
  }

  .wx-alert { margin-top: 26px; max-width: 720px; }

  .wx-board { margin-top: 52px; }

  .wx-board-title {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 14px;
  }

  .wx-board-sub {
    margin: 0 0 20px;
    font-size: 13.5px;
    color: var(--text-muted);
    max-width: 64ch;
  }

  .wx-cat-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    align-items: start;
  }

  .wx-cat-col {
    --band: #3C4349;
    background: var(--surface-card);
    border: 1px solid var(--border);
  }

  .wx-cat-col.cat-vfr { --band: #17663B; }
  .wx-cat-col.cat-mvfr { --band: #0B3F73; }
  .wx-cat-col.cat-ifr { --band: #A3261B; }
  .wx-cat-col.cat-lifr { --band: #6B2A7C; }

  .wx-cat-head {
    background: var(--band);
    color: #FFFFFF;
    padding: 16px 16px 14px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 4px 12px;
  }

  .wx-cat-name {
    font-family: var(--font-archivo);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
  }

  .wx-cat-count {
    font-family: var(--font-archivo);
    font-size: 30px;
    font-weight: 700;
    line-height: 1;
    opacity: 0.6;
  }

  .wx-cat-def {
    grid-column: 1 / -1;
    margin: 6px 0 0;
    font-size: 12px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.8);
  }

  .wx-cat-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .wx-cat-list li + li { border-top: 1px solid var(--border); }

  .wx-cat-list a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2px 10px;
    padding: 10px 16px;
    color: var(--fg);
    text-decoration: none;
  }

  .wx-cat-list a:hover { background: var(--surface-subtle); }
  .wx-cat-list a:focus-visible { outline: 2px solid var(--fg); outline-offset: -2px; }

  .wx-cat-icao {
    font-family: var(--font-archivo);
    font-weight: 700;
    font-size: 15px;
  }

  .wx-cat-place {
    font-size: 12.5px;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    align-self: center;
  }

  .wx-cat-why {
    grid-column: 1 / -1;
    font-size: 12px;
    color: var(--text-subtle);
  }

  .wx-cat-more { border-top: 1px solid var(--border); }

  .wx-cat-more > summary {
    cursor: pointer;
    padding: 10px 16px;
    font-size: 12.5px;
    color: var(--text-muted);
  }

  .wx-cat-more > summary:hover { color: var(--fg); }
  .wx-cat-more[open] > summary { border-bottom: 1px solid var(--border); }

  .wx-cat-empty {
    margin: 0;
    padding: 14px 16px;
    font-size: 12.5px;
    color: var(--text-subtle);
  }

  .wx-board-foot {
    margin: 14px 0 0;
    font-size: 12px;
    color: var(--text-subtle);
  }

  .wx-map {
    --map-vfr: #17663B;
    --map-mvfr: #1F5FA8;
    --map-ifr: #C0362A;
    --map-lifr: #8E3AA4;
    --map-grid: rgba(17, 17, 17, 0.07);
    margin: 0 0 18px;
  }

  :global([data-theme='dark']) .wx-map {
    --map-vfr: #6FCF97;
    --map-mvfr: #7FA8D6;
    --map-ifr: #F27A70;
    --map-lifr: #D59BE2;
    --map-grid: rgba(255, 255, 255, 0.07);
  }

  .wx-map-frame {
    position: relative;
    background: var(--surface-card);
    border: 1px solid var(--border);
  }

  .wx-map-canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    cursor: crosshair;
  }

  .wx-map-tip {
    position: absolute;
    pointer-events: none;
    background: var(--fg);
    color: var(--bg);
    font-size: 12px;
    line-height: 1.4;
    padding: 6px 9px;
    white-space: nowrap;
    transform: translate(-50%, calc(-100% - 10px));
  }

  .wx-map-tip :global(strong) { font-family: var(--font-archivo); margin-right: 6px; }

  .wx-map-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--text-muted);
  }

  .wx-map-legend :global(span) { display: inline-flex; align-items: center; gap: 6px; }

  .wx-map-legend :global(i) {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--dot);
  }

  @media (max-width: 1080px) {
    .wx-cat-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .wx-lookup { flex-direction: column; align-items: stretch; }
    .wx-submit { width: 100%; }
    .wx-console-aside { gap: 10px 20px; }
  }

  @media (max-width: 480px) {
    .page-container { padding-top: 36px; }
    .wx-console { margin-top: 28px; padding-top: 20px; }
    .wx-input { height: 48px; }
    .wx-submit { height: 48px; }
    .wx-example { font-size: 11px; padding: 3px 7px; }
    .wx-paste-actions { flex-direction: column; align-items: stretch; }
    .wx-paste-actions .btn-outline { width: 100%; }
    .wx-cat-cols { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<style is:global>
  #wx-suggest {
    position: absolute;
    top: calc(100% - 1px);
    left: 0;
    right: 0;
    z-index: 40;
    margin: 0;
    padding: 0;
    list-style: none;
    max-height: 320px;
    overflow-y: auto;
    background: var(--surface-card);
    border: 1px solid var(--fg);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
  }

  #wx-suggest li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
  }

  #wx-suggest li:last-child { border-bottom: none; }

  #wx-suggest li[aria-selected='true'],
  #wx-suggest li:hover {
    background: var(--surface-subtle);
  }

  #wx-suggest .sug-code {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    min-width: 44px;
  }

  #wx-suggest .sug-name {
    color: var(--fg);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #wx-suggest .sug-where {
    color: var(--text-muted);
    font-size: 11.5px;
    white-space: nowrap;
  }

  #wx-recent-items { display: inline-flex; gap: 8px; flex-wrap: wrap; }

  #wx-recent-items a {
    font-size: 12px;
    padding: 3px 8px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  #wx-recent-items a:hover { border-color: var(--border-strong); color: var(--fg); }
</style>

<script>
  import { searchIndex, type StationTuple } from '../../lib/station-search';

  const RECENT_KEY = 'avi_wx_recent';
  const MAX_RECENT = 6;

  let debounce: number | undefined;

  function readRecent(): Array<{ icao: string; name: string }> {
    try {
      const stored = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
      return Array.isArray(stored) ? stored.filter((item) => item && typeof item.icao === 'string').slice(0, MAX_RECENT) : [];
    } catch {
      return [];
    }
  }

  function rememberStation(icao: string, name: string) {
    try {
      const list = readRecent().filter((item) => item.icao !== icao);
      list.unshift({ icao, name });
      localStorage.setItem(RECENT_KEY, JSON.stringify(list.slice(0, MAX_RECENT)));
    } catch {
    }
  }

  function setupWxConsole() {
    const input = document.getElementById('wx-station') as HTMLInputElement | null;
    const list = document.getElementById('wx-suggest') as HTMLUListElement | null;
    const recentWrap = document.getElementById('wx-recent');
    const recentItems = document.getElementById('wx-recent-items');
    if (!input || !list) return;

    if (recentWrap && recentItems) {
      const recent = readRecent();
      if (recent.length) {
        recentItems.innerHTML = '';
        for (const item of recent) {
          const link = document.createElement('a');
          link.href = `/tools/metar?station=${encodeURIComponent(item.icao)}`;
          link.textContent = item.icao;
          link.title = item.name || item.icao;
          recentItems.appendChild(link);
        }
        recentWrap.hidden = false;
      }
    }

    const decoded = document.querySelector<HTMLElement>('.wx');
    const decodedStation = decoded?.querySelector<HTMLElement>('.wx-station')?.textContent?.trim();
    const decodedName = decoded?.querySelector<HTMLElement>('.wx-station-name')?.textContent?.trim();
    if (decodedStation && /^[A-Z0-9]{3,4}$/.test(decodedStation)) {
      rememberStation(decodedStation, (decodedName || '').split(' · ')[0]);
    }

    let items: Array<{ icao: string; name: string; city: string | null; country: string | null }> = [];
    let cursor = -1;

    const close = () => {
      list.hidden = true;
      list.innerHTML = '';
      input.setAttribute('aria-expanded', 'false');
      cursor = -1;
      items = [];
    };

    const choose = (index: number) => {
      const item = items[index];
      if (!item) return;
      input.value = item.icao;
      rememberStation(item.icao, item.name);
      close();
      input.form?.submit();
    };

    const render = () => {
      list.innerHTML = '';
      items.forEach((item, index) => {
        const row = document.createElement('li');
        row.setAttribute('role', 'option');
        row.setAttribute('aria-selected', String(index === cursor));

        const code = document.createElement('span');
        code.className = 'sug-code';
        code.textContent = item.icao;

        const name = document.createElement('span');
        name.className = 'sug-name';
        name.textContent = item.name;

        const where = document.createElement('span');
        where.className = 'sug-where';
        where.textContent = [item.city, item.country].filter(Boolean).join(', ');

        row.append(code, name, where);
        row.addEventListener('mousedown', (event) => {
          event.preventDefault();
          choose(index);
        });
        list.appendChild(row);
      });
      list.hidden = items.length === 0;
      input.setAttribute('aria-expanded', String(items.length > 0));
    };

    const search = async (query: string) => {
      const index = await loadStationIndex();
      if (!index) return close();
      items = searchIndex(index, query, 8).map((station) => ({
        icao: station.icao,
        name: station.name,
        city: station.region,
        country: station.country,
      }));
      cursor = -1;
      render();
    };

    input.addEventListener('focus', () => {
      loadStationIndex();
    }, { once: true });

    input.addEventListener('input', () => {
      const query = input.value.trim();
      if (debounce) window.clearTimeout(debounce);
      if (query.length < 2) return close();
      debounce = window.setTimeout(() => search(query), 160);
    });

    input.addEventListener('keydown', (event) => {
      if (list.hidden || !items.length) return;
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        cursor = event.key === 'ArrowDown' ? (cursor + 1) % items.length : (cursor - 1 + items.length) % items.length;
        render();
        return;
      }
      if (event.key === 'Enter' && cursor >= 0) {
        event.preventDefault();
        choose(cursor);
        return;
      }
      if (event.key === 'Escape') close();
    });

    input.addEventListener('blur', () => window.setTimeout(close, 120));
  }

  let stationIndex: Promise<StationTuple[] | null> | null = null;

  function loadStationIndex(): Promise<StationTuple[] | null> {
    if (!stationIndex) {
      stationIndex = fetch('/data/stations.json')
        .then((response) => (response.ok ? response.json() : null))
        .then((data) => (data && Array.isArray(data.stations) ? (data.stations as StationTuple[]) : null))
        .catch(() => null);
      stationIndex.then((index) => {
        if (!index) stationIndex = null;
      });
    }
    return stationIndex;
  }

  type MapStation = [string, number, number, 'VFR' | 'MVFR' | 'IFR' | 'LIFR', number | null, number, number | null, string];

  const MAP_BOUNDS = { west: -170, east: -50, south: 14, north: 72 };
  const MAP_ORDER: MapStation[3][] = ['VFR', 'MVFR', 'IFR', 'LIFR'];

  function fractionText(value: number): string {
    if (Math.abs(value - Math.round(value)) < 0.01) return String(Math.round(value));
    const whole = Math.floor(value);
    const parts: Array<[number, string]> = [[0.125, '1/8'], [0.25, '1/4'], [0.375, '3/8'], [0.5, '1/2'], [0.625, '5/8'], [0.75, '3/4'], [0.875, '7/8']];
    const frac = parts.reduce((best, p) => (Math.abs(p[0] - (value - whole)) < Math.abs(best[0] - (value - whole)) ? p : best))[1];
    return whole ? `${whole} ${frac}` : frac;
  }

  async function setupMap() {
    const figure = document.querySelector<HTMLElement>('[data-wx-map]');
    if (!figure) return;
    const canvas = figure.querySelector<HTMLCanvasElement>('canvas');
    const tip = figure.querySelector<HTMLElement>('[data-wx-map-tip]');
    const legend = figure.querySelector<HTMLElement>('[data-wx-map-legend]');
    if (!canvas || !tip || !legend) return;

    let stations: MapStation[];
    try {
      const response = await fetch('/data/categories.json');
      if (!response.ok) return;
      const data = await response.json();
      stations = (data.stations as MapStation[]).filter(
        (s) => s[2] >= MAP_BOUNDS.west && s[2] <= MAP_BOUNDS.east && s[1] >= MAP_BOUNDS.south && s[1] <= MAP_BOUNDS.north,
      );
    } catch {
      return;
    }
    if (!stations.length) return;
    figure.hidden = false;

    const midLat = ((MAP_BOUNDS.north + MAP_BOUNDS.south) / 2) * (Math.PI / 180);
    const spanX = (MAP_BOUNDS.east - MAP_BOUNDS.west) * Math.cos(midLat);
    const spanY = MAP_BOUNDS.north - MAP_BOUNDS.south;
    let points: Array<{ x: number; y: number; s: MapStation }> = [];

    const draw = () => {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      const ratio = window.devicePixelRatio || 1;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.clearRect(0, 0, width, height);

      const scale = Math.min(width / spanX, height / spanY);
      const offsetX = (width - spanX * scale) / 2;
      const offsetY = (height - spanY * scale) / 2;
      const project = (lat: number, lon: number) => ({
        x: offsetX + (lon - MAP_BOUNDS.west) * Math.cos(midLat) * scale,
        y: offsetY + (MAP_BOUNDS.north - lat) * scale,
      });

      const style = getComputedStyle(figure);
      ctx.strokeStyle = style.getPropertyValue('--map-grid').trim();
      ctx.lineWidth = 1;
      for (let lon = -160; lon <= -60; lon += 20) {
        const a = project(MAP_BOUNDS.north, lon);
        const b = project(MAP_BOUNDS.south, lon);
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
      }
      for (let lat = 20; lat <= 70; lat += 10) {
        const a = project(lat, MAP_BOUNDS.west);
        const b = project(lat, MAP_BOUNDS.east);
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
      }

      const radius = width < 600 ? 1.6 : 2.3;
      points = [];
      for (const category of MAP_ORDER) {
        ctx.fillStyle = style.getPropertyValue(`--map-${category.toLowerCase()}`).trim();
        for (const s of stations) {
          if (s[3] !== category) continue;
          const p = project(s[1], s[2]);
          points.push({ ...p, s });
          ctx.beginPath();
          ctx.arc(p.x, p.y, category === 'VFR' ? radius : radius + 0.7, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    };

    const counts = MAP_ORDER.map((category) => [category, stations.filter((s) => s[3] === category).length] as const);
    legend.replaceChildren(
      ...counts.map(([category, count]) => {
        const item = document.createElement('span');
        const dot = document.createElement('i');
        dot.style.setProperty('--dot', `var(--map-${category.toLowerCase()})`);
        item.append(dot, `${category} ${count.toLocaleString('en-US')}`);
        return item;
      }),
    );
    canvas.setAttribute(
      'aria-label',
      `Map of ${stations.length.toLocaleString('en-US')} reporting stations in North America: ${counts.map(([c, n]) => `${n} ${c}`).join(', ')}.`,
    );

    const nearest = (event: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      let best: { x: number; y: number; s: MapStation } | null = null;
      let bestDist = 12 * 12;
      for (const p of points) {
        const d = (p.x - x) ** 2 + (p.y - y) ** 2;
        if (d < bestDist) {
          bestDist = d;
          best = p;
        }
      }
      return best;
    };

    canvas.addEventListener('pointermove', (event) => {
      const hit = nearest(event);
      if (!hit) {
        tip.hidden = true;
        return;
      }
      const [icao, , , category, vis, plus, ceiling] = hit.s;
      const label = document.createElement('strong');
      label.textContent = icao;
      const detail = [
        category,
        vis != null ? `${fractionText(vis)}${plus ? '+' : ''} sm` : null,
        ceiling != null ? `ceiling ${ceiling.toLocaleString('en-US')} ft` : 'no ceiling',
      ].filter(Boolean).join(', ');
      tip.replaceChildren(label, detail);
      tip.style.left = `${hit.x}px`;
      tip.style.top = `${hit.y}px`;
      tip.hidden = false;
    });
    canvas.addEventListener('pointerleave', () => {
      tip.hidden = true;
    });
    canvas.addEventListener('click', (event) => {
      const hit = nearest(event);
      if (hit) window.location.href = `/tools/metar?station=${encodeURIComponent(hit.s[0])}`;
    });

    draw();
    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(draw, 120);
    });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => window.setTimeout(draw, 0));
  }

  setupWxConsole();
  setupMap();
  document.addEventListener('astro:after-swap', () => {
    setupWxConsole();
    setupMap();
  });
</script>
