---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import MetarDecoder from '../../components/MetarDecoder.astro';
import { decodeMetar, decodeTaf, formatMiles, type DecodedMetar, type DecodedTaf } from '../../lib/metar';
import { CATEGORY_MEANING, type FlightCategory } from '../../lib/metar-compute';
import { fetchBoard, fetchObservation } from '../../lib/wx-source';
import { BOARD_STATIONS } from '../../lib/board-stations';
import { getStation, normalizeStationId, searchStations } from '../../lib/wx-stations';

const params = Astro.url.searchParams;
const stationParam = (params.get('station') ?? '').trim();
const rawParam = (params.get('raw') ?? '').trim();

interface StationInfo {
  icao: string;
  name: string | null;
  lat: number | null;
  lon: number | null;
  elevationFt: number | null;
}

let report: DecodedMetar | null = null;
let taf: DecodedTaf | null = null;
let stationInfo: StationInfo | null = null;
let fetchedAt: string | null = null;
let errorMessage: string | null = null;
let decodedFrom: 'live' | 'paste' | null = null;

function splitPaste(text: string): { metar: string | null; taf: string | null } {
  const cleaned = text.replace(/\r/g, '').replace(/=/g, '\n').trim();
  const lines = cleaned.split('\n').map((line) => line.trim()).filter(Boolean);

  const metarLines: string[] = [];
  const tafLines: string[] = [];
  let inTaf = false;

  for (const line of lines) {
    const tafStart = /\bTAF\b/i.exec(line);
    if (!inTaf && tafStart) {
      const before = line.slice(0, tafStart.index).trim();
      if (before) metarLines.push(before);
      tafLines.push(line.slice(tafStart.index).trim());
      inTaf = true;
      continue;
    }
    (inTaf ? tafLines : metarLines).push(line);
  }

  return {
    metar: metarLines.length ? metarLines.join(' ') : null,
    taf: tafLines.length ? tafLines.join(' ') : null,
  };
}

if (rawParam) {
  decodedFrom = 'paste';
  const parts = splitPaste(rawParam);
  if (parts.taf) taf = decodeTaf(parts.taf);

  if (parts.metar) {
    report = decodeMetar(parts.metar);
  } else if (taf?.station) {
    const bundle = await fetchObservation(taf.station);
    if (bundle.metarRaw) {
      report = decodeMetar(bundle.metarRaw);
      stationInfo = bundle.station;
      fetchedAt = bundle.fetchedAt;
    }
  }

  if (!report) {
    errorMessage = 'That paste has no METAR in it. Include the METAR line, or search for the station instead.';
  } else if (!stationInfo && report.station && env.DB) {
    const known = await getStation(env.DB, report.station);
    if (known) {
      stationInfo = { icao: known.icao, name: known.name, lat: known.lat, lon: known.lon, elevationFt: known.elevationFt };
    }
  }
} else if (stationParam) {
  decodedFrom = 'live';
  let id = normalizeStationId(stationParam);

  if (!/^[A-Za-z0-9]{3,4}$/.test(stationParam) && env.DB) {
    const [match] = await searchStations(env.DB, stationParam, 1);
    if (match) id = match.icao;
  }

  if (!id || id.length < 3) {
    errorMessage = 'That isn\'t an airport code. Use a four-letter ICAO code such as KJFK or EGLL.';
  } else {
    const bundle = await fetchObservation(id);
    fetchedAt = bundle.fetchedAt;
    if (bundle.metarRaw) {
      report = decodeMetar(bundle.metarRaw);
      if (bundle.tafRaw) taf = decodeTaf(bundle.tafRaw);
      stationInfo = bundle.station;
      if (!stationInfo?.elevationFt && env.DB) {
        const known = await getStation(env.DB, id);
        if (known) {
          stationInfo = {
            icao: stationInfo?.icao ?? known.icao,
            name: stationInfo?.name ?? known.name,
            lat: stationInfo?.lat ?? known.lat,
            lon: stationInfo?.lon ?? known.lon,
            elevationFt: stationInfo?.elevationFt ?? known.elevationFt,
          };
        }
      }
    } else if (bundle.error === 'no_observation') {
      errorMessage = `${id} has no current METAR. Many small fields don\'t report, and stations sometimes go offline.`;
    } else {
      errorMessage = 'The NOAA weather feed didn\'t respond. Try again in a minute, or paste a report below.';
    }
  }
}

const examples = [
  { icao: 'KJFK', note: 'Busy coastal hub' },
  { icao: 'KDEN', note: 'Field at 5,434 ft' },
  { icao: 'KASE', note: 'Mountain field at 7,820 ft' },
  { icao: 'KSFO', note: 'Prone to marine fog' },
  { icao: 'EGLL', note: 'Reports in metres and hPa' },
  { icao: 'PANC', note: 'Subarctic' },
];

type BoardCategory = Exclude<FlightCategory, 'UNKNOWN'>;

interface BoardItem {
  icao: string;
  place: string;
  why: string;
}

const BOARD_ORDER: BoardCategory[] = ['VFR', 'MVFR', 'IFR', 'LIFR'];
const BOARD_LIMIT = 8;

function boardCategory(visSm: number | null, ceiling: number | null, hasClouds: boolean): FlightCategory {
  if (visSm == null && ceiling == null && !hasClouds) return 'UNKNOWN';
  const byVis: BoardCategory = visSm == null ? 'VFR' : visSm < 1 ? 'LIFR' : visSm < 3 ? 'IFR' : visSm <= 5 ? 'MVFR' : 'VFR';
  const byCeiling: BoardCategory = ceiling == null ? 'VFR' : ceiling < 500 ? 'LIFR' : ceiling < 1000 ? 'IFR' : ceiling <= 3000 ? 'MVFR' : 'VFR';
  return BOARD_ORDER.indexOf(byVis) > BOARD_ORDER.indexOf(byCeiling) ? byVis : byCeiling;
}

function shortPlace(name: string | null, icao: string): string {
  if (!name) return icao;
  return name.replace(/\s+,/g, ',').replace(/,\s*(US|CA)$/, '');
}

let board: Array<{ category: BoardCategory; items: BoardItem[] }> | null = null;
let boardCount = 0;
if (!report && !errorMessage && !stationParam && !rawParam) {
  const rows = await fetchBoard(BOARD_STATIONS);
  if (rows && rows.length) {
    const byIcao = new Map(rows.map((row) => [row.icao, row]));
    const groups = new Map<BoardCategory, BoardItem[]>(BOARD_ORDER.map((cat) => [cat, []]));
    for (const icao of BOARD_STATIONS) {
      const row = byIcao.get(icao);
      if (!row) continue;
      const category = boardCategory(row.visibilitySm, row.ceilingFt, row.hasClouds);
      if (category === 'UNKNOWN') continue;
      const vis = row.visibilitySm != null ? `${formatMiles(Math.round(row.visibilitySm * 100) / 100)}${row.visibilityPlus ? '+' : ''} sm` : null;
      const ceiling = row.ceilingFt != null ? `ceiling ${row.ceilingFt.toLocaleString('en-US')} ft` : 'no ceiling';
      groups.get(category)!.push({ icao, place: shortPlace(row.name, icao), why: [vis, ceiling].filter(Boolean).join(', ') });
      boardCount += 1;
    }
    board = BOARD_ORDER.map((category) => ({ category, items: groups.get(category)! }));
  }
}

const pageTitle = report?.station
  ? `${report.station} METAR decoded · aviation.foundation`
  : 'METAR & TAF Decoder · aviation.foundation';
---

<Layout
  title={pageTitle}
  description="Decode any METAR or TAF into plain language, with a wind rose, runway crosswind components, a cloud-layer profile, density altitude, and a forecast timeline. Free, no account, no advertising."
  currentPath="/tools/metar"
>
  <div class="page-container container-site px-site">

    <header class="page-header">
      <div class="eyebrow">Flight planning tool</div>
      <h1 class="serif page-title">METAR &amp; TAF Decoder</h1>
      <p class="page-lead">
        Enter an airport code to decode its latest METAR and TAF: the wind on your runway, cloud
        layers by height, density altitude, and the forecast hour by hour.
      </p>
    </header>

    <section class="wx-console" aria-label="Look up a report">
      <form class="wx-lookup" method="get" action="/tools/metar" autocomplete="off">
        <div class="wx-field">
          <label class="col" for="wx-station">Station</label>
          <div class="wx-input-wrap">
            <input
              type="text"
              id="wx-station"
              name="station"
              class="wx-input num"
              placeholder="Airport code, like KJFK or EGLL"
              value={decodedFrom === 'live' ? stationParam : ''}
              maxlength="40"
              spellcheck="false"
              autocapitalize="characters"
              role="combobox"
              aria-expanded="false"
              aria-controls="wx-suggest"
              aria-autocomplete="list"
            />
            <ul id="wx-suggest" class="wx-suggest" role="listbox" aria-label="Station suggestions" hidden></ul>
          </div>
        </div>
        <button type="submit" class="btn-solid wx-submit">Decode</button>
      </form>

      <div class="wx-console-aside">
        {!board && (
          <div class="wx-examples">
            <span class="col">Try</span>
            {examples.map((example) => (
              <a href={`/tools/metar?station=${example.icao}`} class="wx-example num" title={example.note}>{example.icao}</a>
            ))}
          </div>
        )}
        <div class="wx-recent" id="wx-recent" hidden>
          <span class="col">Recent</span>
          <span class="wx-recent-items" id="wx-recent-items"></span>
        </div>
      </div>

      <details class="wx-paste" open={decodedFrom === 'paste'}>
        <summary>Paste a raw report instead</summary>
        <form method="get" action="/tools/metar" class="wx-paste-form">
          <label class="col" for="wx-raw">Raw METAR, TAF, or both</label>
          <textarea
            id="wx-raw"
            name="raw"
            class="wx-textarea num"
            rows="4"
            spellcheck="false"
            placeholder="METAR KJFK 311851Z 24012G21KT 10SM FEW045 SCT250 24/13 A2998 RMK AO2 SLP152"
          >{decodedFrom === 'paste' ? rawParam : ''}</textarea>
          <div class="wx-paste-actions">
            <p class="wx-paste-help">
              Line breaks are fine. If you paste only a TAF, the station's current METAR is
              fetched to go with it.
            </p>
            <button type="submit" class="btn-outline">Decode paste</button>
          </div>
        </form>
      </details>
    </section>

    {errorMessage && (
      <div class="form-alert wx-alert" data-tone="warning" role="status">{errorMessage}</div>
    )}

    {report ? (
      <MetarDecoder report={report} taf={taf} station={stationInfo} fetchedAt={fetchedAt} />
    ) : (
      !errorMessage && (
        <section class="wx-board" aria-labelledby="wx-board-title">
          {board ? (
            <>
              <h2 class="wx-board-title" id="wx-board-title">Where it's VFR, MVFR, IFR and LIFR right now</h2>
              <p class="wx-board-sub">
                {boardCount} airports across Canada and the US, plus a few major hubs elsewhere, from
                each one's latest METAR. Select one to decode it.
              </p>
              <div class="wx-cat-cols">
                {board.map((column) => (
                  <section class={`wx-cat-col cat-${column.category.toLowerCase()}`} aria-labelledby={`wx-cat-${column.category}`}>
                    <header class="wx-cat-head">
                      <h3 class="wx-cat-name" id={`wx-cat-${column.category}`}>{column.category}</h3>
                      <span class="wx-cat-count num">{column.items.length}</span>
                      <p class="wx-cat-def">{CATEGORY_MEANING[column.category]}</p>
                    </header>
                    {column.items.length ? (
                      <>
                        <ul class="wx-cat-list">
                          {column.items.slice(0, BOARD_LIMIT).map((item) => (
                            <li>
                              <a href={`/tools/metar?station=${item.icao}`}>
                                <span class="wx-cat-icao num">{item.icao}</span>
                                <span class="wx-cat-place">{item.place}</span>
                                <span class="wx-cat-why num">{item.why}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                        {column.items.length > BOARD_LIMIT && (
                          <details class="wx-cat-more">
                            <summary>Show {column.items.length - BOARD_LIMIT} more</summary>
                            <ul class="wx-cat-list">
                              {column.items.slice(BOARD_LIMIT).map((item) => (
                                <li>
                                  <a href={`/tools/metar?station=${item.icao}`}>
                                    <span class="wx-cat-icao num">{item.icao}</span>
                                    <span class="wx-cat-place">{item.place}</span>
                                    <span class="wx-cat-why num">{item.why}</span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </details>
                        )}
                      </>
                    ) : (
                      <p class="wx-cat-empty">None of these airports right now.</p>
                    )}
                  </section>
                ))}
              </div>
            </>
          ) : (
            <p class="wx-board-sub" id="wx-board-title">
              Live conditions didn't load. Enter an airport code above, or try one of the examples.
            </p>
          )}
          <p class="wx-board-foot">
            Data from NOAA's Aviation Weather Center, refreshed every few minutes. Use an official
            briefing before flight.
          </p>
        </section>
      )
    )}
  </div>
</Layout>

<style>
  .page-container { padding-top: 56px; padding-bottom: 90px; }

  .page-header { max-width: 760px; }

  .page-title {
    font-size: clamp(34px, 5vw, 54px);
    line-height: 1.08;
    margin: 12px 0 0;
    letter-spacing: -0.01em;
  }

  .page-lead {
    margin: 18px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .wx-console {
    margin-top: 40px;
    border-top: 1px solid var(--border-strong);
    padding-top: 26px;
  }

  .wx-lookup {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    max-width: 720px;
  }

  .wx-field { flex: 1; }

  .wx-input-wrap { position: relative; margin-top: 8px; }

  .wx-input {
    width: 100%;
    height: 54px;
    padding: 0 16px;
    font-size: 16px;
    font-family: var(--font-sans);
    color: var(--fg);
    background: var(--surface-card);
    border: 1px solid var(--border-input);
    border-radius: 0;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .wx-input:focus {
    outline: none;
    border-color: var(--fg);
  }

  .wx-submit { height: 54px; padding: 0 28px; }

  .wx-console-aside {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin-top: 16px;
    align-items: center;
  }

  .wx-examples,
  .wx-recent {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .wx-example {
    font-size: 12px;
    padding: 3px 8px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .wx-example:hover { border-color: var(--border-strong); color: var(--fg); }

  .wx-paste { margin-top: 26px; max-width: 720px; }

  .wx-paste summary {
    cursor: pointer;
    font-size: 13px;
    color: var(--text-muted);
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }

  .wx-paste summary:hover { color: var(--fg); }

  .wx-paste-form { padding-top: 12px; }

  .wx-textarea {
    width: 100%;
    margin-top: 8px;
    padding: 12px 14px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 13px;
    line-height: 1.6;
    color: var(--fg);
    background: var(--surface-card);
    border: 1px solid var(--border-input);
    border-radius: 0;
    resize: vertical;
  }

  .wx-textarea:focus { outline: none; border-color: var(--fg); }

  .wx-paste-actions {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  .wx-paste-help {
    margin: 0;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--text-subtle);
    max-width: 44ch;
  }

  .wx-alert { margin-top: 26px; max-width: 720px; }

  .wx-board { margin-top: 52px; }

  .wx-board-title {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 14px;
  }

  .wx-board-sub {
    margin: 0 0 20px;
    font-size: 13.5px;
    color: var(--text-muted);
    max-width: 64ch;
  }

  .wx-cat-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    align-items: start;
  }

  .wx-cat-col {
    --band: #3C4349;
    background: var(--surface-card);
    border: 1px solid var(--border);
  }

  .wx-cat-col.cat-vfr { --band: #17663B; }
  .wx-cat-col.cat-mvfr { --band: #0B3F73; }
  .wx-cat-col.cat-ifr { --band: #A3261B; }
  .wx-cat-col.cat-lifr { --band: #6B2A7C; }

  .wx-cat-head {
    background: var(--band);
    color: #FFFFFF;
    padding: 16px 16px 14px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 4px 12px;
  }

  .wx-cat-name {
    font-family: var(--font-archivo);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
  }

  .wx-cat-count {
    font-family: var(--font-archivo);
    font-size: 30px;
    font-weight: 700;
    line-height: 1;
    opacity: 0.6;
  }

  .wx-cat-def {
    grid-column: 1 / -1;
    margin: 6px 0 0;
    font-size: 12px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.8);
  }

  .wx-cat-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .wx-cat-list li + li { border-top: 1px solid var(--border); }

  .wx-cat-list a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2px 10px;
    padding: 10px 16px;
    color: var(--fg);
    text-decoration: none;
  }

  .wx-cat-list a:hover { background: var(--surface-subtle); }
  .wx-cat-list a:focus-visible { outline: 2px solid var(--fg); outline-offset: -2px; }

  .wx-cat-icao {
    font-family: var(--font-archivo);
    font-weight: 700;
    font-size: 15px;
  }

  .wx-cat-place {
    font-size: 12.5px;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    align-self: center;
  }

  .wx-cat-why {
    grid-column: 1 / -1;
    font-size: 12px;
    color: var(--text-subtle);
  }

  .wx-cat-more { border-top: 1px solid var(--border); }

  .wx-cat-more > summary {
    cursor: pointer;
    padding: 10px 16px;
    font-size: 12.5px;
    color: var(--text-muted);
  }

  .wx-cat-more > summary:hover { color: var(--fg); }
  .wx-cat-more[open] > summary { border-bottom: 1px solid var(--border); }

  .wx-cat-empty {
    margin: 0;
    padding: 14px 16px;
    font-size: 12.5px;
    color: var(--text-subtle);
  }

  .wx-board-foot {
    margin: 14px 0 0;
    font-size: 12px;
    color: var(--text-subtle);
  }

  .wx-board-sub {
    margin: 0 0 20px;
    font-size: 13.5px;
    color: var(--text-muted);
    max-width: 64ch;
  }

  .wx-cat-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    align-items: start;
  }

  .wx-cat-col {
    --band: #3C4349;
    background: var(--surface-card);
    border: 1px solid var(--border);
  }

  .wx-cat-col.cat-vfr { --band: #17663B; }
  .wx-cat-col.cat-mvfr { --band: #0B3F73; }
  .wx-cat-col.cat-ifr { --band: #A3261B; }
  .wx-cat-col.cat-lifr { --band: #6B2A7C; }

  .wx-cat-head {
    background: var(--band);
    color: #FFFFFF;
    padding: 16px 16px 14px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 4px 12px;
  }

  .wx-cat-name {
    font-family: var(--font-archivo);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
  }

  .wx-cat-count {
    font-family: var(--font-archivo);
    font-size: 30px;
    font-weight: 700;
    line-height: 1;
    opacity: 0.6;
  }

  .wx-cat-def {
    grid-column: 1 / -1;
    margin: 6px 0 0;
