    padding: 0;
  }

  .wx-cat-list li + li { border-top: 1px solid var(--border); }

  .wx-cat-list a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2px 10px;
    padding: 10px 16px;
    color: var(--fg);
    text-decoration: none;
  }

  .wx-cat-list a:hover { background: var(--surface-subtle); }
  .wx-cat-list a:focus-visible { outline: 2px solid var(--fg); outline-offset: -2px; }

  .wx-cat-icao {
    font-family: var(--font-archivo);
