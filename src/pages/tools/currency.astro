---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getSessionUser } from '../../lib/session';
import { listCurrencyEvents } from '../../lib/db';
import { computeCurrency, type CurrencyEvent } from '../../lib/currency';

const env = Astro.locals.runtime.env;
const user = await getSessionUser(Astro.request, env.DB);
if (!user) {
  return Astro.redirect('/login?returnTo=/tools/currency');
}

const records = await listCurrencyEvents(env.DB, user.type, user.id);
const events: CurrencyEvent[] = records.map((r) => ({
  id: r.id,
  type: r.type as CurrencyEvent['type'],
  occurredOn: r.occurredOn,
  dayLandings: r.dayLandings,
  nightLandings: r.nightLandings,
  approaches: r.approaches,
  holds: r.holds,
  tracking: r.tracking,
  notes: r.notes,
}));

const status = computeCurrency(events);

const EVENT_LABELS: Record<string, string> = {
  landing: 'Landings',
  flight_review: 'Flight review',
  instrument: 'Instrument activity',
  ipc: 'Instrument proficiency check',
};

function fmtDate(d: string | null): string {
  if (!d) return '—';
  return new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
---

<Layout
  title="Currency & Flight Review Tracker — aviation.foundation"
  description="Track 90-day passenger currency, your flight review, and instrument currency from a plain log of flights — every date computed from the actual rolling-window regulation, not a fixed offset."
  currentPath="/tools/currency"
>
  <div class="page-container container-site px-site">
    <header class="page-header">
      <div class="eyebrow">Flight planning tool · signed in as {user.name || user.email}</div>
      <h1 class="serif page-title">Currency &amp; Flight Review Tracker</h1>
      <p class="page-lead">
        Log flights as they happen, and this works out the rest: 90-day passenger currency by day
        and by night, your flight review's 24-calendar-month window, and instrument currency's
        rolling 6 months plus the 6-month grace period before an IPC is required. Every date below
        is recomputed from the log, not stored — so a flight logged late still lands correctly.
      </p>
    </header>

    <section class="cur-stats">
      <div class="cur-stat" data-tone={status.passengerDay.current ? 'ok' : 'danger'}>
        <span class="col">Day passenger currency</span>
        <span class="cur-stat-val serif">{status.passengerDay.current ? 'Current' : 'Not current'}</span>
        <span class="cur-stat-sub num">{status.passengerDay.count} of 3 landings in 90 days{status.passengerDay.expiresOn ? ` · until ${fmtDate(status.passengerDay.expiresOn)}` : ''}</span>
      </div>
      <div class="cur-stat" data-tone={status.passengerNight.count === 0 ? 'neutral' : status.passengerNight.current ? 'ok' : 'warning'}>
        <span class="col">Night passenger currency</span>
        <span class="cur-stat-val serif">{status.passengerNight.count === 0 ? 'No data' : status.passengerNight.current ? 'Current' : 'Not current'}</span>
        <span class="cur-stat-sub num">{status.passengerNight.count} of 3 night landings in 90 days{status.passengerNight.expiresOn ? ` · until ${fmtDate(status.passengerNight.expiresOn)}` : ''}</span>
      </div>
      <div class="cur-stat" data-tone={status.flightReview.current ? 'ok' : 'danger'}>
        <span class="col">Flight review</span>
        <span class="cur-stat-val serif">{status.flightReview.current ? 'Current' : status.flightReview.lastDate ? 'Due' : 'No record'}</span>
        <span class="cur-stat-sub num">{status.flightReview.lastDate ? `Last ${fmtDate(status.flightReview.lastDate)} · ${status.flightReview.current ? 'good through' : 'was due'} ${fmtDate(status.flightReview.dueBy)}` : 'Log your most recent review'}</span>
      </div>
      <div class="cur-stat" data-tone={status.instrument.status === 'current' ? 'ok' : status.instrument.status === 'grace' ? 'warning' : status.instrument.status === 'lapsed' ? 'danger' : 'neutral'}>
        <span class="col">Instrument currency</span>
        <span class="cur-stat-val serif">
          {status.instrument.status === 'current' ? 'Current' : status.instrument.status === 'grace' ? 'Grace period' : status.instrument.status === 'lapsed' ? 'IPC required' : 'No data'}
        </span>
        <span class="cur-stat-sub num">
          {status.instrument.status === 'current' && `${status.instrument.approachesInWindow} approaches in the last 6 months`}
          {status.instrument.status === 'grace' && `Requalify without an IPC by ${fmtDate(status.instrument.graceEndsOn)}`}
          {status.instrument.status === 'lapsed' && `Lapsed since ${fmtDate(status.instrument.graceEndsOn)}`}
          {status.instrument.status === 'no-data' && 'Log approaches, a hold, and course tracking'}
        </span>
      </div>
    </section>

    <section class="cur-layout">
      <form id="cur-form" class="cur-form">
        <div class="col">Log an event</div>
        <div class="cur-type-toggle" role="radiogroup" aria-label="Event type">
          <label class="is-active"><input type="radio" name="type" value="landing" checked data-cur-type /> Landings</label>
          <label><input type="radio" name="type" value="flight_review" data-cur-type /> Flight review</label>
          <label><input type="radio" name="type" value="instrument" data-cur-type /> Instrument activity</label>
          <label><input type="radio" name="type" value="ipc" data-cur-type /> IPC</label>
        </div>

        <div class="cur-field">
          <label class="col" for="cur-date">Date</label>
          <input type="date" id="cur-date" name="occurredOn" class="cur-input" max={status.asOf} required />
        </div>

        <div class="cur-fieldgroup" data-cur-group="landing">
          <div class="cur-field"><label class="col" for="cur-day">Day landings</label><input type="number" id="cur-day" name="dayLandings" class="cur-input num" min="0" max="20" placeholder="0" /></div>
          <div class="cur-field"><label class="col" for="cur-night">Night landings</label><input type="number" id="cur-night" name="nightLandings" class="cur-input num" min="0" max="20" placeholder="0" /></div>
        </div>

        <div class="cur-fieldgroup" data-cur-group="instrument" hidden>
          <div class="cur-field"><label class="col" for="cur-approaches">Approaches</label><input type="number" id="cur-approaches" name="approaches" class="cur-input num" min="0" max="20" placeholder="0" /></div>
          <label class="cur-check"><input type="checkbox" name="holds" /> Included a holding procedure</label>
          <label class="cur-check"><input type="checkbox" name="tracking" /> Included intercepting/tracking courses</label>
        </div>

        <div class="cur-field">
          <label class="col" for="cur-notes">Notes (optional)</label>
          <input type="text" id="cur-notes" name="notes" class="cur-input" maxlength="300" placeholder="N1234A, KJFK ILS 04L x2, VOR-A" />
        </div>

        <div class="cur-form-actions">
          <button type="submit" id="cur-save-btn" class="btn-solid">Log event</button>
          <span id="cur-error" class="cur-error" hidden>Something went wrong — try again.</span>
        </div>
      </form>

      <aside class="cur-log">
        <div class="col">Recent log</div>
        {events.length === 0 ? (
          <p class="cur-empty">Nothing logged yet. Add your most recent flight review and your last few landings to get started.</p>
        ) : (
          <ul class="cur-log-list">
            {events.slice(0, 25).map((e) => (
              <li data-cur-event-id={e.id}>
                <div class="cur-log-main">
                  <span class="cur-log-type">{EVENT_LABELS[e.type]}</span>
                  <span class="cur-log-date num">{fmtDate(e.occurredOn)}</span>
                </div>
                <div class="cur-log-detail">
                  {e.type === 'landing' && `${e.dayLandings ?? 0} day, ${e.nightLandings ?? 0} night`}
                  {(e.type === 'instrument' || e.type === 'ipc') && `${e.approaches ?? 0} approaches${e.holds ? ', hold' : ''}${e.tracking ? ', tracking' : ''}`}
                  {e.notes && <span class="cur-log-notes"> — {e.notes}</span>}
                </div>
                <button type="button" class="cur-log-delete" data-cur-delete={e.id} aria-label="Delete entry">×</button>
              </li>
            ))}
          </ul>
        )}
      </aside>
    </section>

    <section class="cur-notes">
      <header class="cur-panel-head"><span class="col">How to read this</span></header>
      <div class="cur-faq">
        <details class="cur-faq-item" open>
          <summary><span>Where do these rules come from?</span><span class="cur-faq-icon" aria-hidden="true"></span></summary>
          <p>14 CFR 61.57(a)/(b) for the 90-day passenger currency by day and night, 61.56 for the flight review's 24 calendar months, and 61.57(c)/(d) for instrument currency's rolling 6 months plus the 6-month grace period before an instrument proficiency check is required.</p>
        </details>
        <details class="cur-faq-item">
          <summary><span>Why does instrument currency need three separate things?</span><span class="cur-faq-icon" aria-hidden="true"></span></summary>
          <p>61.57(c) requires six instrument approaches, a holding procedure, and intercepting and tracking courses — all within the preceding 6 calendar months, but not necessarily on the same flight. This tracker sums approaches across every logged instrument event in the rolling window and checks whether a hold and course tracking appear anywhere in that same window.</p>
        </details>
        <details class="cur-faq-item">
          <summary><span>What happens after the grace period?</span><span class="cur-faq-icon" aria-hidden="true"></span></summary>
          <p>If instrument currency isn't reestablished within 6 months of lapsing, the regulation requires an instrument proficiency check with an examiner or instructor before acting as PIC under IFR or in IMC — logging one as an "IPC" event here immediately restarts the 6-month clock, matching what the check itself does.</p>
        </details>
        <details class="cur-faq-item">
          <summary><span>Is this a substitute for my logbook?</span><span class="cur-faq-icon" aria-hidden="true"></span></summary>
          <p>No — your logbook is the legal record. This is a planning aid built from a summary of it, so the numbers are only as good as what's logged here. Nothing on this page is submitted anywhere or checked by aviation.foundation staff.</p>
        </details>
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-container { padding-top: 56px; padding-bottom: 96px; }
  .page-header { max-width: 780px; }
  .page-title { font-size: clamp(34px, 5vw, 54px); line-height: 1.08; margin: 12px 0 0; letter-spacing: -0.01em; }
  .page-lead { margin: 18px 0 0; font-size: 16px; line-height: 1.65; color: var(--text-muted); }

  .cur-stats { margin-top: 40px; border-top: 1px solid var(--border-strong); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .cur-stat { padding: 18px 20px 20px 0; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 8px; }
  .cur-stat:last-child { border-right: none; padding-right: 0; }
  .cur-stat-val { font-size: 20px; }
  .cur-stat[data-tone="ok"] .cur-stat-val { color: var(--success); }
  .cur-stat[data-tone="warning"] .cur-stat-val { color: var(--warning); }
  .cur-stat[data-tone="danger"] .cur-stat-val { color: var(--danger); }
  .cur-stat-sub { font-size: 12px; color: var(--text-muted); }

  .cur-layout { margin-top: 40px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 1fr); gap: 48px; }

  .cur-form { display: flex; flex-direction: column; gap: 14px; }
  .cur-type-toggle { display: flex; flex-wrap: wrap; border: 1px solid var(--border); width: fit-content; }
  .cur-type-toggle label { padding: 9px 16px; font-size: 13px; cursor: pointer; position: relative; border-right: 1px solid var(--border); }
  .cur-type-toggle label:last-child { border-right: none; }
  .cur-type-toggle label.is-active { background: var(--fg); color: var(--bg); }
  .cur-type-toggle input { position: absolute; opacity: 0; pointer-events: none; }

  .cur-field { display: flex; flex-direction: column; gap: 6px; }
  .cur-fieldgroup { display: flex; flex-wrap: wrap; gap: 16px; align-items: end; }
  .cur-input { height: 42px; padding: 0 12px; font-size: 14px; font-family: var(--font-sans); color: var(--fg); background: var(--surface-card); border: 1px solid var(--border-input); border-radius: 0; }
  .cur-input:focus { outline: none; border-color: var(--fg); }
  .cur-check { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-muted); padding-bottom: 10px; }

  .cur-form-actions { display: flex; align-items: center; gap: 14px; margin-top: 6px; }
  .cur-error { font-size: 13px; color: var(--danger); }

  .cur-log-list { list-style: none; margin: 12px 0 0; padding: 0; }
  .cur-log-list li { padding: 12px 0; border-top: 1px solid var(--border); position: relative; padding-right: 28px; }
  .cur-log-main { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .cur-log-type { font-size: 13px; font-weight: 600; }
  .cur-log-date { font-size: 12px; color: var(--text-muted); }
  .cur-log-detail { margin-top: 4px; font-size: 12.5px; color: var(--text-muted); }
  .cur-log-notes { color: var(--text-subtle); }
  .cur-log-delete { position: absolute; right: 0; top: 12px; background: none; border: none; color: var(--text-muted); font-size: 16px; line-height: 1; cursor: pointer; padding: 4px 6px; }
  .cur-log-delete:hover { color: var(--danger); }
  .cur-empty { font-size: 12.5px; color: var(--text-muted); line-height: 1.55; margin: 12px 0 0; }

  .cur-notes { margin-top: 52px; border-top: 1px solid var(--border); padding-top: 26px; }
  .cur-panel-head { padding-bottom: 12px; border-bottom: 1px solid var(--border); margin-bottom: 4px; }
  .cur-faq { max-width: 720px; }
  .cur-faq-item { border-top: 1px solid var(--border); }
  .cur-faq-item summary { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; padding: 14px 0; font-size: 14px; }
  .cur-faq-item summary::-webkit-details-marker { display: none; }
  .cur-faq-icon { width: 14px; height: 14px; position: relative; flex-shrink: 0; }
  .cur-faq-icon::before, .cur-faq-icon::after { content: ''; position: absolute; background: var(--text-muted); top: 50%; left: 50%; transform: translate(-50%, -50%); }
  .cur-faq-icon::before { width: 10px; height: 1.4px; }
  .cur-faq-icon::after { width: 1.4px; height: 10px; transition: transform var(--dur-fast) var(--ease-out); }
  .cur-faq-item[open] .cur-faq-icon::after { transform: translate(-50%, -50%) scaleY(0); }
  .cur-faq-item p { margin: 0 0 16px; font-size: 13px; line-height: 1.65; color: var(--text-muted); }

  @media (max-width: 900px) {
    .cur-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cur-layout { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 520px) {
    .cur-stats { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  function setup() {
    const form = document.getElementById('cur-form') as HTMLFormElement | null;
    if (!form || form.dataset.wired) return;
    form.dataset.wired = 'true';

    const groups = form.querySelectorAll<HTMLElement>('[data-cur-group]');
    const typeInputs = form.querySelectorAll<HTMLInputElement>('[data-cur-type]');

    function syncType() {
      const selected = form!.querySelector<HTMLInputElement>('[data-cur-type]:checked')?.value ?? 'landing';
      groups.forEach((g) => (g.hidden = g.dataset.curGroup !== selected));
      typeInputs.forEach((input) => {
        input.closest('label')?.classList.toggle('is-active', input.checked);
      });
    }
    typeInputs.forEach((input) => input.addEventListener('change', syncType));
    syncType();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('cur-save-btn') as HTMLButtonElement | null;
      const errorEl = document.getElementById('cur-error');
      if (errorEl) errorEl.hidden = true;

      const type = form.querySelector<HTMLInputElement>('[data-cur-type]:checked')?.value ?? 'landing';
      const occurredOn = (form.elements.namedItem('occurredOn') as HTMLInputElement)?.value;
      if (!occurredOn) return;

      const payload: Record<string, unknown> = { type, occurredOn };
      const notes = (form.elements.namedItem('notes') as HTMLInputElement)?.value.trim();
      if (notes) payload.notes = notes;

      if (type === 'landing') {
        const day = Number((form.elements.namedItem('dayLandings') as HTMLInputElement)?.value || 0);
        const night = Number((form.elements.namedItem('nightLandings') as HTMLInputElement)?.value || 0);
        payload.dayLandings = day;
        payload.nightLandings = night;
      } else if (type === 'instrument' || type === 'ipc') {
        payload.approaches = Number((form.elements.namedItem('approaches') as HTMLInputElement)?.value || 0);
        payload.holds = (form.elements.namedItem('holds') as HTMLInputElement)?.checked ?? false;
        payload.tracking = (form.elements.namedItem('tracking') as HTMLInputElement)?.checked ?? false;
      }

      if (saveBtn) saveBtn.disabled = true;
      try {
        const res = await fetch('/api/currency/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('failed');
        window.location.reload();
      } catch {
        if (errorEl) errorEl.hidden = false;
        if (saveBtn) saveBtn.disabled = false;
      }
    });

    document.querySelectorAll<HTMLButtonElement>('[data-cur-delete]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.curDelete;
        if (!id) return;
        btn.disabled = true;
        try {
          const res = await fetch('/api/currency/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id }),
          });
          if (res.ok) window.location.reload();
        } catch {
          btn.disabled = false;
        }
      });
    });
  }

  setup();
  document.addEventListener('astro:after-swap', setup);
</script>
