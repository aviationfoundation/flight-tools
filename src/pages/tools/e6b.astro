---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import {
  windTriangle,
  trueAirspeed,
  timeFuelDistance,
  formatHm,
  pad3,
  type WindTriangleResult,
  type TasResult,
  type TfdResult,
} from '../../lib/e6b';
import { triangleGeometry, TRIANGLE_SIZE } from '../../lib/e6b-triangle';

const params = Astro.url.searchParams;
const fresh = [...params.keys()].length === 0;
const EXAMPLE: Record<string, number> = { tc: 270, tas: 110, wd: 230, ws: 18, cas: 120, pa: 8500, oat: 18, dist: 185, gs: 132, burn: 9.5, fuel: 40 };

function num(name: string): number | null {
  if (fresh && name in EXAMPLE) return EXAMPLE[name];
  const raw = params.get(name);
  if (raw == null || raw.trim() === '') return null;
  const n = Number(raw);
  return Number.isFinite(n) ? n : null;
}

const tc = num('tc');
const tas = num('tas');
const wd = num('wd');
const ws = num('ws');
let wind: WindTriangleResult | null = null;
let windError: string | null = null;
if (tc != null && tas != null && wd != null && ws != null) {
  wind = windTriangle({ trueCourseDeg: tc, tasKt: tas, windFromDeg: wd, windSpeedKt: ws });
  if (!wind) windError = 'That wind is stronger than your airspeed on the beam - no heading holds this course.';
}

const cas = num('cas');
const pa = num('pa');
const oat = num('oat');
let tasCalc: TasResult | null = null;
if (cas != null && pa != null && oat != null) {
  tasCalc = trueAirspeed(cas, pa, oat);
}

const dist = num('dist');
const gs = num('gs');
const time = num('time');
const burn = num('burn');
const fuel = num('fuel');
let tfd: TfdResult | null = null;
const hasTfdInput = dist != null || gs != null || time != null || burn != null || fuel != null;
if (hasTfdInput) {
  tfd = timeFuelDistance({ distanceNm: dist, groundSpeedKt: gs, timeMin: time, fuelBurnGph: burn, fuelOnBoardGal: fuel });
}

const triangle = wind && tc != null && tas != null ? triangleGeometry(tc, wind.groundSpeedKt, wind.headingDeg, tas) : null;

---

<Layout
  title="E6B Flight Computer · aviation.foundation"
  description="Wind correction angle, groundspeed and true heading; true airspeed from calibrated airspeed and density altitude; time, fuel and distance solved from any two of the three. Free, no account, no advertising."
  currentPath="/tools/e6b"
>
  <div class="page-container container-site px-site">

    <header class="page-header">
      <div class="eyebrow">Flight planning tool</div>
      <h1 class="serif page-title">E6B Flight Computer</h1>
      <p class="page-lead">
        The three jobs of the paper flight computer: the heading and groundspeed a wind gives you,
        true airspeed from your instruments, and time, fuel and distance from any two of the three.
        The example numbers are filled in; change any of them.
      </p>
    </header>

    <section class="e6b-panel" id="e6b-wind">
      <header class="e6b-panel-head">
        <span class="col">Wind triangle</span>
        <span class="e6b-panel-note">Heading and groundspeed for one leg</span>
      </header>

      <div class="e6b-body">
        <form method="get" action="/tools/e6b#e6b-wind" class="e6b-form" data-e6b-form="wind">
          <div class="e6b-field">
            <label class="col" for="e6b-tc">True course</label>
            <div class="e6b-input-wrap"><input type="number" id="e6b-tc" name="tc" class="e6b-input num" min="0" max="359" step="1" placeholder="270" value={tc ?? ''} data-e6b-input="tc" /><span class="e6b-unit">°T</span></div>
          </div>
          <div class="e6b-field">
            <label class="col" for="e6b-tas">True airspeed</label>
            <div class="e6b-input-wrap"><input type="number" id="e6b-tas" name="tas" class="e6b-input num" min="1" step="1" placeholder="110" value={tas ?? ''} data-e6b-input="tas" /><span class="e6b-unit">kt</span></div>
          </div>
          <div class="e6b-field">
            <label class="col" for="e6b-wd">Wind from</label>
            <div class="e6b-input-wrap"><input type="number" id="e6b-wd" name="wd" class="e6b-input num" min="0" max="359" step="1" placeholder="230" value={wd ?? ''} data-e6b-input="wd" /><span class="e6b-unit">°T</span></div>
          </div>
          <div class="e6b-field">
            <label class="col" for="e6b-ws">Wind speed</label>
            <div class="e6b-input-wrap"><input type="number" id="e6b-ws" name="ws" class="e6b-input num" min="0" step="1" placeholder="18" value={ws ?? ''} data-e6b-input="ws" /><span class="e6b-unit">kt</span></div>
          </div>
          <button type="submit" class="btn-outline e6b-submit">Solve</button>
        </form>

        <div class="e6b-visual">
          <svg viewBox={`0 0 ${TRIANGLE_SIZE} ${TRIANGLE_SIZE}`} class="e6b-tri" role="img" aria-label="Wind triangle: heading and true airspeed, plus the wind, add up to the track and groundspeed" data-e6b-triangle>
            <defs>
              <marker id="e6b-arrow-ground" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" class="tri-head-ground" /></marker>
              <marker id="e6b-arrow-air" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" class="tri-head-air" /></marker>
              <marker id="e6b-arrow-wind" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" class="tri-head-wind" /></marker>
            </defs>
            <g class="tri-north" transform={`translate(${TRIANGLE_SIZE - 22} 26)`}>
              <line x1="0" y1="14" x2="0" y2="-10" />
              <text x="0" y="-14" text-anchor="middle">N</text>
            </g>
            <g data-tri-body visibility={triangle ? 'visible' : 'hidden'}>
              <line class="tri-ground" marker-end="url(#e6b-arrow-ground)" data-tri="ground" x1={triangle?.ground.x1} y1={triangle?.ground.y1} x2={triangle?.ground.x2} y2={triangle?.ground.y2} />
              <line class="tri-air" marker-end="url(#e6b-arrow-air)" data-tri="air" x1={triangle?.air.x1} y1={triangle?.air.y1} x2={triangle?.air.x2} y2={triangle?.air.y2} />
              <line class="tri-wind" marker-end="url(#e6b-arrow-wind)" data-tri="wind" x1={triangle?.wind.x1} y1={triangle?.wind.y1} x2={triangle?.wind.x2} y2={triangle?.wind.y2} />
              <circle class="tri-origin" r="3.5" cx={triangle?.ground.x1} cy={triangle?.ground.y1} data-tri-origin />
              <text class="tri-label tri-label-ground num" text-anchor="middle" data-tri-label="ground" x={triangle?.ground.lx} y={triangle?.ground.ly}>{wind ? `${Math.round(wind.groundSpeedKt)} kt` : ''}</text>
              <text class="tri-label tri-label-air num" text-anchor="middle" data-tri-label="air" x={triangle?.air.lx} y={triangle?.air.ly}>{tas != null ? `${tas} kt` : ''}</text>
              <text class="tri-label tri-label-wind num" text-anchor="middle" data-tri-label="wind" x={triangle?.wind.lx} y={triangle?.wind.ly}>{ws != null ? `${ws} kt` : ''}</text>
            </g>
          </svg>
          <ul class="e6b-legend">
            <li><i class="key course"></i>Track over the ground <span class="num" data-out="leg-track">{tc != null ? `${pad3(tc)}°` : ''}</span></li>
            <li><i class="key heading"></i>Heading through the air <span class="num" data-out="leg-heading">{wind ? `${pad3(wind.headingDeg)}°` : ''}</span></li>
            <li><i class="key wind"></i>Wind <span class="num" data-out="leg-wind">{wd != null && ws != null ? `from ${pad3(wd)}°` : ''}</span></li>
          </ul>
        </div>

        <div class="e6b-results" data-e6b-results="wind">
          {windError && <div class="form-alert" data-tone="warning" role="status">{windError}</div>}
          {wind && (
            <>
              <div class="e6b-stat-band">
                <div class="e6b-stat">
                  <div class="col">Heading to fly</div>
                  <div class="e6b-stat-value serif num" data-out="heading">{pad3(wind.headingDeg)}°</div>
                  <div class="e6b-stat-unit">true</div>
                </div>
                <div class="e6b-stat">
                  <div class="col">Wind correction</div>
                  <div class="e6b-stat-value serif num" data-out="wca">{Math.abs(wind.windCorrectionAngleDeg).toFixed(1)}°</div>
                  <div class="e6b-stat-unit" data-out="wca-dir">{wind.windCorrectionAngleDeg >= 0 ? 'right of course' : 'left of course'}</div>
                </div>
                <div class="e6b-stat">
                  <div class="col">Groundspeed</div>
                  <div class="e6b-stat-value serif num" data-out="gs">{Math.round(wind.groundSpeedKt)}</div>
                  <div class="e6b-stat-unit">knots</div>
                </div>
              </div>
              <p class="e6b-derivation">
                Wind is <span data-out="rel-angle">{Math.abs(Math.round(wind.relativeWindAngleDeg))}°</span> off your nose
                from the <span data-out="rel-side">{wind.relativeWindAngleDeg >= 0 ? 'right' : 'left'}</span>, splitting into
                a <span data-out="headwind">{Math.abs(wind.headwindKt).toFixed(1)}</span> kt <span data-out="head-kind">{wind.headwindKt >= 0 ? 'headwind' : 'tailwind'}</span>{' '}
                and a <span data-out="crosswind">{wind.crosswindKt.toFixed(1)}</span> kt crosswind
                {wind.crosswindFrom !== 'none' && <> from the <span data-out="cross-side">{wind.crosswindFrom}</span></>}. Turn
                <span data-out="wca2"> {Math.abs(wind.windCorrectionAngleDeg).toFixed(1)}°</span> into the wind to hold your
                course. The crosswind sets that angle; <span data-out="head-effect">{wind.headwindKt >= 0 ? 'the headwind is what comes off your airspeed' : 'the tailwind adds to your airspeed'}</span>.
              </p>
            </>
          )}
          {!wind && !windError && <p class="e6b-empty">Enter a course, true airspeed and wind to solve for heading and groundspeed.</p>}
        </div>
      </div>
    </section>

    <section class="e6b-panel" id="e6b-tas-panel">
      <header class="e6b-panel-head">
        <span class="col">True airspeed</span>
        <span class="e6b-panel-note">From calibrated airspeed, pressure altitude and outside air temperature</span>
      </header>

      <div class="e6b-body e6b-body-narrow">
        <form method="get" action="/tools/e6b#e6b-tas-panel" class="e6b-form" data-e6b-form="tas">
          <div class="e6b-field">
            <label class="col" for="e6b-cas">Calibrated airspeed</label>
            <div class="e6b-input-wrap"><input type="number" id="e6b-cas" name="cas" class="e6b-input num" min="1" step="1" placeholder="120" value={cas ?? ''} data-e6b-input="cas" /><span class="e6b-unit">kt</span></div>
          </div>
          <div class="e6b-field">
            <label class="col" for="e6b-pa">Pressure altitude</label>
            <div class="e6b-input-wrap"><input type="number" id="e6b-pa" name="pa" class="e6b-input num" step="100" placeholder="8500" value={pa ?? ''} data-e6b-input="pa" /><span class="e6b-unit">ft</span></div>
          </div>
          <div class="e6b-field">
            <label class="col" for="e6b-oat">Outside air temp</label>
            <div class="e6b-input-wrap"><input type="number" id="e6b-oat" name="oat" class="e6b-input num" step="1" placeholder="18" value={oat ?? ''} data-e6b-input="oat" /><span class="e6b-unit">°C</span></div>
          </div>
          <button type="submit" class="btn-outline e6b-submit">Solve</button>
        </form>

        <div class="e6b-results" data-e6b-results="tas">
          {tasCalc && (
            <>
              <div class="e6b-stat-band">
                <div class="e6b-stat">
                  <div class="col">True airspeed</div>
                  <div class="e6b-stat-value serif num" data-out="tas">{Math.round(tasCalc.tasKt)}</div>
                  <div class="e6b-stat-unit">knots</div>
                </div>
                <div class="e6b-stat">
                  <div class="col">Density altitude</div>
                  <div class="e6b-stat-value serif num" data-out="da">{tasCalc.densityAltFt.toLocaleString('en-US')}</div>
                  <div class="e6b-stat-unit">ft</div>
                </div>
                <div class="e6b-stat">
                  <div class="col">ISA deviation</div>
                  <div class="e6b-stat-value serif num" data-out="isa">{tasCalc.isaDevC >= 0 ? '+' : ''}{tasCalc.isaDevC.toFixed(1)}</div>
                  <div class="e6b-stat-unit">°C</div>
                </div>
              </div>
              <p class="e6b-derivation">
                Air this thin and <span data-out="isa2">{Math.abs(tasCalc.isaDevC).toFixed(1)}°C {tasCalc.isaDevC >= 0 ? 'warmer' : 'cooler'} than
                standard</span> has a density ratio (σ) of <span data-out="sigma">{tasCalc.densityRatio.toFixed(3)}</span> against
                sea level. The airspeed indicator reads dynamic pressure, not speed through the air, so true airspeed is
                calibrated airspeed divided by √σ - <span data-out="tas2">{Math.round(tasCalc.tasKt)}</span> kt for
                <span data-out="cas2"> {cas}</span> kt indicated.
              </p>
              <a class="e6b-link" data-e6b-use-tas href="#e6b-wind">Use this true airspeed in the wind triangle above ↑</a>
            </>
          )}
          {!tasCalc && <p class="e6b-empty">Enter calibrated airspeed, pressure altitude and OAT to solve for true airspeed and density altitude.</p>}
        </div>
      </div>
    </section>

    <section class="e6b-panel" id="e6b-tfd">
      <header class="e6b-panel-head">
        <span class="col">Time, fuel, distance</span>
        <span class="e6b-panel-note">Enter any two of distance, groundspeed and time to get the third</span>
      </header>

      <div class="e6b-body e6b-body-narrow">
        <form method="get" action="/tools/e6b#e6b-tfd" class="e6b-form e6b-form-tfd" data-e6b-form="tfd">
          <div class="e6b-field">
            <label class="col" for="e6b-dist">Distance</label>
            <div class="e6b-input-wrap"><input type="number" id="e6b-dist" name="dist" class="e6b-input num" min="0" step="0.1" placeholder="185" value={dist ?? ''} data-e6b-input="dist" /><span class="e6b-unit">nm</span></div>
          </div>
          <div class="e6b-field">
            <label class="col" for="e6b-gs">Groundspeed</label>
            <div class="e6b-input-wrap"><input type="number" id="e6b-gs" name="gs" class="e6b-input num" min="0" step="1" placeholder="132" value={gs ?? ''} data-e6b-input="gs" /><span class="e6b-unit">kt</span></div>
          </div>
          <div class="e6b-field">
            <label class="col" for="e6b-time">Time</label>
            <div class="e6b-input-wrap"><input type="number" id="e6b-time" name="time" class="e6b-input num" min="0" step="1" placeholder="84" value={time ?? ''} data-e6b-input="time" /><span class="e6b-unit">min</span></div>
          </div>
          <div class="e6b-field">
            <label class="col" for="e6b-burn">Fuel burn</label>
            <div class="e6b-input-wrap"><input type="number" id="e6b-burn" name="burn" class="e6b-input num" min="0" step="0.1" placeholder="9.5" value={burn ?? ''} data-e6b-input="burn" /><span class="e6b-unit">gph</span></div>
          </div>
          <div class="e6b-field">
            <label class="col" for="e6b-fuel">Fuel on board</label>
            <div class="e6b-input-wrap"><input type="number" id="e6b-fuel" name="fuel" class="e6b-input num" min="0" step="0.1" placeholder="40" value={fuel ?? ''} data-e6b-input="fuel" /><span class="e6b-unit">gal</span></div>
          </div>
          <button type="submit" class="btn-outline e6b-submit">Solve</button>
        </form>

        <div class="e6b-results" data-e6b-results="tfd">
          {tfd && (tfd.distanceNm != null || tfd.groundSpeedKt != null || tfd.timeMin != null) ? (
            <>
              <div class="e6b-stat-band">
                <div class="e6b-stat">
                  <div class="col">Distance</div>
                  <div class="e6b-stat-value serif num" data-out="dist">{tfd.distanceNm != null ? Math.round(tfd.distanceNm * 10) / 10 : '-'}</div>
                  <div class="e6b-stat-unit">nm</div>
                </div>
                <div class="e6b-stat">
                  <div class="col">Groundspeed</div>
                  <div class="e6b-stat-value serif num" data-out="gs">{tfd.groundSpeedKt != null ? Math.round(tfd.groundSpeedKt) : '-'}</div>
                  <div class="e6b-stat-unit">kt</div>
                </div>
                <div class="e6b-stat">
                  <div class="col">Time en route</div>
                  <div class="e6b-stat-value serif num" data-out="time">{formatHm(tfd.timeMin)}</div>
                  <div class="e6b-stat-unit">{tfd.solvedFor.includes('time') ? 'solved' : 'entered'}</div>
                </div>
              </div>
              {(tfd.fuelUsedGal != null || tfd.enduranceMin != null) && (
                <dl class="e6b-facts">
                  {tfd.fuelUsedGal != null && (
                    <div><dt>Fuel used this leg</dt><dd class="num" data-out="fuel-used">{tfd.fuelUsedGal.toFixed(1)} gal</dd></div>
                  )}
                  {tfd.fuelRemainingGal != null && (
                    <div><dt>Fuel remaining on arrival</dt><dd class="num" data-out="fuel-rem">{tfd.fuelRemainingGal.toFixed(1)} gal</dd></div>
                  )}
                  {tfd.enduranceMin != null && (
                    <div><dt>Endurance at this burn</dt><dd class="num" data-out="endurance">{formatHm(tfd.enduranceMin)}</dd></div>
                  )}
                </dl>
              )}
            </>
          ) : (
            <p class="e6b-empty">Enter any two of distance, groundspeed and time to solve for the third. Add a fuel burn rate and quantity on board to see fuel used and endurance.</p>
          )}
        </div>
      </div>
    </section>

    <section class="e6b-notes">
      <header class="e6b-panel-head">
        <span class="col">How to read this</span>
      </header>
      <div class="e6b-faq">
        <details class="e6b-faq-item" open>
          <summary><span>Where does the wind correction angle come from?</span><span class="e6b-faq-icon" aria-hidden="true"></span></summary>
          <p>From the law of sines on the wind triangle: the crosswind component divided by true airspeed gives the sine of the correction angle. It is exact for the geometry, not an approximation - the only imprecision is whatever error is in the wind and airspeed you fed in.</p>
        </details>
        <details class="e6b-faq-item">
          <summary><span>Why is true airspeed higher than calibrated airspeed up high?</span><span class="e6b-faq-icon" aria-hidden="true"></span></summary>
          <p>The airspeed indicator measures dynamic pressure, which thins out with the air. At altitude the same dynamic pressure - the same indicated reading - corresponds to the aircraft moving faster through the thinner air. The correction is the inverse square root of the density ratio, σ.</p>
        </details>
        <details class="e6b-faq-item">
          <summary><span>Is this compressible or incompressible airspeed?</span><span class="e6b-faq-icon" aria-hidden="true"></span></summary>
          <p>Incompressible - the same relation a mechanical E6B's slide rule side encodes. Below about 200 knots and 10,000 feet the compressibility correction is under a knot or two; this tool does not apply it, the same way the aluminum wheel never did.</p>
        </details>
        <details class="e6b-faq-item">
          <summary><span>What does this tool not do?</span><span class="e6b-faq-icon" aria-hidden="true"></span></summary>
          <p>It does not know your aircraft's performance, does not account for magnetic variation between true and magnetic heading, and does not replace a real wind aloft forecast. It solves the triangle you give it - the numbers going in are on you.</p>
        </details>
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-container { padding-top: 56px; padding-bottom: 96px; }
  .page-header { max-width: 760px; }
  .page-title { font-size: clamp(34px, 5vw, 54px); line-height: 1.08; margin: 12px 0 0; letter-spacing: -0.01em; }
  .page-lead { margin: 18px 0 0; font-size: 16px; line-height: 1.65; color: var(--text-muted); }

  .e6b-panel { margin-top: 44px; border-top: 1px solid var(--border-strong); padding-top: 26px; scroll-margin-top: 24px; }

  .e6b-panel-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding-bottom: 14px; border-bottom: 1px solid var(--border); margin-bottom: 24px;
  }
  .e6b-panel-note { font-size: 11.5px; color: var(--text-subtle); }

  .e6b-body {
    display: grid;
    grid-template-columns: minmax(200px, 260px) minmax(200px, 240px) minmax(260px, 1fr);
    gap: 32px;
    align-items: start;
  }
  .e6b-body-narrow { grid-template-columns: minmax(220px, 280px) minmax(260px, 1fr); }

  .e6b-form { display: flex; flex-direction: column; gap: 14px; }
  .e6b-form-tfd { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }

  .e6b-field { display: flex; flex-direction: column; gap: 6px; }
  .e6b-input-wrap { position: relative; display: flex; align-items: center; }
  .e6b-input {
    width: 100%; height: 44px; padding: 0 44px 0 12px; font-size: 15px; font-family: var(--font-sans);
    color: var(--fg); background: var(--surface-card); border: 1px solid var(--border-input); border-radius: 0;
  }
  .e6b-input:focus { outline: none; border-color: var(--fg); }
  .e6b-unit { position: absolute; right: 12px; font-size: 11.5px; color: var(--text-subtle); pointer-events: none; }
  .e6b-submit { align-self: flex-start; margin-top: 4px; }

  .e6b-visual { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .e6b-tri { width: 100%; max-width: 300px; display: block; overflow: visible; }
  .tri-ground { stroke: var(--fg); stroke-width: 3; }
  .tri-air { stroke: var(--accent-blue); stroke-width: 3; }
  .tri-wind { stroke: var(--accent-sky); stroke-width: 2.4; stroke-dasharray: 6 4; }
  .tri-head-ground { fill: var(--fg); }
  .tri-head-air { fill: var(--accent-blue); }
  .tri-head-wind { fill: var(--accent-sky); }
  .tri-origin { fill: var(--fg); }
  .tri-label { font-size: 12px; font-weight: 600; }
  .tri-label-ground { fill: var(--fg); }
  .tri-label-air { fill: var(--accent-blue); }
  .tri-label-wind { fill: var(--accent-sky); }
  .tri-north line { stroke: var(--text-muted); stroke-width: 1.4; }
  .tri-north text { font-size: 10px; font-weight: 700; fill: var(--text-muted); }

  .e6b-legend { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 11.5px; color: var(--text-muted); }
  .e6b-legend li { display: flex; align-items: center; gap: 8px; }
  .key { width: 16px; height: 3px; display: inline-block; margin-right: 8px; vertical-align: middle; }
  .key.course { background: var(--fg); }
  .key.wind { background: repeating-linear-gradient(to right, var(--accent-sky) 0 5px, transparent 5px 8px); }
  .key.heading { background: var(--accent-blue); }

  .e6b-results { min-width: 0; }
  .e6b-stat-band { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .e6b-stat { padding: 14px 16px 16px 0; border-right: 1px solid var(--border); }
  .e6b-stat:last-child { border-right: none; padding-right: 0; }
  .e6b-stat-value { font-size: clamp(22px, 3vw, 30px); line-height: 1.1; margin-top: 8px; }
  .e6b-stat-unit { margin-top: 4px; font-size: 11.5px; color: var(--text-muted); }

  .e6b-derivation { margin: 16px 0 0; font-size: 13px; line-height: 1.65; color: var(--text-muted); max-width: 62ch; }
  .e6b-derivation span { color: var(--fg); font-variant-numeric: tabular-nums; }
  .e6b-empty { font-size: 12.5px; color: var(--text-muted); line-height: 1.55; margin: 0; padding-top: 6px; }
  .e6b-link { display: inline-block; margin-top: 14px; font-size: 12.5px; }

  .e6b-facts { margin: 18px 0 0; display: grid; gap: 8px; }
  .e6b-facts div { display: flex; justify-content: space-between; gap: 16px; padding: 8px 0; border-top: 1px solid var(--border); font-size: 13px; }
  .e6b-facts dt { color: var(--text-muted); }
  .e6b-facts dd { margin: 0; }

  .e6b-notes { margin-top: 52px; border-top: 1px solid var(--border); padding-top: 26px; }
  .e6b-faq { max-width: 720px; }
  .e6b-faq-item { border-top: 1px solid var(--border); }
  .e6b-faq-item summary { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; padding: 14px 0; font-size: 14px; }
  .e6b-faq-item summary::-webkit-details-marker { display: none; }
  .e6b-faq-icon { width: 14px; height: 14px; position: relative; flex-shrink: 0; }
  .e6b-faq-icon::before, .e6b-faq-icon::after { content: ''; position: absolute; background: var(--text-muted); top: 50%; left: 50%; transform: translate(-50%, -50%); }
  .e6b-faq-icon::before { width: 10px; height: 1.4px; }
  .e6b-faq-icon::after { width: 1.4px; height: 10px; transition: transform var(--dur-fast) var(--ease-out); }
  .e6b-faq-item[open] .e6b-faq-icon::after { transform: translate(-50%, -50%) scaleY(0); }
  .e6b-faq-item p { margin: 0 0 16px; font-size: 13px; line-height: 1.65; color: var(--text-muted); }

  @media (max-width: 900px) {
    .e6b-body, .e6b-body-narrow { grid-template-columns: minmax(0, 1fr); }
    .e6b-stat-band { grid-template-columns: minmax(0, 1fr); }
    .e6b-stat { border-right: none; border-bottom: 1px solid var(--border); padding: 12px 0; }
    .e6b-stat:last-child { border-bottom: none; }
  }
</style>

<script>
  import { windTriangle, trueAirspeed, timeFuelDistance, formatHm, pad3 } from '../../lib/e6b';
  import { triangleGeometry } from '../../lib/e6b-triangle';

  function readNum(form: HTMLFormElement, name: string): number | null {
    const el = form.elements.namedItem(name) as HTMLInputElement | null;
    if (!el || el.value.trim() === '') return null;
    const n = Number(el.value);
    return Number.isFinite(n) ? n : null;
  }

  function setText(root: ParentNode, key: string, value: string) {
    root.querySelectorAll<HTMLElement>(`[data-out="${key}"]`).forEach((el) => (el.textContent = value));
  }

  function setup() {
    const root = document;

    const windForm = root.querySelector<HTMLFormElement>('[data-e6b-form="wind"]');
    const windResults = root.querySelector<HTMLElement>('[data-e6b-results="wind"]');
    const triangleBody = root.querySelector<SVGGElement>('[data-tri-body]');

    function drawTriangle(tc: number, gsKt: number, headingDeg: number, tas: number, ws: number) {
      if (!triangleBody) return;
      const geometry = triangleGeometry(tc, gsKt, headingDeg, tas);
      for (const key of ['ground', 'air', 'wind'] as const) {
        const seg = geometry[key];
        const line = triangleBody.querySelector<SVGLineElement>(`[data-tri="${key}"]`);
        line?.setAttribute('x1', String(seg.x1));
        line?.setAttribute('y1', String(seg.y1));
        line?.setAttribute('x2', String(seg.x2));
        line?.setAttribute('y2', String(seg.y2));
        const label = triangleBody.querySelector<SVGTextElement>(`[data-tri-label="${key}"]`);
        label?.setAttribute('x', String(seg.lx));
        label?.setAttribute('y', String(seg.ly));
        if (label) label.textContent = key === 'ground' ? `${Math.round(gsKt)} kt` : key === 'air' ? `${tas} kt` : `${ws} kt`;
      }
      const origin = triangleBody.querySelector<SVGCircleElement>('[data-tri-origin]');
      origin?.setAttribute('cx', String(geometry.ground.x1));
      origin?.setAttribute('cy', String(geometry.ground.y1));
      triangleBody.setAttribute('visibility', 'visible');
    }

    function renderWind() {
      if (!windForm || !windResults) return;
      const tc = readNum(windForm, 'tc');
      const tas = readNum(windForm, 'tas');
      const wd = readNum(windForm, 'wd');
      const ws = readNum(windForm, 'ws');

      if (tc != null) setText(document, 'leg-track', `${pad3(tc)}°`);
      if (wd != null) setText(document, 'leg-wind', `from ${pad3(wd)}°`);

      if (tc == null || tas == null || wd == null || ws == null) return;
      const result = windTriangle({ trueCourseDeg: tc, tasKt: tas, windFromDeg: wd, windSpeedKt: ws });
      if (!result) {
        triangleBody?.setAttribute('visibility', 'hidden');
        return;
      }
      drawTriangle(tc, result.groundSpeedKt, result.headingDeg, tas, ws);
      setText(document, 'leg-heading', `${pad3(result.headingDeg)}°`);
      setText(windResults, 'head-kind', result.headwindKt >= 0 ? 'headwind' : 'tailwind');
      setText(windResults, 'head-effect', result.headwindKt >= 0 ? 'the headwind is what comes off your airspeed' : 'the tailwind adds to your airspeed');

      setText(windResults, 'heading', `${pad3(result.headingDeg)}°`);
      setText(windResults, 'wca', `${Math.abs(result.windCorrectionAngleDeg).toFixed(1)}°`);
      setText(windResults, 'wca-dir', result.windCorrectionAngleDeg >= 0 ? 'right of course' : 'left of course');
      setText(windResults, 'gs', `${Math.round(result.groundSpeedKt)}`);
      setText(windResults, 'rel-angle', `${Math.abs(Math.round(result.relativeWindAngleDeg))}°`);
      setText(windResults, 'rel-side', result.relativeWindAngleDeg >= 0 ? 'right' : 'left');
      setText(windResults, 'headwind', `${Math.abs(result.headwindKt).toFixed(1)}`);
      setText(windResults, 'crosswind', `${result.crosswindKt.toFixed(1)}`);
      if (result.crosswindFrom !== 'none') setText(windResults, 'cross-side', result.crosswindFrom);
      setText(windResults, 'wca2', ` ${Math.abs(result.windCorrectionAngleDeg).toFixed(1)}°`);
    }

    windForm?.querySelectorAll('input').forEach((el) => el.addEventListener('input', renderWind));
    windForm?.addEventListener('submit', (e) => e.preventDefault());

    const tasForm = root.querySelector<HTMLFormElement>('[data-e6b-form="tas"]');
    const tasResults = root.querySelector<HTMLElement>('[data-e6b-results="tas"]');
    const useTasLink = root.querySelector<HTMLAnchorElement>('[data-e6b-use-tas]');

    function renderTas() {
      if (!tasForm || !tasResults) return;
      const cas = readNum(tasForm, 'cas');
      const pa = readNum(tasForm, 'pa');
      const oat = readNum(tasForm, 'oat');
      if (cas == null || pa == null || oat == null) return;
      const result = trueAirspeed(cas, pa, oat);
      setText(tasResults, 'tas', `${Math.round(result.tasKt)}`);
      setText(tasResults, 'da', result.densityAltFt.toLocaleString('en-US'));
      setText(tasResults, 'isa', `${result.isaDevC >= 0 ? '+' : ''}${result.isaDevC.toFixed(1)}`);
      setText(tasResults, 'isa2', `${Math.abs(result.isaDevC).toFixed(1)}°C ${result.isaDevC >= 0 ? 'warmer' : 'cooler'} than standard`);
      setText(tasResults, 'sigma', result.densityRatio.toFixed(3));
      setText(tasResults, 'tas2', `${Math.round(result.tasKt)}`);
      setText(tasResults, 'cas2', ` ${cas}`);
      if (useTasLink) useTasLink.dataset.tasValue = String(Math.round(result.tasKt));
    }

    tasForm?.querySelectorAll('input').forEach((el) => el.addEventListener('input', renderTas));
    tasForm?.addEventListener('submit', (e) => e.preventDefault());

    useTasLink?.addEventListener('click', (e) => {
      e.preventDefault();
      const value = useTasLink.dataset.tasValue;
      const tasInput = windForm?.elements.namedItem('tas') as HTMLInputElement | null;
      if (value && tasInput) {
        tasInput.value = value;
        renderWind();
        document.getElementById('e6b-wind')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    const tfdForm = root.querySelector<HTMLFormElement>('[data-e6b-form="tfd"]');
    const tfdResults = root.querySelector<HTMLElement>('[data-e6b-results="tfd"]');

    function renderTfd() {
      if (!tfdForm || !tfdResults) return;
      const distanceNm = readNum(tfdForm, 'dist');
      const groundSpeedKt = readNum(tfdForm, 'gs');
      const timeMin = readNum(tfdForm, 'time');
      const fuelBurnGph = readNum(tfdForm, 'burn');
      const fuelOnBoardGal = readNum(tfdForm, 'fuel');
      if (distanceNm == null && groundSpeedKt == null && timeMin == null) return;

      const result = timeFuelDistance({ distanceNm, groundSpeedKt, timeMin, fuelBurnGph, fuelOnBoardGal });
      setText(tfdResults, 'dist', result.distanceNm != null ? String(Math.round(result.distanceNm * 10) / 10) : '-');
      setText(tfdResults, 'gs', result.groundSpeedKt != null ? String(Math.round(result.groundSpeedKt)) : '-');
      setText(tfdResults, 'time', formatHm(result.timeMin));
      if (result.fuelUsedGal != null) setText(tfdResults, 'fuel-used', `${result.fuelUsedGal.toFixed(1)} gal`);
      if (result.fuelRemainingGal != null) setText(tfdResults, 'fuel-rem', `${result.fuelRemainingGal.toFixed(1)} gal`);
      if (result.enduranceMin != null) setText(tfdResults, 'endurance', formatHm(result.enduranceMin));
    }

    tfdForm?.querySelectorAll('input').forEach((el) => el.addEventListener('input', renderTfd));
    tfdForm?.addEventListener('submit', (e) => e.preventDefault());
  }

  setup();
  document.addEventListener('astro:after-swap', setup);
</script>
