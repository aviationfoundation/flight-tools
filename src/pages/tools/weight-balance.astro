---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import {
  computeWeightBalance,
  checkLimits,
  parseEnvelope,
  type Station,
} from '../../lib/weight-balance';

const params = Astro.url.searchParams;
function num(name: string): number | null {
  const raw = params.get(name);
  if (raw == null || raw.trim() === '') return null;
  const n = Number(raw);
  return Number.isFinite(n) ? n : null;
}

const MAX_STATIONS = 6;
const DEFAULT_LABELS = ['Front seats', 'Rear seats', 'Baggage A', 'Baggage B', 'Fuel', 'Station 6'];

const emptyWeightLb = num('ew');
const emptyArmIn = num('ea');

const stations: Station[] = Array.from({ length: MAX_STATIONS }, (_, i) => {
  const n = i + 1;
  return {
    name: params.get(`s${n}n`) || DEFAULT_LABELS[i],
    weightLb: num(`s${n}w`),
    armIn: num(`s${n}a`),
  };
});
const activeCount = Math.max(3, stations.filter((s) => s.weightLb != null || s.armIn != null).length || 3);

const maxGrossLb = num('mg');
const fwdLimitIn = num('fl');
const aftLimitIn = num('al');
const envelopeText = params.get('env') || '';
const envelope = parseEnvelope(envelopeText);

const result = computeWeightBalance({ emptyWeightLb, emptyArmIn, stations });
const hasAnyInput = emptyWeightLb != null || emptyArmIn != null || stations.some((s) => s.weightLb != null);
const limits = checkLimits(result.totalWeightLb, result.cgIn, { maxGrossLb, fwdLimitIn, aftLimitIn, envelope });

const PLOT_W = 320;
const PLOT_H = 260;
const PAD_L = 46;
const PAD_R = 14;
const PAD_T = 14;
const PAD_B = 30;

const armCandidates = [
  ...envelope.map((p) => p.armIn),
  ...(fwdLimitIn != null ? [fwdLimitIn] : []),
  ...(aftLimitIn != null ? [aftLimitIn] : []),
  ...(result.cgIn != null ? [result.cgIn] : []),
];
const weightCandidates = [
  ...envelope.map((p) => p.weightLb),
  ...(maxGrossLb != null ? [maxGrossLb] : []),
  result.totalWeightLb,
];

const armMin = armCandidates.length ? Math.min(...armCandidates) : 0;
const armMax = armCandidates.length ? Math.max(...armCandidates) : 100;
const armPad = Math.max(1, (armMax - armMin) * 0.12);
const armLo = armMin - armPad;
const armHi = armMax + armPad;

const weightMax = weightCandidates.length ? Math.max(...weightCandidates) : 1000;
const weightHi = weightMax * 1.12;

function plotX(arm: number): number {
  return PAD_L + ((arm - armLo) / (armHi - armLo || 1)) * (PLOT_W - PAD_L - PAD_R);
}
function plotY(weight: number): number {
  return PLOT_H - PAD_B - (weight / (weightHi || 1)) * (PLOT_H - PAD_T - PAD_B);
}

const envelopePolyPoints = envelope.map((p) => `${plotX(p.armIn).toFixed(1)},${plotY(p.weightLb).toFixed(1)}`).join(' ');
const showPlot = envelope.length >= 3 || (fwdLimitIn != null && aftLimitIn != null);

const cgStatus =
  limits.withinEnvelope != null
    ? limits.withinEnvelope
    : limits.withinSimpleLimits != null
      ? limits.withinSimpleLimits
      : null;
const overallOk = cgStatus !== false && !limits.overGross;
---

<Layout
  title="Weight & Balance Worksheet — aviation.foundation"
  description="Aircraft-agnostic weight and balance: load your own empty weight, stations and POH limits, and see total weight, moment, CG and whether the loading falls inside your envelope. Free, no account, no advertising."
  currentPath="/tools/weight-balance"
>
  <div class="page-container container-site px-site">
    <header class="page-header">
      <div class="eyebrow">Flight planning tool</div>
      <h1 class="serif page-title">Weight &amp; Balance Worksheet</h1>
      <p class="page-lead">
        No aircraft is built in — every real chart belongs to a specific POH. Load your own empty
        weight and arm, add the stations your aircraft has, and, if you want the result checked,
        your own forward/aft limits or a full envelope polygon. The moments, the sum, and the CG
        are the one part that's identical from a Cub to a King Air.
      </p>
    </header>

    <section class="wb-layout">
      <form method="get" action="/tools/weight-balance" class="wb-form" id="wb-form">
        <div class="wb-block">
          <div class="col">Empty aircraft</div>
          <div class="wb-row wb-row-fixed">
            <div class="wb-cell wb-cell-name"><span class="wb-cell-label">Item</span><span class="wb-static">Empty aircraft</span></div>
            <div class="wb-cell"><label class="wb-cell-label" for="wb-ew">Weight (lb)</label><input type="number" id="wb-ew" name="ew" class="wb-input num" step="0.1" min="0" value={emptyWeightLb ?? ''} data-wb-input /></div>
            <div class="wb-cell"><label class="wb-cell-label" for="wb-ea">Arm (in)</label><input type="number" id="wb-ea" name="ea" class="wb-input num" step="0.01" value={emptyArmIn ?? ''} data-wb-input /></div>
            <div class="wb-cell wb-cell-moment"><span class="wb-cell-label">Moment</span><span class="num wb-moment" data-wb-moment="0">{result.rows[0]?.momentInLb != null ? Math.round(result.rows[0].momentInLb).toLocaleString('en-US') : '—'}</span></div>
          </div>
        </div>

        <div class="wb-block">
          <div class="wb-block-head">
            <span class="col">Stations</span>
            <button type="button" class="wb-add" id="wb-add-station">+ Add station</button>
          </div>
          {stations.map((station, i) => (
            <div class="wb-row" data-wb-station={i + 1} hidden={i + 1 > activeCount}>
              <div class="wb-cell wb-cell-name">
                <span class="wb-cell-label">Item</span>
                <input type="text" name={`s${i + 1}n`} class="wb-input" maxlength="30" value={station.name} placeholder={DEFAULT_LABELS[i]} data-wb-input />
              </div>
              <div class="wb-cell"><span class="wb-cell-label">Weight (lb)</span><input type="number" name={`s${i + 1}w`} class="wb-input num" step="0.1" min="0" value={station.weightLb ?? ''} data-wb-input /></div>
              <div class="wb-cell"><span class="wb-cell-label">Arm (in)</span><input type="number" name={`s${i + 1}a`} class="wb-input num" step="0.01" value={station.armIn ?? ''} data-wb-input /></div>
              <div class="wb-cell wb-cell-moment">
                <span class="wb-cell-label">Moment</span>
                <span class="num wb-moment" data-wb-moment={i + 1}>{result.rows[i + 1]?.momentInLb != null ? Math.round(result.rows[i + 1].momentInLb!).toLocaleString('en-US') : '—'}</span>
                <button type="button" class="wb-remove" data-wb-remove={i + 1} aria-label="Remove station" hidden={i + 1 <= 3}>×</button>
              </div>
            </div>
          ))}
        </div>

        <details class="wb-limits" open={maxGrossLb != null || fwdLimitIn != null || envelope.length > 0}>
          <summary>Check against limits (optional)</summary>
          <div class="wb-limits-grid">
            <div class="wb-field">
              <label class="col" for="wb-mg">Max gross weight</label>
              <div class="wb-input-wrap"><input type="number" id="wb-mg" name="mg" class="wb-input num" min="0" step="1" value={maxGrossLb ?? ''} data-wb-input /><span class="wb-unit">lb</span></div>
            </div>
            <div class="wb-field">
              <label class="col" for="wb-fl">Forward CG limit</label>
              <div class="wb-input-wrap"><input type="number" id="wb-fl" name="fl" class="wb-input num" step="0.01" value={fwdLimitIn ?? ''} data-wb-input /><span class="wb-unit">in</span></div>
            </div>
            <div class="wb-field">
              <label class="col" for="wb-al">Aft CG limit</label>
              <div class="wb-input-wrap"><input type="number" id="wb-al" name="al" class="wb-input num" step="0.01" value={aftLimitIn ?? ''} data-wb-input /><span class="wb-unit">in</span></div>
            </div>
          </div>
          <div class="wb-field wb-field-envelope">
            <label class="col" for="wb-env">Full envelope (optional) — one <code>arm,weight</code> point per line, tracing the polygon in order</label>
            <textarea id="wb-env" name="env" class="wb-textarea num" rows="4" spellcheck="false" placeholder={'35.0,1500\n38.5,1500\n47.3,1950\n35.0,1950'} data-wb-input>{envelopeText}</textarea>
            <p class="wb-help">When a full envelope is given it overrides the simple forward/aft check above, since a real envelope's limits usually move with weight.</p>
          </div>
        </details>

        <button type="submit" class="btn-outline wb-recompute">Redraw the envelope chart below</button>
      </form>

      <aside class="wb-results">
        <div class="wb-stat-band">
          <div class="wb-stat">
            <div class="col">Total weight</div>
            <div class="wb-stat-value serif num" data-wb-total-weight>{hasAnyInput ? Math.round(result.totalWeightLb).toLocaleString('en-US') : '—'}</div>
            <div class="wb-stat-unit">lb</div>
          </div>
          <div class="wb-stat">
            <div class="col">Total moment</div>
            <div class="wb-stat-value serif num" data-wb-total-moment>{hasAnyInput ? Math.round(result.totalMomentInLb).toLocaleString('en-US') : '—'}</div>
            <div class="wb-stat-unit">lb-in</div>
          </div>
          <div class="wb-stat">
            <div class="col">Center of gravity</div>
            <div class="wb-stat-value serif num" data-wb-cg>{result.cgIn != null ? result.cgIn.toFixed(2) : '—'}</div>
            <div class="wb-stat-unit">in aft of datum</div>
          </div>
        </div>

        <div
          class={`wb-verdict ${overallOk ? 'ok' : 'bad'}`}
          data-wb-verdict
          hidden={!(hasAnyInput && (limits.maxGrossLb != null || cgStatus != null))}
        >
          <span class="wb-verdict-title" data-wb-verdict-title>
            {limits.overGross ? 'Over max gross weight' : cgStatus === false ? 'CG outside limits' : 'Within limits'}
          </span>
          <span class="wb-verdict-detail" data-wb-verdict-detail>
            {limits.overGross && limits.maxGrossLb != null && `${Math.round(result.totalWeightLb - limits.maxGrossLb).toLocaleString('en-US')} lb over ${limits.maxGrossLb.toLocaleString('en-US')} lb max gross. `}
            {cgStatus === false && 'The computed CG falls outside the limits entered.'}
            {overallOk && cgStatus != null && 'Weight and CG both fall inside what was entered.'}
            {overallOk && cgStatus == null && limits.maxGrossLb != null && 'At or under max gross weight; no CG limits were entered to check against.'}
          </span>
        </div>

        {showPlot && (
          <div class="wb-plot-wrap">
            <div class="col">CG envelope</div>
            <svg
              viewBox={`0 0 ${PLOT_W} ${PLOT_H}`}
              class="wb-plot"
              role="img"
              aria-label="Weight versus center of gravity, with the envelope and the computed point"
              data-wb-plot-bounds={JSON.stringify({ padL: PAD_L, padR: PAD_R, padT: PAD_T, padB: PAD_B, w: PLOT_W, h: PLOT_H, armLo, armHi, weightHi })}
            >
              <line x1={PAD_L} y1={PAD_T} x2={PAD_L} y2={PLOT_H - PAD_B} class="wb-axis" />
              <line x1={PAD_L} y1={PLOT_H - PAD_B} x2={PLOT_W - PAD_R} y2={PLOT_H - PAD_B} class="wb-axis" />
              <text x={PAD_L - 6} y={PAD_T + 4} class="wb-axis-label" text-anchor="end">{Math.round(weightHi).toLocaleString('en-US')}</text>
              <text x={PAD_L - 6} y={PLOT_H - PAD_B} class="wb-axis-label" text-anchor="end">0</text>
              <text x={PAD_L} y={PLOT_H - 8} class="wb-axis-label" text-anchor="start">{armLo.toFixed(1)}"</text>
              <text x={PLOT_W - PAD_R} y={PLOT_H - 8} class="wb-axis-label" text-anchor="end">{armHi.toFixed(1)}"</text>

              {envelope.length >= 3 && <polygon points={envelopePolyPoints} class="wb-envelope-poly" data-wb-envelope-poly />}

              {envelope.length < 3 && fwdLimitIn != null && aftLimitIn != null && (
                <rect
                  x={plotX(fwdLimitIn)}
                  y={PAD_T}
                  width={Math.max(1, plotX(aftLimitIn) - plotX(fwdLimitIn))}
                  height={PLOT_H - PAD_T - PAD_B}
                  class="wb-envelope-poly"
                  data-wb-simple-band
                />
              )}

              {maxGrossLb != null && (
                <line x1={PAD_L} y1={plotY(maxGrossLb)} x2={PLOT_W - PAD_R} y2={plotY(maxGrossLb)} class="wb-gross-line" data-wb-gross-line />
              )}

              {result.cgIn != null && (
                <circle
                  cx={plotX(result.cgIn)}
                  cy={plotY(result.totalWeightLb)}
                  r="5"
                  class={overallOk ? 'wb-point ok' : 'wb-point bad'}
                  data-wb-point
                />
              )}
            </svg>
          </div>
        )}
      </aside>
    </section>

    <section class="wb-table-section">
      <header class="wb-panel-head">
        <span class="col">Moment breakdown</span>
        <span class="wb-panel-note">Moment = weight × arm, at every station, summed</span>
      </header>
      <table class="wb-table" data-wb-table>
        <thead><tr><th>Item</th><th class="num">Weight (lb)</th><th class="num">Arm (in)</th><th class="num">Moment (lb-in)</th></tr></thead>
        <tbody>
          {result.rows.map((row) => (
            <tr class={row.weightLb == null ? 'is-empty' : ''}>
              <td>{row.name}</td>
              <td class="num">{row.weightLb != null ? row.weightLb.toLocaleString('en-US') : '—'}</td>
              <td class="num">{row.armIn != null ? row.armIn.toFixed(2) : '—'}</td>
              <td class="num">{row.momentInLb != null ? Math.round(row.momentInLb).toLocaleString('en-US') : '—'}</td>
            </tr>
          ))}
          <tr class="wb-table-total">
            <td>Total</td>
            <td class="num" data-wb-table-weight>{hasAnyInput ? Math.round(result.totalWeightLb).toLocaleString('en-US') : '—'}</td>
            <td class="num">CG {result.cgIn != null ? result.cgIn.toFixed(2) : '—'}</td>
            <td class="num" data-wb-table-moment>{hasAnyInput ? Math.round(result.totalMomentInLb).toLocaleString('en-US') : '—'}</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="wb-notes">
      <header class="wb-panel-head"><span class="col">How to read this</span></header>
      <div class="wb-faq">
        <details class="wb-faq-item" open>
          <summary><span>Why no built-in aircraft profiles?</span><span class="wb-faq-icon" aria-hidden="true"></span></summary>
          <p>Empty weight, empty arm, station arms and CG limits are specific to one airframe's equipment and modifications, and the charts that publish them are the manufacturer's. Copying numbers from a POH into a public tool risks someone flying on a figure that no longer matches their aircraft's weight and balance record. You enter your own airplane's numbers; the arithmetic is what this tool owns.</p>
        </details>
        <details class="wb-faq-item">
          <summary><span>What is a moment, exactly?</span><span class="wb-faq-icon" aria-hidden="true"></span></summary>
          <p>Weight times arm — the turning effect that weight has around the datum, the same way torque is force times distance. Add every station's moment, add every station's weight, and the CG is the moment total divided by the weight total: the balance point of the whole loaded aircraft.</p>
        </details>
        <details class="wb-faq-item">
          <summary><span>Simple limits versus a full envelope — which should I use?</span><span class="wb-faq-icon" aria-hidden="true"></span></summary>
          <p>A single forward and aft limit is correct only if your POH's envelope is a plain rectangle — true for some trainers, false for many aircraft where the aft limit moves inward as weight drops. If your POH shows a sloped or multi-sided envelope, trace its corners into the polygon field instead; the simple limits are ignored once a polygon is present.</p>
        </details>
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-container { padding-top: 56px; padding-bottom: 96px; }
  .page-header { max-width: 760px; }
  .page-title { font-size: clamp(34px, 5vw, 54px); line-height: 1.08; margin: 12px 0 0; letter-spacing: -0.01em; }
  .page-lead { margin: 18px 0 0; font-size: 16px; line-height: 1.65; color: var(--text-muted); }

  .wb-layout { margin-top: 44px; border-top: 1px solid var(--border-strong); padding-top: 26px; display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(240px, 1fr); gap: 40px; align-items: start; }

  .wb-block { margin-bottom: 22px; }
  .wb-block-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 10px; }
  .wb-add { background: none; border: 1px solid var(--border); color: var(--fg); font-size: 12px; padding: 5px 10px; cursor: pointer; }
  .wb-add:hover { border-color: var(--border-strong); background: var(--surface-subtle); }
  .wb-add:disabled { opacity: 0.4; cursor: not-allowed; }

  .wb-row { display: grid; grid-template-columns: minmax(0,1.3fr) minmax(0,0.9fr) minmax(0,0.9fr) minmax(0,1fr); gap: 12px; padding: 10px 0; border-top: 1px solid var(--border); align-items: end; }
  .wb-row-fixed { border-top: 1px solid var(--border-strong); }
  .wb-cell { display: flex; flex-direction: column; gap: 5px; position: relative; }
  .wb-cell-label { font-size: 10px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  .wb-static { font-size: 14px; padding: 9px 0; }
  .wb-input { height: 38px; padding: 0 10px; font-size: 14px; font-family: var(--font-sans); color: var(--fg); background: var(--surface-card); border: 1px solid var(--border-input); border-radius: 0; width: 100%; }
  .wb-input:focus { outline: none; border-color: var(--fg); }
  .wb-cell-moment { flex-direction: row; align-items: baseline; gap: 8px; justify-content: space-between; }
  .wb-cell-moment .wb-cell-label { display: none; }
  .wb-moment { font-size: 14px; padding: 9px 0; }
  .wb-remove { background: none; border: none; color: var(--text-muted); font-size: 16px; line-height: 1; cursor: pointer; padding: 4px 6px; }
  .wb-remove:hover { color: var(--danger); }

  .wb-limits { margin-top: 22px; border-top: 1px solid var(--border); padding-top: 14px; }
  .wb-limits summary { cursor: pointer; font-size: 13px; color: var(--text-muted); padding: 4px 0 14px; }
  .wb-limits summary:hover { color: var(--fg); }
  .wb-limits-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .wb-field { display: flex; flex-direction: column; gap: 6px; }
  .wb-input-wrap { position: relative; display: flex; align-items: center; }
  .wb-input-wrap .wb-input { padding-right: 40px; }
  .wb-unit { position: absolute; right: 10px; font-size: 11px; color: var(--text-subtle); }
  .wb-field-envelope { margin-top: 16px; }
  .wb-field-envelope label code { font-size: 10px; }
  .wb-textarea { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12.5px; line-height: 1.6; padding: 10px 12px; border: 1px solid var(--border-input); background: var(--surface-card); color: var(--fg); resize: vertical; }
  .wb-textarea:focus { outline: none; border-color: var(--fg); }
  .wb-help { margin: 6px 0 0; font-size: 11px; color: var(--text-subtle); line-height: 1.5; }
  .wb-recompute { margin-top: 22px; }

  .wb-results { position: sticky; top: 20px; }
  .wb-stat-band { border-top: 1px solid var(--border-strong); border-bottom: 1px solid var(--border); display: grid; gap: 0; }
  .wb-stat { padding: 12px 0; border-bottom: 1px solid var(--border); }
  .wb-stat:last-child { border-bottom: none; }
  .wb-stat-value { font-size: clamp(22px, 2.6vw, 28px); margin-top: 6px; }
  .wb-stat-unit { margin-top: 2px; font-size: 11.5px; color: var(--text-muted); }

  .wb-verdict { margin-top: 16px; padding: 12px 14px; border-left: 3px solid var(--border); background: var(--surface-subtle); }
  .wb-verdict.ok { border-color: var(--success); }
  .wb-verdict.bad { border-color: var(--danger); }
  .wb-verdict-title { display: block; font-size: 13px; font-weight: 600; }
  .wb-verdict.ok .wb-verdict-title { color: var(--success); }
  .wb-verdict.bad .wb-verdict-title { color: var(--danger); }
  .wb-verdict-detail { display: block; margin-top: 4px; font-size: 12px; color: var(--text-muted); line-height: 1.5; }

  .wb-plot-wrap { margin-top: 20px; }
  .wb-plot { width: 100%; display: block; margin-top: 8px; }
  .wb-axis { stroke: var(--border-strong); stroke-width: 1; }
  .wb-axis-label { font-size: 8.5px; fill: var(--text-muted); }
  .wb-envelope-poly { fill: var(--accent-sky); fill-opacity: 0.16; stroke: var(--accent-blue); stroke-width: 1.2; }
  .wb-gross-line { stroke: var(--warning); stroke-width: 1; stroke-dasharray: 3 3; }
  .wb-point { stroke: var(--surface-card); stroke-width: 1.5; }
  .wb-point.ok { fill: var(--success); }
  .wb-point.bad { fill: var(--danger); }

  .wb-table-section { margin-top: 52px; border-top: 1px solid var(--border); padding-top: 26px; }
  .wb-panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-bottom: 12px; border-bottom: 1px solid var(--border); margin-bottom: 4px; }
  .wb-panel-note { font-size: 11.5px; color: var(--text-subtle); }
  .wb-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .wb-table th, .wb-table td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--border); }
  .wb-table th.num, .wb-table td.num { text-align: right; }
  .wb-table th { font-size: 10.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
  .wb-table tr.is-empty { color: var(--text-subtle); }
  .wb-table-total { font-weight: 600; border-top: 1px solid var(--border-strong); }

  .wb-notes { margin-top: 52px; border-top: 1px solid var(--border); padding-top: 26px; }
  .wb-faq { max-width: 720px; }
  .wb-faq-item { border-top: 1px solid var(--border); }
  .wb-faq-item summary { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; padding: 14px 0; font-size: 14px; }
  .wb-faq-item summary::-webkit-details-marker { display: none; }
  .wb-faq-icon { width: 14px; height: 14px; position: relative; flex-shrink: 0; }
  .wb-faq-icon::before, .wb-faq-icon::after { content: ''; position: absolute; background: var(--text-muted); top: 50%; left: 50%; transform: translate(-50%, -50%); }
  .wb-faq-icon::before { width: 10px; height: 1.4px; }
  .wb-faq-icon::after { width: 1.4px; height: 10px; transition: transform var(--dur-fast) var(--ease-out); }
  .wb-faq-item[open] .wb-faq-icon::after { transform: translate(-50%, -50%) scaleY(0); }
  .wb-faq-item p { margin: 0 0 16px; font-size: 13px; line-height: 1.65; color: var(--text-muted); }

  @media (max-width: 900px) {
    .wb-layout { grid-template-columns: 1fr; }
    .wb-results { position: static; }
    .wb-row { grid-template-columns: 1fr 1fr; }
    .wb-limits-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { computeWeightBalance, checkLimits, parseEnvelope } from '../../lib/weight-balance';

  function setup() {
    const form = document.getElementById('wb-form') as HTMLFormElement | null;
    if (!form) return;

    const addBtn = document.getElementById('wb-add-station') as HTMLButtonElement | null;
    const rows = Array.from(form.querySelectorAll<HTMLElement>('[data-wb-station]'));

    function visibleCount(): number {
      return rows.filter((r) => !r.hasAttribute('hidden')).length;
    }
    function syncAddButton() {
      if (addBtn) addBtn.disabled = visibleCount() >= rows.length;
    }

    addBtn?.addEventListener('click', () => {
      const next = rows.find((r) => r.hasAttribute('hidden'));
      if (next) {
        next.removeAttribute('hidden');
        syncAddButton();
        render();
      }
    });

    rows.forEach((row) => {
      const removeBtn = row.querySelector<HTMLButtonElement>('[data-wb-remove]');
      removeBtn?.addEventListener('click', () => {
        row.querySelectorAll('input, textarea').forEach((el) => ((el as HTMLInputElement).value = ''));
        row.setAttribute('hidden', '');
        syncAddButton();
        render();
      });
    });
    syncAddButton();

    function num(name: string): number | null {
      const el = form!.elements.namedItem(name) as HTMLInputElement | null;
      if (!el || el.value.trim() === '') return null;
      const n = Number(el.value);
      return Number.isFinite(n) ? n : null;
    }
    function str(name: string): string {
      const el = form!.elements.namedItem(name) as HTMLInputElement | null;
      return el?.value.trim() || '';
    }

    function render() {
      const emptyWeightLb = num('ew');
      const emptyArmIn = num('ea');
      const stations = rows.map((row) => {
        const n = row.dataset.wbStation;
        return {
          name: str(`s${n}n`) || `Station ${n}`,
          weightLb: num(`s${n}w`),
          armIn: num(`s${n}a`),
        };
      });

      const result = computeWeightBalance({ emptyWeightLb, emptyArmIn, stations });
      const hasAnyInput = emptyWeightLb != null || emptyArmIn != null || stations.some((s) => s.weightLb != null);

      const totalWeightEl = document.querySelector<HTMLElement>('[data-wb-total-weight]');
      const totalMomentEl = document.querySelector<HTMLElement>('[data-wb-total-moment]');
      const cgEl = document.querySelector<HTMLElement>('[data-wb-cg]');
      if (totalWeightEl) totalWeightEl.textContent = hasAnyInput ? Math.round(result.totalWeightLb).toLocaleString('en-US') : '—';
      if (totalMomentEl) totalMomentEl.textContent = hasAnyInput ? Math.round(result.totalMomentInLb).toLocaleString('en-US') : '—';
      if (cgEl) cgEl.textContent = result.cgIn != null ? result.cgIn.toFixed(2) : '—';

      result.rows.forEach((row, i) => {
        const momentEl = document.querySelector<HTMLElement>(`[data-wb-moment="${i}"]`);
        if (momentEl) momentEl.textContent = row.momentInLb != null ? Math.round(row.momentInLb).toLocaleString('en-US') : '—';
      });

      const tableWeight = document.querySelector<HTMLElement>('[data-wb-table-weight]');
      const tableMoment = document.querySelector<HTMLElement>('[data-wb-table-moment]');
      if (tableWeight) tableWeight.textContent = hasAnyInput ? Math.round(result.totalWeightLb).toLocaleString('en-US') : '—';
      if (tableMoment) tableMoment.textContent = hasAnyInput ? Math.round(result.totalMomentInLb).toLocaleString('en-US') : '—';

      const maxGrossLb = num('mg');
      const fwdLimitIn = num('fl');
      const aftLimitIn = num('al');
      const envelope = parseEnvelope(str('env'));
      const limits = checkLimits(result.totalWeightLb, result.cgIn, { maxGrossLb, fwdLimitIn, aftLimitIn, envelope });
      const cgStatus = limits.withinEnvelope != null ? limits.withinEnvelope : limits.withinSimpleLimits;
      const overallOk = cgStatus !== false && !limits.overGross;

      const verdict = document.querySelector<HTMLElement>('[data-wb-verdict]');
      const verdictTitle = document.querySelector<HTMLElement>('[data-wb-verdict-title]');
      const verdictDetail = document.querySelector<HTMLElement>('[data-wb-verdict-detail]');
      if (verdict && (maxGrossLb != null || cgStatus != null)) {
        verdict.hidden = false;
        verdict.classList.toggle('ok', overallOk);
        verdict.classList.toggle('bad', !overallOk);
        if (verdictTitle) {
          verdictTitle.textContent = limits.overGross ? 'Over max gross weight' : cgStatus === false ? 'CG outside limits' : 'Within limits';
        }
        if (verdictDetail) {
          const parts: string[] = [];
          if (limits.overGross && maxGrossLb != null) parts.push(`${Math.round(result.totalWeightLb - maxGrossLb).toLocaleString('en-US')} lb over ${maxGrossLb.toLocaleString('en-US')} lb max gross.`);
          if (cgStatus === false) parts.push('The computed CG falls outside the limits entered.');
          if (overallOk && cgStatus != null) parts.push('Weight and CG both fall inside what was entered.');
          verdictDetail.textContent = parts.join(' ');
        }
      } else if (verdict) {
        verdict.hidden = true;
      }

      const point = document.querySelector<SVGCircleElement>('[data-wb-point]');
      const plot = document.querySelector<SVGSVGElement>('[data-wb-plot-bounds]');
      if (point && plot && result.cgIn != null) {
        const bounds = JSON.parse(plot.dataset.wbPlotBounds || '{}');
        const x = bounds.padL + ((result.cgIn - bounds.armLo) / (bounds.armHi - bounds.armLo || 1)) * (bounds.w - bounds.padL - bounds.padR);
        const y = bounds.h - bounds.padB - (result.totalWeightLb / (bounds.weightHi || 1)) * (bounds.h - bounds.padT - bounds.padB);
        point.setAttribute('cx', String(x));
        point.setAttribute('cy', String(y));
        point.setAttribute('class', overallOk ? 'wb-point ok' : 'wb-point bad');
        point.removeAttribute('hidden');
      } else if (point) {
        point.setAttribute('hidden', '');
      }
    }

    form.querySelectorAll('input, textarea').forEach((el) => el.addEventListener('input', render));
  }

  setup();
  document.addEventListener('astro:after-swap', setup);
</script>
