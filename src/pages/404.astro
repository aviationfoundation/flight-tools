---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found · Flight tools"
  description="The requested page could not be found."
  currentPath="/404"
>
  <div class="lo-404 container-site px-site">
    <div class="lo-card">
      <div class="lo-eyebrow">404</div>
      <h1 class="serif lo-heading">Page not found</h1>
      <p class="lo-desc">
        The tool or lesson you requested could not be found. Check the address or choose one of the links below.
      </p>
      <div class="lo-links">
        <a href="/tools" class="btn-solid">Flight tools</a>
        <a href="/learn" class="btn-outline">NOTAM course</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .lo-404 {
    padding: clamp(56px, 10vw, 110px) 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .lo-card {
    background: var(--surface-card);
    border: 1px solid var(--border);
    padding: clamp(32px, 5vw, 48px);
    max-width: 520px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: center;
    align-items: center;
    border-radius: 4px;
  }

  .lo-eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .lo-heading {
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 600;
    margin: 0;
    color: var(--fg);
    font-family: var(--font-serif);
  }

  .lo-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0 0 8px 0;
  }

  .lo-links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-solid {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    border-radius: 3px;
  }

  .btn-solid:hover {
    opacity: 0.9;
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--border-strong);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    border-radius: 3px;
  }

  .btn-outline:hover {
    background: var(--surface-subtle);
  }
</style>
