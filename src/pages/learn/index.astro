---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { COURSES, totalMinutes } from '../../lib/learn/courses';
import { getAccount, getProgress } from '../../lib/accounts';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const state = await getAccount(Astro.request);
const progress = await Promise.all(
  COURSES.map(async (course) => {
    if (state.status !== 'signed-in') return 0;
    const rows = (await getProgress(state.token, course.id)) ?? [];
    const ids = new Set(course.lessons.map((lesson) => lesson.id));
    return rows.filter((row) => ids.has(row.lesson)).length;
  }),
);

// COURSES keeps its order for old links and saved scores. The page lists by who a course is for.
const groups = [
  { title: 'Before you start training', note: 'For students deciding whether and how to get into aviation, and for the parents and counsellors helping them. Open to everyone, no account needed.', audience: 'starting' },
  { title: 'For student and private pilots', note: 'Free with an aviation.foundation account, which saves your progress.', audience: 'pilots' },
] as const;
---

<Layout
  title="Courses · aviation.foundation flight tools"
  description="Free short courses from aviation.foundation: getting into aviation from a Canadian high school, reading NOTAMs, and reading METARs and TAFs."
  currentPath="/learn"
>
  <div class="lc container-site px-site">
    <header class="lc-header">
      <h1 class="lc-title">Courses</h1>
      <p class="lc-lead">
        Short lessons, each ending with practice questions. Every course is free, and finishing one earns a
        certificate of completion.
      </p>
    </header>

    {groups.map((group) => (
      <section class="lc-group" aria-labelledby={`lc-${group.audience}`}>
        <h2 class="lc-group-title" id={`lc-${group.audience}`}>{group.title}</h2>
        <p class="lc-group-note">{group.note}</p>
        <ol class="lc-list">
          {COURSES.map((course, i) => {
            if (course.audience !== group.audience) return null;
            const finished = progress[i];
            const count = course.lessons.length;
            return (
              <li>
                <a href={`/learn/${course.slug}`} class={finished === count ? 'is-done' : ''}>
                  <span class="lc-body">
                    <span class="lc-name">{course.title}</span>
                    <span class="lc-desc">{course.description}</span>
                  </span>
                  <span class="lc-meta num">
                    {state.status === 'signed-in' && finished > 0
                      ? `${finished} of ${count} done`
                      : `${count} lessons, about ${totalMinutes(course)} min`}
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    ))}

    <p class="lc-verify"><a href="/learn/certificate">Check a certificate</a></p>
  </div>
</Layout>

<style>
  .lc { padding-top: 56px; padding-bottom: 40px; }

  .lc-title {
    margin: 0;
    font-family: var(--font-archivo);
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .lc-lead {
    margin: 22px 0 0;
    font-family: var(--font-serif);
    font-size: 21px;
    line-height: 1.55;
    max-width: 34em;
  }

  .lc-group { margin-top: 48px; }

  .lc-group-title {
    margin: 0;
    font-family: var(--font-archivo);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .lc-group-note { margin: 6px 0 0; font-size: 14.5px; line-height: 1.5; color: var(--text-muted); max-width: 66ch; }

  .lc-list {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    border-top: 1px solid var(--border-strong);
  }

  .lc-verify { margin: 32px 0 0; font-size: 14px; }
  .lc-verify a { color: var(--text-muted); }
  .lc-verify a:hover { color: var(--fg); }

  .lc-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: baseline;
    padding: 24px 4px 24px 0;
    border-bottom: 1px solid var(--border);
    color: var(--fg);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .lc-list a:hover { background: var(--surface-subtle); }
  .lc-list a:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }

  .lc-body { display: grid; gap: 6px; }

  .lc-name {
    font-family: var(--font-archivo);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .lc-desc { font-size: 15px; line-height: 1.55; color: var(--text-muted); max-width: 66ch; }

  .lc-meta { font-size: 13px; color: var(--text-muted); white-space: nowrap; }
  .lc-list a.is-done .lc-meta { color: var(--success); font-weight: 600; }

  @media (max-width: 600px) {
    .lc { padding-top: 32px; }
    .lc-list a { grid-template-columns: minmax(0, 1fr); gap: 10px; }
  }
</style>
