---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { normaliseCertificateCode } from '../../../lib/accounts';

Astro.response.headers.set('Cache-Control', 'private, no-store');

// The form below posts here with ?code=. A code in the right shape goes to its own page;
// anything else comes back with a note about what a code looks like.
const typed = (Astro.url.searchParams.get('code') ?? '').slice(0, 40);
const code = typed ? normaliseCertificateCode(typed) : null;
if (code) return Astro.redirect(`/learn/certificate/${code}`, 303);
---

<Layout
  title="Check a certificate · aviation.foundation courses"
  description="Confirm that a certificate of completion from an aviation.foundation course is real, using the code printed on it."
  currentPath="/learn"
>
  <div class="cv container-site px-site">
    <p class="cv-back"><a href="/learn">All courses</a></p>
    <h1 class="cv-title">Check a certificate</h1>
    <p class="cv-lead">
      Every certificate from an aviation.foundation course carries a 12-character code. Type it here to see who
      it was issued to, for which course, and when.
    </p>

    <form method="get" action="/learn/certificate" class="cv-form">
      <label for="cv-code">Certificate code</label>
      <div class="cv-row">
        <input id="cv-code" name="code" class="num" type="text" required maxlength="20" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="XXXX-XXXX-XXXX" value={typed} aria-describedby={typed ? 'cv-error' : undefined} />
        <button type="submit" class="btn-solid">Check</button>
      </div>
      {typed && (
        <p class="cv-error" id="cv-error" role="alert">
          That isn't a certificate code. A code has 12 letters and digits, printed in three groups of four. It never
          contains 0, 1, I, L, O or U.
        </p>
      )}
    </form>
  </div>
</Layout>

<style>
  .cv { padding-top: 56px; padding-bottom: 40px; }

  .cv-back { margin: 0 0 14px; font-size: 14px; }
  .cv-back a { color: var(--text-muted); }
  .cv-back a:hover { color: var(--fg); }

  .cv-title {
    margin: 0;
    font-family: var(--font-archivo);
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .cv-lead {
    margin: 20px 0 0;
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.55;
    max-width: 34em;
  }

  .cv-form {
    display: grid;
    gap: 8px;
    max-width: 460px;
    margin-top: 32px;
    padding: 24px;
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-top: 3px solid var(--fg);
  }

  .cv-form label { font-size: 13.5px; font-weight: 600; }
  .cv-row { display: flex; gap: 8px; }

  .cv-row input {
    flex: 1;
    min-width: 0;
    padding: 11px 12px;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--border-input);
    border-radius: 0;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 17px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cv-row input::placeholder { letter-spacing: 0.04em; }
  .cv-row input:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }

  .cv-error { margin: 4px 0 0; font-size: 14px; line-height: 1.5; color: var(--danger); }
</style>
