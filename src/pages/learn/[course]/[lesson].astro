---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import NotamFigure from '../../../components/learn/NotamFigure.astro';
import Check from '../../../components/learn/Check.astro';
import Triage from '../../../components/learn/Triage.astro';
import Timeline from '../../../components/learn/Timeline.astro';
import LessonRail from '../../../components/learn/LessonRail.astro';
import Route from '../../../components/learn/Route.astro';
import Links from '../../../components/learn/Links.astro';
import SignInGate from '../../../components/learn/SignInGate.astro';
import { courseBySlug, lessonIn } from '../../../lib/learn/courses';
import { checkCount } from '../../../lib/learn/types';
import { getAccount, getProgress, signInUrl, type LessonProgress } from '../../../lib/accounts';

const course = courseBySlug(Astro.params.course ?? '');
if (!course) return Astro.rewrite('/404');
const LESSONS = course.lessons;
const base = `/learn/${course.slug}`;

Astro.response.headers.set('Cache-Control', 'private, no-store');

const lesson = lessonIn(course, Astro.params.lesson ?? '');
if (!lesson) Astro.response.status = 404;

const state = lesson ? await getAccount(Astro.request) : { status: 'signed-out' as const };
const signedIn = state.status === 'signed-in';
// An open course can be taken without an account, and when accounts can't be reached.
const canTake = signedIn || course.open === true;
const progress: LessonProgress[] = state.status === 'signed-in' ? (await getProgress(state.token, course.id)) ?? [] : [];
const index = lesson ? LESSONS.indexOf(lesson) : -1;
const previous = index > 0 ? LESSONS[index - 1] : null;
const next = index >= 0 && index < LESSONS.length - 1 ? LESSONS[index + 1] : null;
const total = lesson ? checkCount(lesson) : 0;
const done = lesson ? progress.find((p) => p.lesson === lesson.id) : undefined;

let checkNumber = 0;
const numbered = (lesson?.blocks ?? []).map((block, position) => {
  if (block.kind === 'choice' || block.kind === 'answer' || block.kind === 'pick') checkNumber += 1;
  return { block, number: checkNumber, position };
});
---

<Layout
  title={lesson ? `${lesson.title} · ${course.title}` : `Lesson not found · ${course.title}`}
  description={lesson ? lesson.summary : 'This lesson does not exist.'}
  currentPath="/learn"
>
  {!lesson ? (
    <div class="lp-missing container-site px-site">
      <h1 class="lp-title">There's no lesson at this address</h1>
      <p class="lp-summary"><a href={base}>See all the lessons</a>.</p>
    </div>
  ) : (
    <div class="lp container-site px-site">
      <LessonRail course={course} current={lesson.id} progress={progress} />

      <article
        class="lp-main"
        data-course={course.id}
        data-lesson={lesson.id}
        data-total={total}
        data-active={canTake ? '1' : undefined}
        data-signed-in={signedIn ? '1' : undefined}
      >
        <p class="lp-position">Lesson {index + 1} of {LESSONS.length}, about {lesson.minutes} minutes</p>
        <h1 class="lp-title">{lesson.title}</h1>
        <p class="lp-summary">{lesson.summary}</p>

        {!canTake ? (
          <SignInGate status={state.status === 'unavailable' ? 'unavailable' : 'signed-out'} returnTo={Astro.url.href} />
        ) : (
          <>
            {!signedIn && (
              <p class="lp-open">
                {state.status === 'unavailable'
                  ? 'Accounts can\'t be reached right now. You can still take the lesson, and your score is kept on this device.'
                  : <>No account needed. <a href={signInUrl(Astro.url.href)}>Sign in</a> or <a href={signInUrl(Astro.url.href, true)}>create a free account</a> to save your scores and get the certificate.</>}
              </p>
            )}

            {done && (
              <p class="lp-before">
                You finished this lesson before, with {done.correct} of {done.total} right first time. Going through it again keeps your best score.
              </p>
            )}

            <div class="lp-body">
              {numbered.map(({ block, number, position }) =>
                block.kind === 'p' ? (
                  <p class="lp-p">{block.text}</p>
                ) : block.kind === 'notice' ? (
                  <aside class="lp-notice">
                    {block.title && <p class="lp-notice-title">{block.title}</p>}
                    <p class="lp-notice-text">{block.text}</p>
                  </aside>
                ) : block.kind === 'notam' || block.kind === 'report' ? (
                  <NotamFigure raw={block.raw} marks={block.marks} caption={block.caption} id={`${lesson.id}-f${position}`} />
                ) : block.kind === 'table' ? (
                  <div class="lp-table-wrap">
                    <table class={`lp-table${block.prose ? ' is-prose' : ''}`}>
                      <thead><tr>{block.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr>{row.map((cell, i) => (i === 0 ? <th scope="row" class="num">{cell}</th> : <td>{cell}</td>))}</tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ) : block.kind === 'rule' ? (
                  <aside class="lp-rule">
                    <p class="lp-rule-title">{block.title}</p>
                    <p class="lp-rule-text">{block.text}</p>
                  </aside>
                ) : block.kind === 'timeline' ? (
                  <Timeline caption={block.caption} window={block.window} offsetHours={block.offsetHours} localLabel={block.localLabel} />
                ) : block.kind === 'triage' ? (
                  <Triage block={block} />
                ) : block.kind === 'route' ? (
                  <Route stops={block.stops} caption={block.caption} />
                ) : block.kind === 'links' ? (
                  <Links title={block.title} items={block.items} />
                ) : (
                  <Check check={block} number={number} />
                ),
              )}
            </div>

            <noscript>
              <p class="lp-noscript">The checks in this lesson need JavaScript to mark your answers.</p>
            </noscript>

            <section class="lp-done" data-done hidden aria-live="polite">
              <p class="lp-done-title">Lesson complete</p>
              <p class="lp-done-score" data-score></p>
              <p class="lp-done-save" data-save></p>
              <p class="lp-done-save" data-keep hidden>
                <a href={signInUrl(new URL(base, Astro.url).href, true)}>Create a free account</a> or <a href={signInUrl(new URL(base, Astro.url).href)}>sign in</a> to keep your scores and get the certificate.
              </p>
              <div class="lp-done-actions">
                {next ? (
                  <a class="btn-solid" href={`${base}/${next.id}`}>Next: {next.title}</a>
                ) : (
                  <a class="btn-solid" href={`${base}/certificate`}>Get your certificate</a>
                )}
                {!next && <a class="btn-outline" href={course.tool.href}>{course.tool.label}</a>}
                <a class="btn-outline" href={base}>All lessons</a>
              </div>
            </section>
          </>
        )}

        <nav class="lp-pager" aria-label="Lessons">
          {previous ? <a href={`${base}/${previous.id}`} rel="prev"><span>Previous</span>{previous.title}</a> : <span></span>}
          {next && <a href={`${base}/${next.id}`} rel="next" class="lp-pager-next"><span>Next</span>{next.title}</a>}
        </nav>
      </article>
    </div>
  )}
</Layout>

<style>
  .lp {
    display: grid;
    grid-template-columns: 240px minmax(0, 700px);
    gap: 64px;
    padding-top: 48px;
    padding-bottom: 40px;
    align-items: start;
  }

  .lp-missing { padding-top: 64px; padding-bottom: 40px; }

  .lp-position {
    margin: 0;
    font-size: 13px;
    color: var(--text-muted);
  }

  .lp-title {
    margin: 8px 0 0;
    font-family: var(--font-archivo);
    font-size: clamp(32px, 4.4vw, 48px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.015em;
  }

  .lp-summary {
    margin: 14px 0 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 56ch;
  }

  .lp-before {
    margin: 24px 0 0;
    padding: 10px 14px;
    background: var(--success-bg);
    border-left: 3px solid var(--success);
    font-size: 14px;
  }

  .lp-open {
    margin: 24px 0 0;
    padding: 10px 14px;
    background: var(--surface-subtle);
    border-left: 3px solid var(--accent-blue);
    font-size: 14px;
    line-height: 1.5;
  }

  .lp-open a { color: var(--accent-blue); font-weight: 600; }

  .lp-body { margin-top: 32px; }

  .lp-p {
    margin: 0 0 18px;
    font-family: var(--font-serif);
    font-size: 18.5px;
    line-height: 1.7;
    max-width: 66ch;
  }

  .lp-table-wrap { margin: 24px 0 28px; overflow-x: auto; }

  .lp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
    line-height: 1.45;
  }

  .lp-table th, .lp-table td {
    text-align: left;
    vertical-align: top;
    padding: 9px 14px 9px 0;
    border-bottom: 1px solid var(--border);
  }

  .lp-table thead th {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    border-bottom-color: var(--border-strong);
  }

  .lp-table tbody th {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 13.5px;
    font-weight: 600;
    white-space: nowrap;
  }

  .lp-table.is-prose tbody th {
    font-family: var(--font-sans);
    font-size: 14.5px;
    white-space: normal;
    min-width: 8.5em;
  }

  .lp-notice {
    margin: 26px 0 28px;
    padding: 16px 20px;
    background: var(--warning-bg);
    border: 1px solid var(--warning-border);
    border-left: 4px solid var(--warning);
    border-radius: 2px;
  }

  .lp-notice-title {
    margin: 0 0 4px;
    font-family: var(--font-archivo);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--warning);
  }

  .lp-notice-text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.6;
    color: var(--fg);
  }

  .lp-rule {
    margin: 32px 0;
    padding: 18px 0 18px 22px;
    border-left: 4px solid var(--accent-blue);
  }

  .lp-rule-title {
    margin: 0 0 6px;
    font-family: var(--font-archivo);
    font-size: 19px;
    font-weight: 700;
  }

  .lp-rule-text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 17.5px;
    line-height: 1.65;
  }

  .lp-noscript { font-size: 14px; color: var(--warning); }

  .lp-done {
    margin: 40px 0 0;
    padding: 24px;
    background: var(--fg);
    color: var(--bg);
  }

  .lp-done-title {
    margin: 0;
    font-family: var(--font-archivo);
    font-size: 26px;
    font-weight: 700;
  }

  .lp-done-score { margin: 8px 0 0; font-size: 16px; }
  .lp-done-save { margin: 4px 0 0; font-size: 13.5px; opacity: 0.8; }
  .lp-done-save a { color: inherit; font-weight: 600; }
  .lp-done-save[data-keep] { opacity: 1; }

  .lp-done-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }
  .lp-done .btn-solid { background: var(--bg); color: var(--fg); }
  .lp-done .btn-outline { color: var(--bg); border-color: color-mix(in srgb, var(--bg) 45%, transparent); }
  .lp-done .btn-outline:hover { background: transparent; border-color: var(--bg); color: var(--bg); }

  .lp-pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .lp-pager a {
    display: grid;
    gap: 2px;
    color: var(--fg);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
  }

  .lp-pager a span { font-size: 12px; font-weight: 500; color: var(--text-muted); }
  .lp-pager a:hover { text-decoration: underline; }
  .lp-pager-next { text-align: right; }

  @media (max-width: 960px) {
    .lp { grid-template-columns: minmax(0, 1fr); gap: 0; padding-top: 24px; }
  }

  @media (max-width: 600px) {
    .lp-p { font-size: 17px; }
  }
</style>

<script>
  import { normaliseAnswer } from '../../../lib/learn/answer';
  import { keepPending, pendingFor, sendPending } from '../../../lib/learn/pending';

  const root = document.querySelector<HTMLElement>('[data-lesson][data-active]');
  if (root) setup(root);

  function setup(article: HTMLElement) {
    const course = article.dataset.course!;
    const lesson = article.dataset.lesson!;
    const total = Number(article.dataset.total);
    const signedIn = article.dataset.signedIn === '1';
    const outcome = new Map<string, boolean>();

    const markRail = (id: string) => document.querySelector(`[data-rail-lesson="${id}"]`)?.classList.add('is-done');
    const notSaved = 'This score couldn\'t be saved just now. It is kept on this device and will be sent the next time you open the course signed in.';

    // Lessons finished in this browser without an account show as done, and are sent to the
    // account as soon as a signed-in page loads.
    if (signedIn) sendPending(course).then((saved) => saved.forEach(markRail));
    else Object.keys(pendingFor(course)).forEach(markRail);

    function record(key: string, right: boolean) {
      if (!outcome.has(key)) outcome.set(key, right);
    }

    let finished = false;
    function maybeFinish() {
      if (finished) return;
      const checks = article.querySelectorAll('[data-check]');
      const allDone = [...checks].every((c) => c.classList.contains('is-done'));
      if (!allDone) return;
      finished = true;
      const correct = [...outcome.values()].filter(Boolean).length;
      const panel = article.querySelector<HTMLElement>('[data-done]')!;
      panel.querySelector('[data-score]')!.textContent = `You got ${correct} of ${total} right first time.`;
      const save = panel.querySelector<HTMLElement>('[data-save]')!;
      panel.hidden = false;
      if (!signedIn) {
        keepPending(course, lesson, { correct, total });
        save.textContent = 'Kept on this device.';
        panel.querySelector<HTMLElement>('[data-keep]')!.hidden = false;
        markRail(lesson);
        save.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
        return;
      }
      save.textContent = 'Saving to your account…';
      save.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
      fetch('/api/learn/progress', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ course, lesson, correct }),
      })
        .then(async (response) => {
          if (response.ok) {
            save.textContent = 'Saved to your account.';
            markRail(lesson);
            return;
          }
          keepPending(course, lesson, { correct, total });
          save.textContent = response.status === 401
            ? 'Your sign-in has expired. This score is kept on this device and will be sent when you sign in again and open the course.'
            : notSaved;
        })
        .catch(() => {
          keepPending(course, lesson, { correct, total });
          save.textContent = notSaved;
        });
    }

    function verdict(check: HTMLElement, right: boolean, text: string) {
      const node = check.querySelector<HTMLElement>('.ck-verdict')!;
      node.textContent = text;
      node.classList.toggle('is-right', right);
      node.classList.toggle('is-wrong', !right);
      node.hidden = false;
    }

    function showWhy(check: HTMLElement, key: string) {
      check.querySelectorAll<HTMLElement>('[data-why]').forEach((p) => {
        p.hidden = p.dataset.why !== key;
      });
    }

    article.querySelectorAll<HTMLElement>('[data-kind="choice"], [data-kind="pick"]').forEach((check) => {
      const id = check.dataset.check!;
      const buttons = [...check.querySelectorAll<HTMLButtonElement>('[data-option]')];
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          if (check.classList.contains('is-done')) return;
          const right = button.dataset.correct === '1';
          record(id, right);
          button.classList.add(right ? 'is-right' : 'is-wrong');
          button.disabled = true;
          if (check.dataset.kind === 'choice') showWhy(check, button.dataset.option!);
          else showWhy(check, 'answer');
          if (right) {
            verdict(check, true, outcome.get(id) ? 'Right.' : 'That\'s it.');
            check.classList.add('is-done', 'is-right');
            buttons.forEach((b) => (b.disabled = true));
            maybeFinish();
          } else {
            verdict(check, false, 'Not this one. Try another.');
            if (check.dataset.kind === 'pick') check.querySelectorAll<HTMLElement>('[data-why]').forEach((p) => (p.hidden = true));
          }
        });
      });
    });

    article.querySelectorAll<HTMLElement>('[data-kind="answer"]').forEach((check) => {
      const id = check.dataset.check!;
      const form = check.querySelector<HTMLFormElement>('form')!;
      const input = form.querySelector<HTMLInputElement>('input')!;
      const accept: string[] = JSON.parse(form.dataset.accept ?? '[]');
      let misses = 0;
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (check.classList.contains('is-done') || !input.value.trim()) return;
        const right = accept.some((a) => normaliseAnswer(a) === normaliseAnswer(input.value));
        record(id, right);
        input.classList.toggle('is-right', right);
        input.classList.toggle('is-wrong', !right);
        if (right) {
          verdict(check, true, outcome.get(id) ? 'Right.' : 'That\'s it.');
          showWhy(check, 'answer');
        } else {
          misses += 1;
          if (misses < 2) {
            verdict(check, false, 'Not quite. Try again.');
            return;
          }
          verdict(check, false, `The answer is ${accept[0]}.`);
          showWhy(check, 'answer');
        }
        input.readOnly = true;
        form.querySelector<HTMLButtonElement>('button')!.disabled = true;
        check.classList.add('is-done');
        if (right) check.classList.add('is-right');
        maybeFinish();
      });
    });

    article.querySelectorAll<HTMLElement>('[data-kind="triage"]').forEach((check) => {
      const id = check.dataset.check!;
      const items = [...check.querySelectorAll<HTMLElement>('[data-item]')];
      const submit = check.querySelector<HTMLButtonElement>('.tr-submit')!;
      const status = check.querySelector<HTMLElement>('.tr-status')!;
      const chosen = new Map<number, string>();
      items.forEach((item) => {
        const index = Number(item.dataset.item);
        const buttons = [...item.querySelectorAll<HTMLButtonElement>('[data-answer]')];
        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            if (check.classList.contains('is-done')) return;
            buttons.forEach((b) => b.setAttribute('aria-checked', String(b === button)));
            chosen.set(index, button.dataset.answer!);
            const left = items.length - chosen.size;
            submit.disabled = left > 0;
            status.textContent = left > 0 ? `${left} still to decide.` : 'Ready when you are.';
          });
        });
      });
      submit.addEventListener('click', () => {
        if (chosen.size < items.length || check.classList.contains('is-done')) return;
        let right = 0;
        items.forEach((item) => {
          const index = Number(item.dataset.item);
          const ok = chosen.get(index) === item.dataset.affects;
          if (ok) right += 1;
          record(`${id}#${index}`, ok);
          item.classList.add(ok ? 'is-right' : 'is-wrong');
          item.querySelector<HTMLElement>('.tr-verdict')!.textContent = `${ok ? 'Right.' : 'Not quite.'} ${item.dataset.affects === '1' ? check.dataset.verdictYes : check.dataset.verdictNo}`;
          item.querySelector<HTMLElement>('.tr-why')!.hidden = false;
          item.querySelectorAll<HTMLButtonElement>('[data-answer]').forEach((b) => (b.disabled = true));
        });
        submit.disabled = true;
        status.textContent = `${right} of ${items.length} right. Read the notes under the ones you missed.`;
        const debrief = check.querySelector<HTMLElement>('.tr-debrief');
        if (debrief) debrief.hidden = false;
        check.classList.add('is-done');
        maybeFinish();
      });
    });

    article.querySelectorAll<HTMLElement>('[data-tr-map]').forEach((el) => {
      const draw = async () => {
        const data = JSON.parse(el.dataset.trMap!) as {
          route: Array<[number, number]>;
          places: Array<{ label: string; lat: number; lon: number }>;
          areas: Array<{ label: string; lat: number; lon: number; radiusNm: number }>;
        };
        const { createMap, cssColor } = await import('../../../lib/map-client');
        const accent = cssColor(document.documentElement, '--accent-blue') || '#00396E';
        const danger = cssColor(document.documentElement, '--danger') || '#B42318';
        const ink = cssColor(document.documentElement, '--fg') || '#111111';
        const circle = (lat: number, lon: number, nm: number) => {
          const ring: Array<[number, number]> = [];
          for (let i = 0; i <= 64; i++) {
            const a = (i / 64) * Math.PI * 2;
            ring.push([lon + (Math.sin(a) * nm) / (60 * Math.cos((lat * Math.PI) / 180)), lat + (Math.cos(a) * nm) / 60]);
          }
          return ring;
        };
        const lons = [...data.places.map((p) => p.lon), ...data.areas.map((a) => a.lon)];
        const lats = [...data.places.map((p) => p.lat), ...data.areas.map((a) => a.lat)];
        try {
          await createMap(el, { bounds: [[Math.min(...lons) - 0.1, Math.min(...lats) - 0.08], [Math.max(...lons) + 0.1, Math.max(...lats) + 0.08]], maxZoom: 10 }, (map) => {
            if (map.getSource('drill-route')) return;
            map.addSource('drill-areas', {
              type: 'geojson',
              data: { type: 'FeatureCollection', features: data.areas.map((a) => ({ type: 'Feature', properties: { label: a.label }, geometry: { type: 'Polygon', coordinates: [circle(a.lat, a.lon, a.radiusNm)] } })) },
            });
            map.addLayer({ id: 'drill-areas-fill', type: 'fill', source: 'drill-areas', paint: { 'fill-color': danger, 'fill-opacity': 0.16 } });
            map.addLayer({ id: 'drill-areas-line', type: 'line', source: 'drill-areas', paint: { 'line-color': danger, 'line-width': 1.5 } });
            map.addSource('drill-route', { type: 'geojson', data: { type: 'Feature', properties: {}, geometry: { type: 'LineString', coordinates: data.route.map(([lat, lon]) => [lon, lat]) } } });
            map.addLayer({ id: 'drill-route', type: 'line', source: 'drill-route', paint: { 'line-color': accent, 'line-width': 3 } });
            map.addSource('drill-labels', {
              type: 'geojson',
              data: {
                type: 'FeatureCollection',
                features: [
                  ...data.places.map((p) => ({ type: 'Feature' as const, properties: { label: p.label, kind: 'place' }, geometry: { type: 'Point' as const, coordinates: [p.lon, p.lat] } })),
                  ...data.areas.map((a) => ({ type: 'Feature' as const, properties: { label: a.label, kind: 'area' }, geometry: { type: 'Point' as const, coordinates: [a.lon, a.lat] } })),
                ],
              },
            });
            map.addLayer({ id: 'drill-places', type: 'circle', source: 'drill-labels', filter: ['==', ['get', 'kind'], 'place'], paint: { 'circle-radius': 4.5, 'circle-color': ink, 'circle-stroke-width': 2, 'circle-stroke-color': '#FFFFFF' } });
            const halo = cssColor(document.documentElement, '--bg') || '#FFFFFF';
            map.addLayer({
              id: 'drill-place-text',
              type: 'symbol',
              source: 'drill-labels',
              filter: ['==', ['get', 'kind'], 'place'],
              layout: { 'text-field': ['get', 'label'], 'text-size': 12, 'text-offset': [0, 1.1], 'text-anchor': 'top', 'text-font': ['Noto Sans Bold'], 'text-allow-overlap': true },
              paint: { 'text-color': ink, 'text-halo-color': halo, 'text-halo-width': 1.6 },
            });
            map.addLayer({
              id: 'drill-area-text',
              type: 'symbol',
              source: 'drill-labels',
              filter: ['==', ['get', 'kind'], 'area'],
              layout: { 'text-field': ['get', 'label'], 'text-size': 12, 'text-offset': [1.4, -0.9], 'text-anchor': 'left', 'text-font': ['Noto Sans Bold'], 'text-allow-overlap': true },
              paint: { 'text-color': danger, 'text-halo-color': halo, 'text-halo-width': 1.6 },
            });
          });
        } catch {
          el.closest('figure')?.setAttribute('hidden', '');
        }
      };
      if (!('IntersectionObserver' in window)) {
        draw();
        return;
      }
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          observer.disconnect();
          draw();
        }
      }, { rootMargin: '200px' });
      observer.observe(el);
    });

    article.querySelectorAll<HTMLElement>('[data-nf]').forEach((figure) => {
      const light = (index: string | undefined, on: boolean) => {
        if (index === undefined) return;
        figure.querySelectorAll<HTMLElement>(`[data-mark="${index}"]`).forEach((el) => el.classList.toggle('is-lit', on));
      };
      figure.querySelectorAll<HTMLElement>('[data-mark]').forEach((el) => {
        el.addEventListener('mouseenter', () => light(el.dataset.mark, true));
        el.addEventListener('mouseleave', () => light(el.dataset.mark, false));
        el.addEventListener('focus', () => light(el.dataset.mark, true));
        el.addEventListener('blur', () => light(el.dataset.mark, false));
      });
    });
  }
</script>
