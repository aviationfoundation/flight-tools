---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import NotamFigure from '../../../components/learn/NotamFigure.astro';
import Route from '../../../components/learn/Route.astro';
import { COURSES, courseBySlug, lessonIn, totalMinutes } from '../../../lib/learn/courses';
import { getAccount, getProgress, signInUrl, type LessonProgress } from '../../../lib/accounts';

// /learn/<lesson> was the NOTAM course before there was more than one course.
const legacy = COURSES[0];
const slug = Astro.params.course ?? '';
if (!courseBySlug(slug) && lessonIn(legacy, slug)) return Astro.redirect(`/learn/${legacy.slug}/${slug}`, 301);

const course = courseBySlug(slug);
if (!course) return Astro.rewrite('/404');
const LESSONS = course.lessons;

Astro.response.headers.set('Cache-Control', 'private, no-store');

const state = await getAccount(Astro.request);
const progress: LessonProgress[] = state.status === 'signed-in' ? (await getProgress(state.token, course.id)) ?? [] : [];
const done = new Map(progress.map((p) => [p.lesson, p]));
const finished = LESSONS.filter((l) => done.has(l.id)).length;
const nextLesson = LESSONS.find((l) => !done.has(l.id));
const minutes = totalMinutes(course);
const base = `/learn/${course.slug}`;

const showcase = LESSONS[0].blocks.find((b) => b.kind === 'notam' || b.kind === 'report' || b.kind === 'route');
const signedIn = state.status === 'signed-in';
---

<Layout
  title={`${course.title} · a free course from aviation.foundation`}
  description={course.description}
  currentPath="/learn"
>
  <div class="lo container-site px-site" data-course={course.id} data-signed-in={signedIn ? '1' : undefined} data-open={course.open ? '1' : undefined}>
    <header class="lo-hero">
      <div class="lo-intro">
        <p class="lo-back"><a href="/learn">All courses</a></p>
        <h1 class="lo-title">{course.title}</h1>
        <p class="lo-lead">{course.lead}</p>
        <p class="lo-who">{course.who}</p>

        <div class="lo-account">
          {state.status === 'signed-in' ? (
            <>
              <p class="lo-account-line">
                Signed in as <strong>{state.account.name}</strong>. {finished === 0 ? 'No lessons finished yet.' : `${finished} of ${LESSONS.length} lessons finished.`}
              </p>
              {nextLesson ? (
                <a class="btn-solid" href={`${base}/${nextLesson.id}`}>
                  {finished === 0 ? 'Start the first lesson' : `Continue with lesson ${LESSONS.indexOf(nextLesson) + 1}`}
                </a>
              ) : (
                <div class="lo-account-actions">
                  <a class="btn-solid" href={`${base}/certificate`}>Get your certificate</a>
                  <a class="btn-outline" href={course.tool.href}>{course.tool.label}</a>
                  <a class="btn-outline" href={`${base}/${LESSONS[LESSONS.length - 1].id}`}>{course.again}</a>
                </div>
              )}
            </>
          ) : course.open ? (
            <>
              <p class="lo-account-line" data-local-line>
                {state.status === 'unavailable'
                  ? 'Accounts can\'t be reached right now. The lessons still open, and your scores are kept on this device.'
                  : 'Open to everyone, no account needed. A free aviation.foundation account saves your scores and gives you a certificate of completion.'}
              </p>
              <div class="lo-account-actions">
                <a class="btn-solid" href={`${base}/${LESSONS[0].id}`} data-local-start>Start the first lesson</a>
                {state.status !== 'unavailable' && <a class="btn-outline" href={signInUrl(Astro.url.href)}>Sign in</a>}
              </div>
            </>
          ) : state.status === 'unavailable' ? (
            <p class="lo-account-line">Accounts can't be reached right now, so lessons won't open. Try again in a few minutes.</p>
          ) : (
            <>
              <p class="lo-account-line">
                Free with an aviation.foundation account. Your scores are saved to it, so you can stop after any
                lesson and pick up on another device.
              </p>
              <div class="lo-account-actions">
                <a class="btn-solid" href={signInUrl(new URL(`${base}/${LESSONS[0].id}`, Astro.url).href, true)}>Create a free account</a>
                <a class="btn-outline" href={signInUrl(Astro.url.href)}>Sign in</a>
              </div>
            </>
          )}
        </div>
      </div>

      {showcase && (showcase.kind === 'notam' || showcase.kind === 'report') && (
        <div class="lo-showcase">
          <p class="lo-showcase-label">{course.showcaseLabel}</p>
          <NotamFigure raw={showcase.raw} marks={showcase.marks} id="lo-showcase" />
        </div>
      )}
      {showcase && showcase.kind === 'route' && (
        <div class="lo-showcase">
          <p class="lo-showcase-label">{course.showcaseLabel}</p>
          <Route stops={showcase.stops} />
        </div>
      )}
    </header>

    <section class="lo-lessons" aria-labelledby="lo-lessons-title">
      <h2 class="lo-section-title" id="lo-lessons-title">The lessons</h2>
      <ol class="lo-list">
        {LESSONS.map((lesson, i) => {
          const record = done.get(lesson.id);
          return (
            <li class={record ? 'is-done' : ''} data-lesson={lesson.id} data-number={i + 1}>
              <a href={`${base}/${lesson.id}`}>
                <span class="lo-num num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="lo-body">
                  <span class="lo-name">{lesson.title}</span>
                  <span class="lo-summary">{lesson.summary}</span>
                </span>
                <span class="lo-meta num">
                  {record ? `Done, ${record.correct}/${record.total}` : `${lesson.minutes} min`}
                </span>
              </a>
            </li>
          );
        })}
      </ol>
      <p class="lo-note">
        About {minutes} minutes in all. {course.note}
      </p>
    </section>
  </div>
</Layout>

<script>
  import { pendingFor, sendPending } from '../../../lib/learn/pending';

  const page = document.querySelector<HTMLElement>('.lo[data-course]');
  if (page) {
    const course = page.dataset.course!;
    const waiting = pendingFor(course);
    const ids = Object.keys(waiting);
    if (ids.length && page.dataset.signedIn === '1') {
      // Scores earned before signing in go to the account, then the page shows them.
      sendPending(course).then((saved) => {
        if (saved.length) location.reload();
      });
    } else if (ids.length && page.dataset.open === '1') {
      let next: HTMLElement | null = null;
      page.querySelectorAll<HTMLElement>('[data-lesson]').forEach((item) => {
        const score = waiting[item.dataset.lesson!];
        if (!score) {
          next ??= item;
          return;
        }
        item.classList.add('is-done');
        const meta = item.querySelector('.lo-meta');
        if (meta) meta.textContent = `Done, ${score.correct}/${score.total}`;
      });
      const line = page.querySelector<HTMLElement>('[data-local-line]');
      if (line) line.textContent = `${ids.length} ${ids.length === 1 ? 'lesson is' : 'lessons are'} done on this device. Sign in or create a free account to save ${ids.length === 1 ? 'it' : 'them'} and get the certificate.`;
      const start = page.querySelector<HTMLAnchorElement>('[data-local-start]');
      const target = next as HTMLElement | null;
      if (start && target) {
        start.href = target.querySelector('a')!.href;
        start.textContent = `Continue with lesson ${target.dataset.number}`;
      } else if (start) {
        start.textContent = 'Go through the lessons again';
      }
    }
  }
</script>

<style>
  .lo { padding-top: 56px; padding-bottom: 40px; }

  .lo-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 64px;
    align-items: start;
  }

  .lo-back { margin: 0 0 14px; font-size: 14px; }
  .lo-back a { color: var(--text-muted); }
  .lo-back a:hover { color: var(--fg); }

  .lo-title {
    margin: 0;
    font-family: var(--font-archivo);
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .lo-lead {
    margin: 22px 0 0;
    font-family: var(--font-serif);
    font-size: 21px;
    line-height: 1.55;
    max-width: 34em;
  }

  .lo-who {
    margin: 14px 0 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 38em;
  }

  .lo-account {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    display: grid;
    gap: 14px;
    justify-items: start;
  }

  .lo-account-line { margin: 0; font-size: 15px; line-height: 1.55; max-width: 40em; }
  .lo-account-actions { display: flex; gap: 10px; flex-wrap: wrap; }

  .lo-showcase { padding-top: 10px; }

  .lo-showcase :global(.rt) { margin-top: 22px; }

  .lo-showcase-label {
    margin: 0 0 -14px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .lo-lessons { margin-top: 72px; }

  .lo-section-title {
    margin: 0 0 8px;
    font-family: var(--font-archivo);
    font-size: 24px;
    font-weight: 700;
  }

  .lo-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-strong);
  }

  .lo-list a {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    gap: 16px;
    align-items: baseline;
    padding: 18px 4px 18px 0;
    border-bottom: 1px solid var(--border);
    color: var(--fg);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .lo-list a:hover { background: var(--surface-subtle); }
  .lo-list a:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }

  .lo-num {
    font-family: var(--font-archivo);
    font-size: 22px;
    font-weight: 700;
    color: var(--text-muted);
  }

  .lo-list li.is-done .lo-num { color: var(--success); }

  .lo-body { display: grid; gap: 4px; }
  .lo-name { font-size: 18px; font-weight: 600; }
  .lo-summary { font-size: 14.5px; line-height: 1.5; color: var(--text-muted); }

  .lo-meta {
    font-size: 13px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .lo-list li.is-done .lo-meta { color: var(--success); font-weight: 600; }

  .lo-note {
    margin: 18px 0 0;
    font-size: 13.5px;
    color: var(--text-muted);
    max-width: 70ch;
  }

  @media (max-width: 960px) {
    .lo-hero { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  }

  @media (max-width: 600px) {
    .lo { padding-top: 32px; }
    .lo-list a { grid-template-columns: 34px minmax(0, 1fr); }
    .lo-num { font-size: 17px; }
    .lo-meta { grid-column: 2; }
  }
</style>
